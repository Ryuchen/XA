# 复制到仓库根目录 .env.release，填入真实值。此文件仅为模板。
# 密钥来源及后续扩展清单：docs/INTEGRATION_CREDENTIALS.md
XA_API_DOMAIN=api.example.com
XA_ADMIN_DOMAIN=admin.example.com
XA_PROVIDER_DOMAIN=provider.example.com
DJANGO_ALLOWED_HOSTS=api.example.com,admin.example.com,provider.example.com
DJANGO_SECRET_KEY=
MYSQL_ROOT_PASSWORD=
MYSQL_USER=xa_app
MYSQL_PASSWORD=
MYSQL_DATABASE=xa_db
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK_LOGIN=false
# 陪玩 H5：发布编排通过 HTTPS 网关同源反代 /api 和 /ws/。
# 本地构建静态 H5 时也可改为实际 HTTPS API 域名，须以 /api 结尾。
TARO_APP_API=/api
# 原生老板端单独配置 apps/boss-miniapp/native/config.js 的 trial / release。
# TARO_APP_* 不会注入原生文件。socketBase 留空则从 apiBase 推导。

# 发单渠道；启用后新待接单、拒单回池会自动通知，也可后台一键发送。
KOOK_ENABLED=false
KOOK_BOT_TOKEN=
KOOK_DISPATCH_CHANNEL_ID=
KOOK_DISPATCH_NEW_ORDERS=true
KOOK_DISPATCH_REJECTED_ORDERS=true
# 可选：提醒目标服务器的角色（逗号分隔），以及已上线后台的订单页地址。
KOOK_DISPATCH_MENTION_ROLE_IDS=
KOOK_ADMIN_ORDER_URL=
KOOK_REQUEST_TIMEOUT=8
WECOM_DISPATCH_ENABLED=false
WECOM_DISPATCH_WEBHOOK=
WECOM_DISPATCH_NEW_ORDERS=true
WECOM_DISPATCH_REJECTED_ORDERS=true
