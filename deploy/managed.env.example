# 复制到服务器 .env.release；使用 docker-compose.managed.yml 单独部署。
# 自动部署还需 GitHub Repository Variable: XA_DATABASE_MODE=managed。
XA_API_DOMAIN=api.example.com
XA_ADMIN_DOMAIN=admin.example.com
XA_PROVIDER_DOMAIN=provider.example.com
DJANGO_SECRET_KEY=
MYSQL_DATABASE=xa_db
MYSQL_USER=xa_app
MYSQL_PASSWORD=
# 使用数据库证书包含的、解析到同 VPC 私网地址的数据库主机名。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_CONNECT_TIMEOUT=10
# 服务器上的 CA 公钥证书路径，以只读 secret 挂入每个后端容器。
MYSQL_SSL_CA_FILE=/etc/xa/mysql-ca.pem
WECHAT_APPID=
WECHAT_SECRET=
TARO_APP_API=/api
KOOK_ENABLED=false
KOOK_BOT_TOKEN=
KOOK_DISPATCH_CHANNEL_ID=
KOOK_DISPATCH_NEW_ORDERS=true
KOOK_DISPATCH_REJECTED_ORDERS=true
KOOK_DISPATCH_MENTION_ROLE_IDS=
KOOK_ADMIN_ORDER_URL=
KOOK_REQUEST_TIMEOUT=8
WECOM_DISPATCH_ENABLED=false
WECOM_DISPATCH_WEBHOOK=
WECOM_DISPATCH_NEW_ORDERS=true
WECOM_DISPATCH_REJECTED_ORDERS=true
