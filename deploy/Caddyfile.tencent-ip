{
    auto_https off
}

(backend) {
    reverse_proxy {
        dynamic a web 8000 {
            refresh 5s
            versions ipv4
        }
        lb_policy round_robin
        fail_duration 10s
        max_fails 1
        lb_try_duration 5s
        lb_retry_match method GET HEAD
    }
}

(assets) {
    handle /media/* {
        @public path /media/accounts/avatars/* /media/customers/avatars/* /media/escorts/avatars/* /media/escorts/videos/* /media/escorts/voice_cards/* /media/game_categories/* /media/banners/* /media/club-catalog/*
        route {
            handle @public {
                uri strip_prefix /media
                root * /srv/media
                file_server
            }
            respond 404
        }
    }
    @api path /api/* /ws/*
    handle @api {
        import backend
    }
}

http://{$XA_SERVER_IP}:80, http://localhost:80 {
    encode gzip
    import assets
    handle {
        reverse_proxy provider-h5:80
    }
}

http://{$XA_SERVER_IP}:8080, http://localhost:8080 {
    encode gzip
    import assets
    handle {
        reverse_proxy admin-web:80
    }
}

http://{$XA_SERVER_IP}:8081, http://localhost:8081 {
    encode gzip
    import assets
    handle {
        reverse_proxy provider-h5:80
    }
}
