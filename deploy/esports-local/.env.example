# Optional image overrides. No application secrets are required here.
XA_NODE_IMAGE=node:22-slim
XA_NGINX_IMAGE=nginx:alpine
# Local optional HTTP CONNECT proxy for npm; TLS verification remains enabled.
XA_NPM_PROXY=
# WSL path of a read-only Windows npm cache; change for another Windows account.
XA_NPM_CACHE_HOST=/mnt/c/Users/YOUR_WINDOWS_USER/AppData/Local/npm-cache
