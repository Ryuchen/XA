# Offline release assembly from a previously audited local backend image.
# Verify all dependency constraints, then test the resulting image before export.
ARG XA_BACKEND_BASE
FROM ${XA_BACKEND_BASE}
WORKDIR /app
COPY . .
RUN python -m pip check && python -c "from importlib.metadata import version; from packaging.requirements import Requirement; requirements=[Requirement(line.strip()) for line in open('requirements.txt') if line.strip() and not line.startswith('#')]; assert all(version(r.name) in r.specifier for r in requirements), 'Cached dependencies do not satisfy requirements'"
