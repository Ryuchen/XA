# docker-compose.yml reads this file after you copy it to .env.

# --- MySQL / Redis ---
MYSQL_ROOT_PASSWORD=xa_dev_password
MYSQL_DATABASE=xa_db
MYSQL_USER=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Backend (used by web / celery containers) ---
# 容器内部会自动使用服务名 db / redis 作为主机，无需修改上面的 127.0.0.1。
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-xa-local-development-key-change-before-production
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=true

# --- WeChat mini program login ---
# AppID must match apps/boss-miniapp/project.config.json. Never commit AppSecret.
WECHAT_APPID=wxd63488bdf6491c90
WECHAT_SECRET=
# Local H5 development may use true. Set false when real credentials are configured.
WECHAT_MOCK_LOGIN=true

# --- Order fulfillment evidence ---
# Require entry/completion screenshots when providers start/complete orders.
# Keep true in production; false can be used only during a legacy-client rollout.
REQUIRE_ORDER_EVIDENCE_IMAGES=true
REQUIRE_RECHARGE_PROOF=true

# 陪玩及历史老板 H5 构建参数；原生老板端使用 native/config.js，不读取 TARO_APP_*。
# 陪玩正式构建可用 /api 同源反代。TARO_APP_MEDIA / TARO_APP_WS 仅历史老板端使用。
TARO_APP_API=
TARO_APP_MEDIA=
TARO_APP_WS=

# --- KOOK order dispatch bot ---
KOOK_ENABLED=false
KOOK_BOT_TOKEN=
KOOK_DISPATCH_CHANNEL_ID=
KOOK_DISPATCH_NEW_ORDERS=true
KOOK_DISPATCH_REJECTED_ORDERS=true
KOOK_DISPATCH_MENTION_ROLE_IDS=
KOOK_ADMIN_ORDER_URL=
KOOK_REQUEST_TIMEOUT=8

# 企业微信群机器人发单；密钥只配置到服务端。
WECOM_DISPATCH_ENABLED=false
WECOM_DISPATCH_WEBHOOK=
WECOM_DISPATCH_NEW_ORDERS=true
WECOM_DISPATCH_REJECTED_ORDERS=true
WECOM_REQUEST_TIMEOUT=8

# 多实例限流与监控共用缓存，生产默认使用 REDIS_HOST / REDIS_PORT 的 Redis DB 3。
# DJANGO_CACHE_URL=redis://127.0.0.1:6379/3
