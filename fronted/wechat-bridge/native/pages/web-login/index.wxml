<view class="web-login">
  <view class="brand">{{storeName || '门店网页登录'}}</view>
  <block wx:if="{{confirmed}}">
    <view class="title">网页登录已确认</view>
    <view class="description">请返回刚才发起登录的网页继续操作。</view>
  </block>
  <block wx:else>
    <view class="title">确认网页登录</view>
    <view class="description">仅在你主动打开该门店网页并发起登录时继续。授权后请核对门店名称再确认。</view>
    <checkbox-group bindchange="agree"><label class="agreement"><checkbox value="agree" checked="{{agreed}}" color="#2563eb"/>我已阅读并同意隐私保护指引</label></checkbox-group>
    <button class="text-button" bindtap="privacy">查看隐私保护指引</button>
    <button wx:if="{{!authorized}}" class="primary" bindtap="quickLogin" disabled="{{!agreed || busy}}" loading="{{busy}}">微信快捷登录</button>
    <button wx:if="{{requiresPhoneAuthorization}}" class="primary" open-type="getPhoneNumber" bindgetphonenumber="phone" disabled="{{!agreed || busy}}">授权读取微信手机号</button>
    <view wx:if="{{requiresSms}}" class="verification">
      <view>微信授权手机号：{{maskedPhone}}</view>
      <input type="number" maxlength="6" placeholder="输入短信验证码" value="{{smsCode}}" bindinput="codeInput" disabled="{{busy}}"/>
      <button bindtap="sendCode" disabled="{{busy || countdown > 0}}">{{countdown > 0 ? countdown + ' 秒后重发' : '发送验证码'}}</button>
    </view>
    <button wx:if="{{canConfirm || requiresSms}}" class="primary" bindtap="confirm" disabled="{{busy || !agreed || (requiresSms && smsCode.length !== 6)}}" loading="{{busy}}">确认在网页端登录</button>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
    <view class="description">本页仅处理微信身份与手机号授权，订单和钱包操作请返回网页。</view>
  </block>
</view>
