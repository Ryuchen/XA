page { background:#fafaf7; color:#0f172a; }
.web-login { padding:var(--xa-s-5) var(--xa-s-4); }
.brand { font-size:28rpx; font-weight:600; color:#2563eb; margin-bottom:var(--xa-s-5); }
.title { font-size:40rpx; font-weight:600; margin-bottom:var(--xa-s-3); }
.description { font-size:26rpx; line-height:1.6; color:#526173; margin:var(--xa-s-3) 0; }
.agreement { display:flex; align-items:center; font-size:26rpx; min-height:88rpx; }
.text-button { background:transparent; color:#2563eb; font-size:26rpx; text-align:left; padding:0; }
.text-button:after { border:0; }
.primary { background:#2563eb; color:white; margin-top:var(--xa-s-3); font-size:28rpx; min-height:88rpx; }
.primary[disabled] { background:#dce5f4; color:#66758b; }
.verification { padding:var(--xa-s-3) 0; font-size:28rpx; }
.verification input { background:white; border:1rpx solid #d0d7e2; border-radius:12rpx; padding:var(--xa-s-3); margin:var(--xa-s-2) 0; min-height:48rpx; }
.verification button { font-size:28rpx; }
.error { color:#b42335; padding:var(--xa-s-3) 0; font-size:26rpx; line-height:1.6; }
