<view class="chat-page"><view class="chat-heading"><text class="section-title">平台客服</text><text class="muted small">客服回复会自动更新，支持文字与图片</text></view><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后咨询客服</button>
<scroll-view scroll-y class="history" scroll-into-view="{{scrollTo}}" scroll-with-animation><state-view loading="{{loading}}" error="{{error}}" empty="{{logged && !items.length}}" empty-text="写下你想咨询的问题" bind:retry="load"/><view class="message {{item.is_from_support ? 'support' : 'self'}}" wx:for="{{items}}" wx:key="id" id="message-{{item.id}}"><text class="time">{{item.time}} · {{item.is_from_support ? '客服' : '我'}}</text><view class="bubble"><image wx:if="{{item.image}}" class="chat-image" src="{{item.image}}" mode="widthFix" data-url="{{item.image}}" data-id="{{item.id}}" binderror="imageError" bindtap="preview"/><text wx:else user-select>{{item.content}}</text></view></view><view class="end-space"></view></scroll-view>
<view wx:if="{{logged}}" class="composer"><textarea class="input" auto-height maxlength="2000" value="{{content}}" bindinput="input" placeholder="输入你的问题"/><view class="row"><button class="xa-button button-secondary" aria-label="发送图片" bindtap="chooseImage" disabled="{{sending}}" hover-class="xa-button-hover">图片</button><button class="xa-button button" bindtap="send" disabled="{{sending || !content}}" loading="{{sending}}" hover-class="xa-button-hover">发送</button></view></view></view>
