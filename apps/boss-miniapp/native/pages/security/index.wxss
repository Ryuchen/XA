.security-page > .subtitle { margin-bottom: 24rpx; }
.security-page .panel { margin-top: 20rpx; padding: 28rpx; }
.security-page .panel > .between > text:first-child { font-weight: 600; font-size: 29rpx; }
.security-page .panel > .subtitle { margin: 16rpx 0 12rpx; font-size: max(26rpx,13px); }
.security-page .panel > .small { display: block; font-size: var(--xa-control-small-font); line-height: 1.8; }
.security-page .panel .tag { font-size: var(--xa-control-small-font); }
.security-page .xa-button.button, .security-page .xa-button.button-secondary { min-height: var(--xa-control-height); padding: 12rpx 20rpx; border-radius: var(--xa-radius-control); font-size: var(--xa-control-font); }
.security-page .xa-button.button-secondary { min-height: var(--xa-control-secondary); padding: 10rpx 20rpx; }
.security-page .panel .xa-button.button, .security-page .panel .xa-button.button-secondary { margin-top: 24rpx; }
.security-page .xa-button.button-quiet { min-height: var(--xa-control-secondary); padding: 8rpx; margin-top: 8rpx; font-size: max(26rpx,13px); }
.security-page .xa-button.support-action { color: var(--xa-color-primary); }
