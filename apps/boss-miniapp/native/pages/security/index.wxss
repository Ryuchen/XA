.security-page .page-heading, .security-page .panel, .security-page .section-surface { margin-bottom:20rpx; padding:24rpx; border-color:var(--xa-color-border); border-radius:20rpx; }
.security-page .title { font-size:20px; letter-spacing:0; }
.security-page .subtitle { margin-top:8rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.security-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.security-page .section-title { flex:1; min-width:0; margin:0; font-size:var(--xa-control-font); line-height:1.5; }
.security-page .tag { padding:2rpx 10rpx; border-radius:6rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.security-copy, .phone-value { display:block; margin-top:12rpx; font-size:var(--xa-control-font); line-height:1.6; overflow-wrap:anywhere; }
.security-note { display:block; margin-top:8rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.6; overflow-wrap:anywhere; }
.security-page .xa-button.button, .security-page .xa-button.button-secondary { min-height:40px; margin-top:16rpx; padding:8px 12px; border-radius:12rpx; font-size:var(--xa-control-font); line-height:1.5; }
.security-page .xa-button.button-secondary { min-height:36px; padding:6px 12px; font-size:var(--xa-control-small-font); }
.account-actions { display:grid; grid-template-columns:minmax(0,3fr) minmax(0,2fr); gap:12rpx; }
.security-page .account-actions .xa-button { min-height:36px; margin:0; padding:6px 8px; border-radius:10rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.security-page .xa-button.logout-action { color:var(--xa-color-danger); background:var(--xa-color-surface-subtle); }
.security-page .xa-button.privacy-action { min-height:30px; margin:10rpx 0 0; padding:4px 6px; border-radius:10rpx; color:var(--xa-color-primary); font-size:var(--xa-control-small-font); }
.security-actions .error { padding:0 0 12rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.security-page .page-heading .xa-button { min-height:36px; padding:6px 12px; font-size:var(--xa-control-small-font); }
