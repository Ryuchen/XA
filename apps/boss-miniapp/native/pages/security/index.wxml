<view class="page security-page"><text class="title">账号安全</text><text class="subtitle">管理微信身份与已验证手机号</text>
  <button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后管理账号</button><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{profile}}"><view class="panel"><view class="between"><text>微信绑定</text><text class="tag">{{profile.isWechatBound ? '已绑定' : '未绑定'}}</text></view><text class="subtitle small">绑定后可通过当前微信快捷登录，并保留本账号资产。</text><button wx:if="{{!profile.isWechatBound}}" class="xa-button button" disabled="{{busy}}" loading="{{busy}}" bindtap="bindWechat" hover-class="xa-button-hover">绑定当前微信</button></view>
    <view class="panel"><view class="between"><text>验证手机号</text><text class="tag">{{profile.isPhoneVerified ? '已验证' : '未验证'}}</text></view><text class="subtitle">{{profile.phone || '尚未设置手机号'}}</text><text class="small muted">需经微信授权确认手机号归属，已有其他账号绑定时将提示联系客服。</text><button class="xa-button button-secondary" open-type="getPhoneNumber" bindgetphonenumber="phone" disabled="{{busy}}" loading="{{busy}}" hover-class="xa-button-hover">{{profile.isPhoneVerified ? '更新授权手机号' : '授权并验证手机号'}}</button></view>
    <text wx:if="{{actionError}}" class="error">{{actionError}}</text><button class="xa-button button-quiet support-action" bindtap="support" hover-class="xa-button-hover">绑定有问题，联系客服</button><button class="xa-button button-quiet" bindtap="logout" hover-class="xa-button-hover">退出登录</button>
  </block><button class="xa-button button-quiet" bindtap="privacy" hover-class="xa-button-hover">查看隐私保护指引</button>
</view>
