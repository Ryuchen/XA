<view class="page security-page">
  <view class="page-heading"><text class="title" role="heading" aria-level="1">账号安全</text><text class="subtitle">管理微信身份与已验证手机号</text><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后管理账号</button></view>
  <state-view wx:if="{{logged}}" loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{logged && profile && !error}}">
    <view class="panel"><view class="security-row"><text class="section-title" role="heading" aria-level="2">微信绑定</text><text class="tag">{{profile.isWechatBound ? '已绑定' : '未绑定'}}</text></view><text class="security-copy">绑定后可通过当前微信快捷登录，并保留本账号资产。</text><button wx:if="{{!profile.isWechatBound}}" class="xa-button button" disabled="{{busy}}" loading="{{busy}}" bindtap="bindWechat" hover-class="xa-button-hover">绑定当前微信</button></view>
    <view class="panel"><view class="security-row"><text class="section-title" role="heading" aria-level="2">验证手机号</text><text class="tag">{{profile.isPhoneVerified ? '已验证' : '未验证'}}</text></view><text class="phone-value">{{profile.phone || '尚未设置手机号'}}</text><text class="security-note">需经微信授权确认手机号归属，已有其他账号绑定时将提示联系客服。</text><button class="xa-button button-secondary" open-type="getPhoneNumber" bindgetphonenumber="phone" disabled="{{busy}}" loading="{{busy}}" hover-class="xa-button-hover">{{profile.isPhoneVerified ? '更新授权手机号' : '授权并验证手机号'}}</button></view>
  </block>
  <view class="section-surface security-actions"><block wx:if="{{logged && profile}}"><text wx:if="{{actionError}}" class="error" role="alert">{{actionError}}</text><view class="account-actions"><button class="xa-button button-secondary support-action" bindtap="support" hover-class="xa-button-hover">绑定有问题，联系客服</button><button class="xa-button button-quiet logout-action" bindtap="logout" hover-class="xa-button-hover">退出登录</button></view></block><button class="xa-button button-quiet privacy-action" bindtap="privacy" hover-class="xa-button-hover">查看隐私保护指引</button></view>
</view>
<bottom-navigation/>
