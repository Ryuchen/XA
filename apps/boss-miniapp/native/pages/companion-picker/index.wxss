@import "../../styles/companion-cards.wxss";
.companion-picker .panel { padding:24rpx; margin-bottom:20rpx; border-radius:20rpx; }
.companion-picker .title { font-size:20px; letter-spacing:0; }
.companion-picker .subtitle { margin-top:8rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.companion-picker .small { font-size:var(--xa-control-small-font); line-height:1.5; }
.companion-picker .xa-button.companion-card { border-radius:20rpx; }
.picker-heading .subtitle { margin-bottom:8rpx; }
.picker-heading .small { display:block; overflow-wrap:anywhere; }
.companion-picker .xa-button.platform-button { width:auto; min-height:30px; margin:14rpx 0 0; padding:4px 12px; border-radius:10rpx; font-size:var(--xa-control-small-font); line-height:1.4; }
.picker-search { display:flex; align-items:center; gap:12rpx; padding:0 16rpx; border:1rpx solid var(--xa-color-border); border-radius:12rpx; background:var(--xa-color-surface-subtle); }
.picker-search image { width:var(--xa-icon-small); height:var(--xa-icon-small); flex-shrink:0; }
.picker-search .input { flex:1; min-width:0; height:36px; min-height:36px; padding:0; border:0; border-radius:0; background:transparent; }
.picker-summary { gap:12rpx; margin-top:14rpx; }
.picker-summary > text { flex:1; min-width:0; }
.picker-summary picker { flex-shrink:0; }
.picker-gender { display:flex; align-items:center; justify-content:center; gap:6rpx; min-height:30px; padding:4px 10px; color:var(--xa-color-primary); background:var(--xa-color-primary-soft); border-radius:10rpx; font-size:var(--xa-control-small-font); line-height:1.4; }
.picker-gender image { width:12px; height:12px; transform:rotate(90deg); }
.companion-picker .login-panel > .xa-button.button { min-height:36px; padding:6px 12px; border-radius:12rpx; font-size:var(--xa-control-small-font); }
.picker-with-actions { padding-bottom:112px; }
.picker-selection-heading { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8rpx; margin-top:20rpx; padding-top:16rpx; border-top:1rpx solid var(--xa-color-border); font-size:var(--xa-control-font); font-weight:500; }
.picker-selection-heading .small { font-weight:400; }
.picker-selected-list { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:10rpx; }
.companion-picker .xa-button.picker-selected-person { display:flex; align-items:center; justify-content:center; gap:10rpx; max-width:100%; min-height:36px; width:auto; padding:4px 10px; margin:0; border-radius:10rpx; border:1rpx solid var(--xa-color-primary); background:var(--xa-color-primary-soft); color:var(--xa-color-primary); font-size:var(--xa-control-small-font); line-height:1.4; white-space:normal; text-align:left; }
.picker-selected-person > text:first-child { min-width:0; overflow-wrap:anywhere; }
.picker-remove { flex-shrink:0; font-size:20px; }
.companion-picker .xa-button.picker-selected-unavailable { border-color:var(--xa-color-border); background:var(--xa-color-surface-subtle); color:var(--xa-color-muted); }
.picker-selection-hint { margin-top:10rpx; }
.companion-picker .companion-card { display:block; min-width:0; padding:12rpx 12rpx 0; border:2rpx solid var(--xa-color-border); border-radius:20rpx; background:var(--xa-color-surface); overflow:hidden; transition:background-color 150ms ease,border-color 150ms ease; }
.companion-picker .companion-card-selected { border-color:var(--xa-color-primary); background:var(--xa-color-primary-soft); }
.companion-picker .xa-button.companion-select { display:block; width:100%; min-width:0; margin:0; padding:0; border:0; border-radius:12rpx; color:var(--xa-color-text); background:transparent; white-space:normal; text-align:left; }
.companion-select::after,.companion-detail-entry::after { border:0; }
.companion-selection-mark { position:absolute; right:8rpx; bottom:8rpx; padding:4rpx 12rpx; border:1rpx solid var(--xa-color-border); border-radius:10rpx; color:var(--xa-color-muted); background:var(--xa-color-surface); font-size:var(--xa-control-small-font); line-height:1.4; }
.companion-selection-mark-active { color:var(--xa-color-surface); border-color:var(--xa-color-primary); background:var(--xa-color-primary); font-weight:600; }
.companion-card-unavailable .companion-avatar { opacity:.65; }
.companion-picker .xa-button.companion-detail-entry { display:flex; align-items:center; justify-content:center; gap:6rpx; width:100%; min-height:44px; padding:6px 0; margin:10rpx 0 0; border:0; border-top:1rpx solid var(--xa-color-border); border-radius:0; color:var(--xa-color-primary); background:transparent; font-size:var(--xa-control-small-font); line-height:1.4; }
.companion-detail-entry image { width:12px; height:12px; }
.picker-actions { display:flex; align-items:center; gap:16rpx; padding:10px 24rpx; }
.picker-action-summary { flex:1; min-width:0; font-size:var(--xa-control-font); line-height:1.4; }
.picker-action-summary > view > text { color:var(--xa-color-primary); font-weight:600; }
.picker-action-summary > .small { display:block; margin-top:4rpx; overflow-wrap:anywhere; }
.picker-actions .xa-button.picker-confirm { display:flex; align-items:center; justify-content:center; flex:0 0 auto; width:auto; min-width:120px; min-height:44px; max-width:55%; margin:0; padding:6px 12px; border-radius:12rpx; font-size:var(--xa-control-small-font); line-height:1.4; white-space:normal; }
@media (prefers-reduced-motion:reduce) { .companion-picker .companion-card { transition:none; } }
