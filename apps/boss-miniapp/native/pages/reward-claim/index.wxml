<view class="page reward-claim-page">
  <state-view wx:if="{{loading || error}}" loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{claim && !loading && !error}}">
    <view class="page-heading claim-heading"><text class="eyebrow">{{claim.source === 'LOTTERY' ? '幸运转盘奖品' : claim.source === 'VIP' ? 'VIP 会员权益' : claim.source === 'GIFT' ? '赠礼附送权益' : '积分兑换奖品'}} · #{{claim.id}}</text><text class="title">{{claim.name_snapshot}}</text><text class="tag">{{claim.status_label}}</text><text wx:if="{{claim.expires_at}}" class="subtitle">有效至 {{claim.expires_at}}</text></view>
    <view class="panel"><text class="section-title">交付进度</text><text class="claim-note">{{claim.delivery_note || '俱乐部将为你安排交付。你可以先补充资料，也可以直接联系客服。'}}</text></view>
    <view wx:if="{{claim.status === 'PENDING'}}" class="panel claim-form"><text class="section-title">交付资料</text>
      <block wx:if="{{claim.kind_snapshot === 'PHYSICAL'}}"><view class="claim-field"><text class="label">收件人</text><input class="input" data-field="recipient" value="{{details.recipient}}" bindinput="input" maxlength="50"/></view><view class="claim-field"><text class="label">联系电话</text><input class="input" data-field="phone" value="{{details.phone}}" bindinput="input" type="number" maxlength="20"/></view><view class="claim-field"><text class="label">完整收货地址</text><textarea class="input" data-field="address" value="{{details.address}}" bindinput="input" maxlength="255"/></view></block>
      <block wx:if="{{claim.kind_snapshot === 'VIRTUAL' || claim.kind_snapshot === 'SERVICE'}}"><view class="claim-field"><text class="label">游戏 UID</text><input class="input" data-field="game_uid" value="{{details.game_uid}}" bindinput="input" maxlength="80"/></view></block>
      <block wx:if="{{claim.kind_snapshot === 'TAG'}}"><view class="claim-field"><text class="label">希望展示的 TAG</text><input class="input" data-field="tag" value="{{details.tag}}" bindinput="input" maxlength="30" placeholder="最多 30 字，由俱乐部核对后发放"/></view></block>
      <block wx:if="{{claim.kind_snapshot === 'NAMING'}}"><view class="claim-field"><text class="label">希望冠名的陪玩</text><input class="input" data-field="provider_name" value="{{details.provider_name}}" bindinput="input" maxlength="50"/></view></block>
      <view class="claim-field"><text class="label">补充说明</text><textarea class="input" data-field="note" value="{{details.note}}" bindinput="input" maxlength="255" placeholder="方便俱乐部为你安排交付"/></view><button class="xa-button button" bindtap="save" loading="{{busy}}" disabled="{{busy}}" hover-class="xa-button-hover">保存资料</button><text class="small muted">资料仅用于本次奖品交付。</text>
    </view>
    <view class="section-surface claim-actions"><button class="xa-button button-secondary" bindtap="support" hover-class="xa-button-hover">联系俱乐部客服</button></view>
  </block>
</view>
<bottom-navigation/>
