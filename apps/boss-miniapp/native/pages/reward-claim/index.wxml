<view class="page reward-claim-page">
  <state-view wx:if="{{loading || error}}" loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{claim && !loading && !error}}">
    <view class="page-heading claim-heading"><text class="eyebrow">{{claim.source === 'LOTTERY' ? '幸运转盘奖品' : claim.source === 'VIP' ? 'VIP 会员权益' : claim.source === 'GIFT' ? '赠礼附送权益' : '积分兑换奖品'}} · #{{claim.id}}</text><text class="title">{{claim.name_snapshot}}</text><text class="tag">{{claim.status_label}}</text><text wx:if="{{claim.expiresText}}" class="subtitle">有效至 {{claim.expiresText}}</text></view>
    <view class="panel"><text class="section-title">交付进度</text><text class="claim-note">{{claim.delivery_note || '俱乐部将为你安排交付。你可以先补充资料，也可以直接联系客服。'}}</text><text wx:if="{{claim.kind_snapshot === 'TAG' && claim.status === 'PENDING' && claim.tag_revision_required}}" class="claim-note">请按客服要求修改 TAG 后保存。</text><text wx:if="{{claim.kind_snapshot === 'TAG' && claim.status === 'COMPLETED' && claim.tag_reviewed === false}}" class="claim-note">{{claim.tag_suspension_reason ? '标签已暂停展示：' + claim.tag_suspension_reason : '标签待客服复核，暂不展示。'}}</text><text wx:if="{{claim.tag_editable}}" class="claim-note">{{claim.tag_revision_submitted ? '已提交修改，等待客服复核。' : '可修改后提交复核，有效期不变。'}}</text><text wx:if="{{claim.points_returned}}" class="claim-note refund-points">已退回 {{claim.points_spent}} 积分，可在积分明细查看。</text><text wx:if="{{claim.kind_snapshot === 'NAMING' || claim.kind_snapshot === 'TAG' || claim.duration_days || claim.duration_months}}" class="claim-note">权益时长：<block wx:if="{{claim.duration_months}}">{{claim.duration_months}} 个月</block><block wx:if="{{claim.duration_months && claim.duration_days}}"> + </block><block wx:if="{{claim.duration_days}}">{{claim.duration_days}} 天</block><block wx:if="{{!claim.duration_days && !claim.duration_months}}">无固定期限</block></text><text wx:if="{{claim.kind_snapshot === 'TAG' && claim.highlighted}}" class="claim-note">展示类型：高亮 TAG</text></view>
    <view wx:if="{{claim.status === 'PENDING' || claim.tag_editable || saveIssue}}" class="panel claim-form"><text class="section-title">{{claim.tag_editable ? '修改 TAG' : '交付资料'}}</text><text wx:if="{{saveIssue}}" class="claim-note error">{{saveIssue}}</text>
      <block wx:if="{{claim.kind_snapshot === 'PHYSICAL'}}"><view class="claim-field"><text class="label">收件人</text><input class="input" data-field="recipient" value="{{details.recipient}}" disabled="{{busy}}" bindinput="input" maxlength="50"/></view><view class="claim-field"><text class="label">联系电话</text><input class="input" data-field="phone" value="{{details.phone}}" disabled="{{busy}}" bindinput="input" type="number" maxlength="20"/></view><view class="claim-field"><text class="label">完整收货地址</text><textarea class="input" data-field="address" value="{{details.address}}" disabled="{{busy}}" bindinput="input" maxlength="255"/></view></block>
      <block wx:if="{{claim.kind_snapshot === 'VIRTUAL' || claim.kind_snapshot === 'SERVICE'}}"><view class="claim-field"><text class="label">游戏 UID</text><input class="input" data-field="game_uid" value="{{details.game_uid}}" disabled="{{busy}}" bindinput="input" maxlength="80"/></view></block>
      <block wx:if="{{claim.kind_snapshot === 'TAG'}}"><view class="claim-field"><text class="label">希望展示的 TAG</text><input class="input" data-field="tag" value="{{details.tag}}" disabled="{{busy}}" bindinput="input" maxlength="30" placeholder="最多 30 字，由俱乐部核对后发放"/></view></block>
      <block wx:if="{{claim.kind_snapshot === 'NAMING'}}"><view class="claim-field"><text class="label">希望冠名的陪玩</text><input class="input" data-field="provider_name" value="{{details.provider_name}}" disabled="{{busy}}" bindinput="input" maxlength="50"/></view></block>
      <view wx:if="{{!claim.tag_editable}}" class="claim-field"><text class="label">补充说明</text><textarea class="input" data-field="note" value="{{details.note}}" disabled="{{busy}}" bindinput="input" maxlength="255" placeholder="方便俱乐部为你安排交付"/></view><button wx:if="{{!saveIssue}}" class="xa-button button" bindtap="save" loading="{{busy}}" disabled="{{busy}}" hover-class="xa-button-hover">{{claim.tag_editable ? '提交复核' : '保存资料'}}</button><block wx:else><button class="xa-button button-secondary refresh-claim" bindtap="load" hover-class="xa-button-hover">刷新交付状态</button><button class="xa-button button-secondary" bindtap="copyDraft" hover-class="xa-button-hover">复制未保存资料</button></block><text class="small muted">资料仅用于本次奖品交付。</text>
    </view>
    <view class="section-surface claim-actions"><button wx:if="{{claim.kind_snapshot === 'TAG' && claim.status === 'COMPLETED'}}" class="xa-button button-secondary manage-tags" bindtap="manageTags" hover-class="xa-button-hover">管理展示标签</button><button class="xa-button button-secondary" bindtap="support" hover-class="xa-button-hover">联系俱乐部客服</button></view>
  </block>
</view>
<bottom-navigation/>
