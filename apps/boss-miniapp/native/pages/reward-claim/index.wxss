.reward-claim-page .page-heading,.reward-claim-page .panel,.reward-claim-page .section-surface { padding:24rpx; margin-bottom:16rpx; border:1rpx solid var(--xa-color-border); border-radius:20rpx; background:var(--xa-color-surface); }
.reward-claim-page .title { font-size:20px; letter-spacing:0; }
.reward-claim-page .eyebrow { margin-bottom:8rpx; font-size:var(--xa-control-small-font); overflow-wrap:anywhere; }
.claim-heading>.tag { max-width:100%; margin-top:12rpx; padding:3rpx 10rpx; font-size:var(--xa-control-small-font); white-space:normal; overflow-wrap:anywhere; }
.reward-claim-page .subtitle { margin-top:8rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.reward-claim-page .section-title { margin:0 0 12rpx; font-size:var(--xa-control-font); line-height:1.5; }
.claim-note { display:block; font-size:var(--xa-control-font); line-height:1.65; white-space:pre-wrap; overflow-wrap:anywhere; }
.claim-field { margin-top:16rpx; }
.reward-claim-page .label { display:block; margin:0 0 8rpx; font-size:var(--xa-control-font); line-height:1.5; }
.reward-claim-page .input { width:100%; border-radius:12rpx; font-size:var(--xa-control-font); }
.reward-claim-page input.input { height:38px; min-height:38px; padding:0 16rpx; line-height:1.5; }
.reward-claim-page textarea.input { height:80px; min-height:80px; padding:12rpx 16rpx; line-height:1.65; }
.reward-claim-page .xa-button.button,.reward-claim-page .xa-button.button-secondary { min-height:40px; padding:6px 12px; border-radius:12rpx; font-size:var(--xa-control-font); }
.reward-claim-page .xa-button.button-secondary { min-height:36px; font-size:var(--xa-control-small-font); }
.reward-claim-page .claim-form .xa-button.button { margin:16rpx 0 8rpx; }
.reward-claim-page .small { display:block; font-size:var(--xa-control-small-font); line-height:1.5; }
.claim-actions .xa-button.button-secondary { margin-top:0; }
