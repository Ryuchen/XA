.chips { margin: 28rpx 0 12rpx; display: flex; }.rankings-page .chips .xa-button.chip { flex: 1; min-height: var(--xa-control-compact); padding: 6rpx 8rpx; font-size: var(--xa-control-small-font); border-radius: 16rpx; }.rank-row { display: flex; gap: 18rpx; align-items: center; min-height: 120rpx; padding: 20rpx 0; }.rank-row + .rank-row { border-top: 1rpx solid var(--xa-color-border); }.rank { color: var(--xa-color-primary); font-size: 34rpx; font-weight: 600; width: 40rpx; text-align: center; flex-shrink: 0; }.avatar { width: 72rpx; height: 72rpx; }.rank-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }.rank-name text { display: block; }.rank-name .small { margin-top: 4rpx; }.rank-row > text:last-child { font-size: 25rpx; text-align: right; max-width: 210rpx; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }.panel { padding: 6rpx 24rpx; }
