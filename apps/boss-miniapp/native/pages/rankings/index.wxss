.rank-header { margin-bottom:12px; }
.rank-header .title { display:block; font-size:24px; line-height:32px; letter-spacing:0; }
.rank-header .subtitle,.group-metric,.rank-note,.rank-unit,.rank-empty { color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:16px; }
.rank-header .subtitle { display:block; margin-top:4px; }
.periods { display:flex; align-items:center; gap:4px; margin-top:4px; }
.rankings-page .period-hit,.rankings-page .login-hit { display:inline-flex; align-items:center; justify-content:center; min-height:var(--xa-control-compact); margin:0; padding:0; border:0; background:transparent; }
.rankings-page .period-hit { min-width:44px; width:56px; }
.rankings-page .login-hit { width:auto; margin-top:4px; }
.period-face,.login-face { display:inline-flex; align-items:center; justify-content:center; min-height:24px; padding:0 8px; border-radius:4px; font-size:var(--xa-control-small-font); line-height:16px; }
.period-face { width:100%; box-sizing:border-box; color:var(--xa-color-muted); background:var(--xa-color-surface); border:1px solid var(--xa-color-border); }
.is-active .period-face,.login-face { color:var(--xa-color-on-primary); background:var(--xa-color-primary); border-color:var(--xa-color-primary); }
.rank-group { margin-bottom:12px; padding:0 12px; border:1px solid var(--xa-color-border); border-radius:12px; background:var(--xa-color-surface); }
.group-heading,.rank-row,.rank-result { display:flex; align-items:center; gap:8px; }
.group-heading { justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--xa-color-border); }
.group-title,.rank-nickname,.rank-value { color:var(--xa-color-text); font-size:var(--xa-control-font); line-height:20px; }
.group-title,.rank-value { font-weight:600; }
.rank-row { padding:8px 0; }
.rank-row + .rank-row { border-top:1px solid var(--xa-color-border); }
.rank-number { width:20px; min-width:20px; text-align:center; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:20px; font-variant-numeric:tabular-nums; }
.rank-number.is-first { color:var(--xa-color-primary); background:var(--xa-color-primary-soft); border-radius:4px; font-weight:600; }
.rank-avatar { width:24px; height:24px; flex-shrink:0; border-radius:8px; background:var(--xa-color-surface-subtle); }
.rank-name { flex:1; min-width:0; overflow-wrap:anywhere; }
.rank-nickname,.rank-note { display:block; }
.rank-nickname { font-weight:600; }
.rank-result { max-width:40%; min-width:0; justify-content:flex-end; align-items:baseline; gap:0 4px; flex-wrap:wrap; text-align:right; font-variant-numeric:tabular-nums; }
.rank-value,.rank-unit { max-width:100%; min-width:0; overflow-wrap:anywhere; }
.rank-empty { display:block; padding:12px 0; }
