<view class="page rankings-page">
  <view class="rank-header">
    <text class="title" role="heading" aria-level="1">兴安榜单</text>
    <text class="subtitle">按已完成订单统计</text>
    <button wx:if="{{!logged}}" class="xa-button login-hit" bindtap="login" hover-class="xa-button-hover">
      <text class="login-face">登录后查看榜单</text>
    </button>
    <view wx:else class="periods">
      <button
        wx:for="{{periods}}" wx:key="value"
        class="xa-button period-hit {{period === item.value ? 'is-active' : ''}}"
        data-value="{{item.value}}" bindtap="period" aria-pressed="{{period === item.value}}" hover-class="xa-button-hover"
      ><text class="period-face">{{item.label}}</text></button>
    </view>
  </view>
  <state-view wx:if="{{logged}}" loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{logged && !loading && !error}}">
    <view class="rank-group">
      <view class="group-heading"><text class="group-title" role="heading" aria-level="2">陪玩服务榜</text><text class="group-metric">完成单数</text></view>
      <view wx:for="{{providers}}" wx:key="user_id" class="rank-row">
        <text class="rank-number {{item.rank === 1 ? 'is-first' : ''}}">{{item.rank}}</text>
        <image wx:if="{{item.avatar}}" class="rank-avatar" src="{{item.avatar}}" mode="aspectFill" aria-hidden="true"/>
        <view class="rank-name"><text class="rank-nickname">{{item.nickname}}</text><text wx:if="{{item.title}}" class="rank-note">称号 · {{item.title}}</text></view>
        <view class="rank-result"><text class="rank-value">{{item.order_count}}</text><text class="rank-unit">单</text></view>
      </view>
      <text wx:if="{{!providers.length}}" class="rank-empty">当前周期暂无上榜记录</text>
    </view>
    <view class="rank-group">
      <view class="group-heading"><text class="group-title" role="heading" aria-level="2">老板支持榜</text><text class="group-metric">净消费额</text></view>
      <view wx:for="{{consumption}}" wx:key="user_id" class="rank-row">
        <text class="rank-number {{item.rank === 1 ? 'is-first' : ''}}">{{item.rank}}</text>
        <view class="rank-name"><text class="rank-nickname">{{item.nickname}}</text><text wx:if="{{item.title}}" class="rank-note">称号 · {{item.title}}</text></view>
        <view class="rank-result"><text class="rank-value">{{item.amountText}}</text><text class="rank-unit">兴安币</text></view>
      </view>
      <text wx:if="{{!consumption.length}}" class="rank-empty">当前周期暂无上榜记录</text>
    </view>
  </block>
</view>
<bottom-navigation/>
