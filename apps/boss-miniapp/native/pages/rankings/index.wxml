<view class="page rankings-page"><text class="title">兴安榜单</text><text class="subtitle">按已完成订单统计，每一份认可都有记录</text><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后查看榜单</button><block wx:else><view class="chips"><button wx:for="{{periods}}" wx:key="value" class="xa-button chip {{period === item.value ? 'chip-active' : ''}}" data-value="{{item.value}}" bindtap="period" hover-class="xa-button-hover">{{item.label}}</button></view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<text class="section-title">陪玩服务榜</text><view class="panel"><view wx:for="{{providers}}" wx:key="user_id" class="rank-row"><text class="rank">{{item.rank}}</text><image wx:if="{{item.avatar}}" class="avatar" src="{{item.avatar}}"/><view class="rank-name"><text>{{item.nickname}}</text><text class="small muted">{{item.title}}</text></view><text>{{item.order_count}} 单</text></view><view wx:if="{{!providers.length && !loading}}" class="empty">当前周期暂无上榜记录</view></view>
<text class="section-title">老板支持榜</text><view class="panel"><view wx:for="{{consumption}}" wx:key="user_id" class="rank-row"><text class="rank">{{item.rank}}</text><view class="rank-name"><text>{{item.nickname}}</text><text class="small muted">{{item.title}}</text></view><text>{{item.amountText}}<text class="small muted"> 兴安币</text></text></view><view wx:if="{{!consumption.length && !loading}}" class="empty">当前周期暂无上榜记录</view></view></block></view>
