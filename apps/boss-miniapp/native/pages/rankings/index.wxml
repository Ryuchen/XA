<view class="page rankings-page">
  <view class="page-heading"><text class="title" role="heading" aria-level="1">兴安榜单</text><text class="subtitle">按已完成订单统计，每一份认可都有记录</text><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后查看榜单</button><view wx:if="{{logged}}" class="chips"><button wx:for="{{periods}}" wx:key="value" class="xa-button chip {{period === item.value ? 'chip-active' : ''}}" data-value="{{item.value}}" bindtap="period" aria-pressed="{{period === item.value}}" hover-class="xa-button-hover">{{item.label}}</button></view></view>
  <state-view wx:if="{{logged}}" loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{logged && !loading && !error}}">
    <view class="panel"><text class="section-title" role="heading" aria-level="2">陪玩服务榜</text><view wx:for="{{providers}}" wx:key="user_id" class="rank-row"><text class="rank">{{item.rank}}</text><image wx:if="{{item.avatar}}" class="rank-avatar" src="{{item.avatar}}" mode="aspectFill" aria-hidden="true"/><view class="rank-name"><text class="rank-nickname">{{item.nickname}}</text><text wx:if="{{item.title}}" class="rank-note">{{item.title}}</text></view><view class="rank-result"><text class="rank-value">{{item.order_count}}</text><text class="rank-unit">单</text></view></view><text wx:if="{{!providers.length}}" class="rank-empty">当前周期暂无上榜记录</text></view>
    <view class="panel"><text class="section-title" role="heading" aria-level="2">老板支持榜</text><view wx:for="{{consumption}}" wx:key="user_id" class="rank-row"><text class="rank">{{item.rank}}</text><view class="rank-name"><text class="rank-nickname">{{item.nickname}}</text><text wx:if="{{item.title}}" class="rank-note">{{item.title}}</text></view><view class="rank-result"><text class="rank-value">{{item.amountText}}</text><text class="rank-unit">兴安币</text></view></view><text wx:if="{{!consumption.length}}" class="rank-empty">当前周期暂无上榜记录</text></view>
  </block>
</view>
<bottom-navigation/>
