.companion-detail { padding-bottom: calc(100px + env(safe-area-inset-bottom)); }
.detail-profile { display: flex; flex-wrap: wrap; align-items: center; gap: 24rpx; }
.detail-avatar { width: 152rpx; height: 180rpx; border-radius: 18rpx; flex-shrink: 0; background: var(--xa-color-primary-soft); }
.detail-initial { display: flex; align-items: center; justify-content: center; color: var(--xa-color-primary); font-size: 68rpx; }
.detail-identity { flex: 1; min-width: 0; }
.detail-identity .title { font-size: 36rpx; }
.detail-level { display: block; margin: 8rpx 0; color: var(--xa-color-muted); font-size: 26rpx; overflow-wrap: anywhere; }
.detail-monthly { width: 100%; padding-top: 20rpx; border-top: 1rpx solid var(--xa-color-border); }
.detail-amount { color: var(--xa-color-primary); font-size: 44rpx; font-weight: 600; overflow-wrap: anywhere; }
.detail-unit { color: var(--xa-color-muted); font-size: 24rpx; font-weight: 400; }
.detail-profile .xa-button.detail-voice { gap: 12rpx; margin: 0; }
.detail-voice image { width: var(--xa-icon-small); height: var(--xa-icon-small); }
.detail-context view { margin-top: 8rpx; overflow-wrap: anywhere; }
.detail-unavailable { margin: 0 0 20rpx; padding: 20rpx 24rpx; border-radius: 16rpx; background: var(--xa-color-primary-soft); color: var(--xa-color-muted); font-size: 26rpx; overflow-wrap: anywhere; }
.detail-bio { font-size: 28rpx; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; }
.detail-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.detail-qualification { padding: 12rpx 0; font-size: 26rpx; overflow-wrap: anywhere; }
.detail-qualification + .detail-qualification { border-top: 1rpx solid var(--xa-color-border); }
.detail-reference { margin-top: 14rpx; overflow-wrap: anywhere; }
.detail-actions { display: flex; align-items: center; gap: 20rpx; }
.detail-actions .xa-button { width: auto; margin: 0; min-height: var(--xa-control-height); }
.detail-actions .button-secondary { flex: 0 0 26%; }
.detail-actions .button { flex: 1; min-width: 0; }
