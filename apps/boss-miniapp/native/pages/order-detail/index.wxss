.order-detail-page { padding-bottom: 80px; }
.order-detail-page .panel { padding: 24rpx; margin: 0 0 24rpx; border-radius: 24rpx; }
.order-detail-page .panel > .section-title, .order-detail-page .section-heading { margin: 0 0 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--xa-color-border); }
.order-detail-page .section-title { font-size: 16px; line-height: 1.5; }
.section-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx 16rpx; }
.order-detail-page .section-heading .section-title { margin: 0; }
.order-summary .eyebrow { margin: 0 0 6rpx; font-size: var(--xa-control-small-font); }
.order-summary .status-title { color: var(--xa-color-primary); font-size: 24px; line-height: 1.4; letter-spacing: 0; }
.summary-cancelled .status-title { color: var(--xa-color-muted); }
.status-description { display: block; margin-top: 10rpx; color: var(--xa-color-muted); font-size: var(--xa-control-font); line-height: 1.6; overflow-wrap: anywhere; }
.order-number-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding-top: 18rpx; margin-top: 20rpx; border-top: 1rpx solid var(--xa-color-border); }
.order-number { flex: 1; min-width: 0; }
.meta-label { display: block; margin-bottom: 4rpx; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); }
.order-number-value { display: block; font-size: var(--xa-control-small-font); line-height: 1.5; overflow-wrap: anywhere; }
.order-detail-page .xa-button.copy-order { display: flex; align-items: center; justify-content: center; flex: 0 0 56px; width: 56px; min-height: 44px; margin: 0; padding: 8rpx 12rpx; border-radius: 12rpx; background: var(--xa-color-primary-soft); color: var(--xa-color-primary); font-size: var(--xa-control-small-font); font-weight: 500; }
.created-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4rpx 16rpx; margin-top: 12rpx; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.5; }
.section-description { display: block; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.6; overflow-wrap: anywhere; }
.service-name { display: block; font-size: var(--xa-control-font); font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; }
.amount-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12rpx 20rpx; margin-top: 20rpx; padding: 18rpx 0; font-size: var(--xa-control-font); }
.amount-value { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: flex-end; gap: 6rpx; min-width: 0; margin-left: auto; }
.order-detail-page .amount-value .price { font-size: 22px; line-height: 1.2; }
.amount-unit { color: var(--xa-color-muted); font-size: var(--xa-control-small-font); }
.detail-row { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; padding: 16rpx 0; font-size: var(--xa-control-font); line-height: 1.5; }
.detail-row + .detail-row { border-top: 1rpx solid var(--xa-color-border); }
.detail-row > text:first-child { flex-shrink: 0; }
.detail-row > text:last-child { min-width: 0; max-width: 70%; text-align: right; overflow-wrap: anywhere; }
.detail-row:last-child { padding-bottom: 0; }
.text-note, .status-note, .result { margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; background: var(--xa-color-surface-subtle); font-size: var(--xa-control-font); line-height: 1.6; overflow-wrap: anywhere; }
.text-note > text, .status-note > text { display: block; }
.note-label { display: block; margin-bottom: 6rpx; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); font-weight: 500; }
.result { background: var(--xa-color-primary-soft); }
.result-name { display: block; margin-bottom: 6rpx; color: var(--xa-color-primary); font-weight: 600; }
.status-tag { display: inline-flex; align-items: center; justify-content: center; max-width: 100%; padding: 4rpx 12rpx; border-radius: 8rpx; background: var(--xa-color-primary-soft); color: var(--xa-color-primary); font-size: var(--xa-control-small-font); font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.empty-hint { display: block; margin-top: 18rpx; padding: 16rpx; border-radius: 12rpx; background: var(--xa-color-surface-subtle); color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.6; }
.application { margin-top: 20rpx; padding: 18rpx; border: 1rpx solid var(--xa-color-border); border-radius: 16rpx; background: var(--xa-color-surface-subtle); }
.application-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx 12rpx; }
.application-title { font-size: var(--xa-control-font); font-weight: 600; }
.application-member { gap: 12rpx; }
.application-member > text:first-child { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.application-member > text:last-child { flex-shrink: 0; max-width: 45%; }
.timeline-list { margin-top: 4rpx; }
.timeline { position: relative; margin-left: 8rpx; padding: 0 0 24rpx 26rpx; border-left: 2rpx solid var(--xa-color-border); }
.timeline::before { content: ''; position: absolute; top: 8rpx; left: -7rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--xa-color-primary); }
.timeline:last-child { padding-bottom: 0; border-left-color: transparent; }
.timeline-title { display: block; font-size: var(--xa-control-font); line-height: 1.5; overflow-wrap: anywhere; }
.timeline:last-child .timeline-title { color: var(--xa-color-primary); font-weight: 600; }
.timeline-time { display: block; margin-top: 4rpx; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.5; }
.field-label { display: block; margin: 16rpx 0 10rpx; font-size: var(--xa-control-font); }
.order-detail-page .score-slider { min-height: 40px; margin: 8rpx 0 16rpx; }
.order-detail-page textarea.input { min-height: 80px; height: 80px; padding: 12rpx 18rpx; border-radius: 12rpx; font-size: var(--xa-control-font); }
.anonymous-control { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 44px; padding: 16rpx 0 0; font-size: var(--xa-control-font); }
.anonymous-control switch { flex-shrink: 0; }
.review-content { display: block; font-size: var(--xa-control-font); line-height: 1.6; overflow-wrap: anywhere; }
.aftersale-note { display: block; margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: var(--xa-color-primary-soft); color: var(--xa-color-primary); font-size: var(--xa-control-small-font); line-height: 1.5; }
.aftersale-history { margin-top: 18rpx; }
.order-detail-page .xa-button.button, .order-detail-page .xa-button.button-secondary { min-height: 44px; padding: 10rpx 20rpx; border-radius: 16rpx; font-size: var(--xa-control-font); line-height: 1.5; }
.order-detail-page .xa-button.select-application { margin-top: 16rpx; }
.order-actions { padding: 8px 24rpx 10px; }
.order-action-grid { display: flex; flex-wrap: nowrap; align-items: center; justify-content: flex-end; gap: 8px; }
.order-actions .xa-button.button, .order-actions .xa-button.button-secondary { display: flex; flex: 0 1 96px; align-items: center; justify-content: center; width: 96px; min-width: 0; min-height: 36px; margin: 0; padding: 6px; border-radius: 12rpx; font-size: var(--xa-control-small-font); line-height: 1.3; white-space: nowrap; }
.order-actions .xa-button.contact-support { flex-basis: 112px; width: 112px; }
.order-actions .xa-button.cancel-order { background: var(--xa-color-surface-subtle); color: var(--xa-color-danger); font-weight: 500; }
.order-detail-page .xa-button.copy-order[disabled], .order-detail-page .xa-button.button[disabled], .order-detail-page .xa-button.button-secondary[disabled], .order-actions .xa-button.button[disabled], .order-actions .xa-button.button-secondary[disabled] { background: var(--xa-color-surface-subtle); color: var(--xa-color-muted); }
