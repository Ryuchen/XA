<view class="page order-detail-page"><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后查看订单</button><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<block wx:if="{{order}}"><text class="eyebrow">{{order.order_no}}</text><text class="title">{{order.statusText}}</text><text class="subtitle">{{order.fulfillment || '订单进度以平台最新处理结果为准'}}</text>
<view class="panel"><text class="section-title">{{order.service.name}}</text><view class="between"><text class="muted">实付金额</text><text class="price">{{order.amountText}}<text class="small"> 兴安币</text></text></view><view class="menu-row"><text>陪玩</text><text>{{order.provider_name_snapshot || (order.requires_boss_selection ? '等待你选择陪玩' : '等待平台安排')}}</text></view><view wx:if="{{order.participants.length > 1}}" class="menu-row" wx:for="{{order.participants}}" wx:key="id"><text>组队陪玩</text><text>{{item.nickname}}</text></view><view wx:if="{{!order.isGift}}" class="menu-row"><text>游戏信息</text><text>{{order.game_region}} · {{order.game_nickname}}</text></view><view wx:if="{{order.provider_gender && order.provider_gender !== 'ANY'}}" class="menu-row"><text>陪玩选择</text><text>{{order.provider_gender === 'MALE' ? '男陪' : '女陪'}}</text></view><view wx:if="{{order.game_uid}}" class="menu-row"><text>UID</text><text user-select>{{order.game_uid}}</text></view><text wx:if="{{order.remark}}" class="subtitle">备注：{{order.remark}}</text><view wx:if="{{order.roulette_result}}" class="result"><text class="label">本次抽签结果</text><text>{{order.roulette_result.name}}</text><text class="subtitle small">{{order.roulette_result.description}}</text></view><text wx:if="{{order.cancel_reason}}" class="subtitle">取消原因：{{order.cancel_reason}}</text></view>
<view class="panel" wx:if="{{order.canSelectProvider}}"><text class="section-title">选择抢单陪玩</text><text class="subtitle">等级从高到低排序；两人组按较低等级优先比较。选择后按本单实付总价服务。</text><text wx:if="{{!order.applications.length}}" class="subtitle">正在等待陪玩报名，你也可以下拉刷新。</text><view class="application" wx:for="{{order.applications}}" wx:key="id"><view class="between"><text class="label">{{item.team_size === 2 ? '两人组队' : '一人服务'}}</text><text class="tag">{{item.ready ? '可选择' : '等待队友确认'}}</text></view><view wx:for="{{item.members}}" wx:for-item="member" wx:key="id" class="menu-row"><text>{{member.nickname}}</text><text>{{member.level}}</text></view><button class="xa-button button-secondary" data-id="{{item.id}}" bindtap="selectProvider" disabled="{{busy || !item.ready}}">选择这{{item.team_size}}名陪玩</button></view></view>
<view class="panel"><text class="section-title">{{order.isGift ? "赠礼记录" : "服务进度"}}</text><view class="timeline" wx:for="{{order.timeline}}" wx:key="title"><text>{{item.title}}</text><text class="muted small">{{item.time}}</text></view></view>
<view class="panel" wx:if="{{order.canEvaluate}}"><text class="section-title">评价本次服务</text><view class="between"><text>满意度</text><text class="tag">{{score}} 分</text></view><slider class="score-slider" min="1" max="5" step="1" value="{{score}}" activeColor="#002fa7" bindchange="score" disabled="{{busy}}"/><textarea class="input" value="{{content}}" maxlength="500" bindinput="content" placeholder="分享你的真实体验" disabled="{{busy}}"/><view class="menu-row anonymous-control"><text>匿名评价</text><switch checked="{{anonymous}}" bindchange="anonymous" color="#002fa7" disabled="{{busy}}"/></view><button class="xa-button button" bindtap="evaluate" loading="{{busy}}" disabled="{{busy}}" hover-class="xa-button-hover">提交评价</button></view>
<view class="panel" wx:if="{{order.evaluation}}"><text class="section-title">我的评价 · {{order.evaluation.score}} 分</text><text>{{order.evaluation.content || '用户未填写文字评价'}}</text><text wx:if="{{order.evaluation.reply_content}}" class="subtitle">陪玩回复：{{order.evaluation.reply_content}}</text></view>
<view class="panel" wx:if="{{order.canTip}}"><text class="section-title">把欣赏送给 TA</text><text class="subtitle">感谢这一局的陪伴，挑选一份心意。</text><button class="xa-button button-secondary" bindtap="tip" disabled="{{busy}}" hover-class="xa-button-hover">挑选礼物</button></view>
<view wx:if="{{order.aftersale_deadline && !order.isGift}}" class="panel"><text>售后截止：{{order.aftersaleDeadlineText}}</text><text wx:if="{{order.consumption_ready_at}}" class="subtitle">实销预计确认：{{order.consumptionReadyText}}</text><text wx:if="{{order.aftersale_status}}" class="subtitle">售后{{order.aftersale_status === 'OPEN' ? '处理中，暂停实销确认' : '已处理'}}</text><button wx:if="{{order.canAfterSale}}" class="xa-button button-secondary" bindtap="aftersale" disabled="{{busy}}">提交售后问题</button></view>
<button class="xa-button button" bindtap="support" hover-class="xa-button-hover">联系订单客服</button><button wx:if="{{order.canCancel}}" class="xa-button button-secondary" bindtap="cancel" disabled="{{busy}}" loading="{{busy}}" hover-class="xa-button-hover">取消待接订单</button><button wx:if="{{order.refunded_at}}" class="xa-button button-secondary" bindtap="wallet" hover-class="xa-button-hover">查看退款流水</button><button class="xa-button button-quiet" bindtap="copy" hover-class="xa-button-hover">复制订单编号</button></block></view>
