<view class="page achievements-page">
  <view class="page-heading"><text class="title" role="heading" aria-level="1">我的成就</text><text class="subtitle">记录你的每一次游戏体验</text><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后查看成就</button></view>
  <state-view wx:if="{{logged}}" loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !items.length}}" empty-text="成就记录将在这里展示" bind:retry="load"/>
  <block wx:if="{{logged && !error}}"><view class="panel achievement-card" wx:for="{{items}}" wx:key="code"><view class="achievement-heading"><text class="section-title" role="heading" aria-level="2">{{item.title}}</text><text class="achievement-state {{item.unlocked ? 'is-unlocked' : ''}}">{{item.unlocked ? '已达成' : '进行中'}}</text></view><text class="achievement-desc">{{item.desc}}</text><view class="achievement-progress"><text class="progress-label">当前进度</text><view class="progress-values"><text class="current-value">{{item.currentText}}</text><text class="target-value">/ {{item.targetText}} {{item.metric === 'amount' ? '兴安币' : '单'}}</text></view></view></view></block>
</view>
<bottom-navigation/>
