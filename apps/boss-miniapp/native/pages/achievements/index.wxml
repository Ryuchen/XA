<view class="page"><text class="title">我的成就</text><text class="subtitle">记录你的每一次游戏体验</text><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后查看成就</button><state-view loading="{{loading}}" error="{{error}}" empty="{{logged && !items.length}}" bind:retry="load"/>
<view class="panel" wx:for="{{items}}" wx:key="code"><view class="between"><text class="section-title">{{item.title}}</text><text class="tag">{{item.unlocked ? '已达成' : '进行中'}}</text></view><text class="muted">{{item.desc}}</text><view class="subtitle">{{item.currentText}} / {{item.targetText}} {{item.metric === 'amount' ? '兴安币' : '单'}}</view></view></view>
