.achievement-header { margin-bottom:12px; }
.achievement-header .title { display:block; font-size:24px; line-height:32px; letter-spacing:0; }
.achievement-header .subtitle { display:block; margin-top:4px; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:16px; }
.achievements-page .login-hit { display:inline-flex; align-items:center; justify-content:flex-start; width:auto; min-height:var(--xa-control-compact); margin:4px 0 0; padding:0; border:0; background:transparent; }
.login-face { display:inline-flex; align-items:center; min-height:24px; padding:0 8px; border-radius:4px; background:var(--xa-color-primary); color:var(--xa-color-on-primary); font-size:var(--xa-control-small-font); line-height:16px; }
.achievements-list { overflow:hidden; border:1px solid var(--xa-color-border); border-radius:12px; background:var(--xa-color-surface); }
.achievement-card { padding:12px; }
.achievement-card + .achievement-card { border-top:1px solid var(--xa-color-border); }
.achievement-heading,.achievement-progress,.progress-values { display:flex; align-items:baseline; justify-content:space-between; gap:8px; }
.achievement-title { flex:1; min-width:0; color:var(--xa-color-text); font-size:var(--xa-control-font); line-height:20px; font-weight:600; overflow-wrap:anywhere; }
.achievement-state { flex-shrink:0; padding:0 4px; border-radius:4px; background:var(--xa-color-primary-soft); color:var(--xa-color-primary); font-size:var(--xa-control-small-font); line-height:16px; font-weight:600; }
.achievement-state.is-unlocked { background:rgba(var(--xa-success-rgb),.1); color:var(--xa-color-success); }
.achievement-desc { display:block; margin-top:4px; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:16px; overflow-wrap:anywhere; }
.achievement-progress { margin-top:8px; }
.progress-label,.target-value { color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:16px; }
.progress-label { flex-shrink:0; }
.progress-values { min-width:0; justify-content:flex-end; flex-wrap:wrap; gap:0 4px; font-variant-numeric:tabular-nums; }
.current-value,.target-value { min-width:0; max-width:100%; overflow-wrap:anywhere; }
.current-value { color:var(--xa-color-text); font-size:var(--xa-control-font); font-weight:600; line-height:20px; }
.progress-bar { display:block; margin-top:4px; }
