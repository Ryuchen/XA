.favorite-heading { padding:24rpx; margin-bottom:24rpx; }
.favorite-title-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.favorite-heading .title { font-size:20px; }
.favorite-heading .subtitle { margin-top:8rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.favorite-badge { display:flex; align-items:center; justify-content:center; width:32px; height:32px; flex-shrink:0; border-radius:12rpx; background:var(--xa-color-favorite-soft); }
.favorite-badge image { width:18px; height:18px; }
.favorites-page .card.favorite { display:flex; align-items:center; gap:16rpx; padding:16rpx; margin-bottom:16rpx; border-radius:20rpx; }
.favorite-cover { display:block; width:176rpx; height:99rpx; flex-shrink:0; border-radius:10rpx; background:var(--xa-color-surface-subtle); }
.favorite-placeholder { display:flex; align-items:center; justify-content:center; }
.favorite-placeholder image { width:24px; height:24px; opacity:.7; }
.favorite-copy { flex:1; min-width:0; }
.favorite-name { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; font-size:var(--xa-control-font); font-weight:600; line-height:1.35; overflow-wrap:anywhere; }
.favorite-price { display:flex; flex-wrap:wrap; align-items:baseline; gap:4rpx; margin-top:6rpx; }
.favorite-amount { color:var(--xa-color-primary); font-size:var(--xa-control-font); font-weight:700; font-variant-numeric:tabular-nums; line-height:1.4; white-space:nowrap; }
.favorite-unit { color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; white-space:nowrap; }
.favorites-page .xa-button.favorite-remove { display:flex; align-items:center; justify-content:center; flex:0 0 76px; width:76px; min-height:30px; margin:0; padding:4px 6px; border-radius:10rpx; background:var(--xa-color-favorite-soft); color:var(--xa-color-favorite); font-size:var(--xa-control-small-font); font-weight:500; line-height:1.3; white-space:nowrap; }
.favorites-page .xa-button.favorite-remove[disabled] { background:var(--xa-color-surface-subtle); color:var(--xa-color-muted); }
.favorite-actions { padding:16rpx; margin-top:8rpx; margin-bottom:0; border-radius:20rpx; }
.favorites-page .xa-button.browse { min-height:36px; margin:0; padding:6px 12px; border-radius:12rpx; font-size:var(--xa-control-small-font); }
.favorite-card-hover { opacity:.82; }
@media (prefers-reduced-motion:reduce) { .favorite-card-hover { opacity:1; } }
