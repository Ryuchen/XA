.favorites-page .favorite-heading {
  margin:0 0 12px;
  padding:0;
  border:0;
  border-radius:0;
  background:transparent;
  box-shadow:none;
}
.favorite-title-row { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.favorite-heading .title { display:block; min-width:0; font-size:24px; line-height:32px; letter-spacing:0; }
.favorite-heading .subtitle { display:block; margin:4px 0 0; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:16px; }
.favorite-badge { display:flex; align-items:center; justify-content:center; flex:none; width:24px; height:24px; border-radius:8px; background:var(--xa-color-favorite-soft); }
.favorite-badge image { width:12px; height:12px; }
.favorites-page .card.favorite { display:flex; align-items:center; gap:8px; min-height:44px; margin:0 0 8px; padding:8px 12px; border:1px solid var(--xa-color-border); border-radius:12px; background:var(--xa-color-surface); box-shadow:none; }
.favorite-cover { width:40px; height:40px; flex:none; border-radius:8px; background:var(--xa-color-surface-subtle); }
.favorite-placeholder { display:flex; align-items:center; justify-content:center; }
.favorite-placeholder image { width:16px; height:16px; }
.favorite-copy { flex:1; min-width:0; }
.favorite-name { display:block; color:var(--xa-color-text); font-size:var(--xa-control-font); font-weight:600; line-height:20px; overflow-wrap:anywhere; }
.favorite-price { display:flex; flex-wrap:wrap; align-items:baseline; gap:0 4px; margin-top:4px; }
.favorite-unavailable,.favorite-unit { color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:16px; }
.favorite-unavailable { margin-top:4px; }
.favorite-amount { max-width:100%; overflow-wrap:anywhere; color:var(--xa-color-primary); font-size:var(--xa-control-font); font-weight:600; line-height:20px; font-variant-numeric:tabular-nums; }
.favorites-page .favorite-actions { margin:0; padding:0; border:0; background:transparent; box-shadow:none; }
.favorites-page .xa-button.favorite-remove,.favorites-page .xa-button.browse,.favorite-heading .xa-button {
  position:relative; z-index:0; display:inline-flex; align-items:center; justify-content:center; box-sizing:border-box;
  min-height:var(--xa-control-compact); margin:0; padding:0 8px; border:0; border-radius:0; background:transparent; color:var(--xa-color-text);
  font-size:var(--xa-control-small-font); line-height:16px; font-weight:600;
}
.favorites-page .xa-button.favorite-remove { flex:0 0 72px; width:72px; color:var(--xa-color-muted); }
.favorites-page .xa-button.browse { width:100%; color:var(--xa-color-primary); }
.favorite-heading .xa-button { width:auto; margin-top:4px; color:var(--xa-color-on-primary); }
.favorites-page .favorite-remove::after,.favorites-page .browse::after,.favorite-heading .xa-button::after {
  content:''; position:absolute; z-index:-1; box-sizing:border-box; left:0; top:50%; width:100%; height:24px; transform:translateY(-50%);
  border:1px solid var(--xa-color-border); border-radius:4px; background:var(--xa-color-surface);
}
.favorites-page .browse::after { background:var(--xa-color-primary-soft); border-color:var(--xa-color-primary-soft); }
.favorite-heading .xa-button::after { background:var(--xa-color-primary); border-color:var(--xa-color-primary); }
.favorites-page .xa-button.favorite-remove[disabled] { color:var(--xa-color-muted); }
.favorites-page .favorite-remove[disabled]::after { background:var(--xa-color-surface-subtle); }
.favorite-card-hover { background:var(--xa-color-primary-soft); }
