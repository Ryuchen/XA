.page > .subtitle { margin-bottom: 28rpx; }.favorite { display: flex; gap: 22rpx; align-items: flex-start; padding: 24rpx; }.favorite-cover { width: 124rpx; height: 148rpx; flex-shrink: 0; }.favorite-copy { flex: 1; min-width: 0; }.favorite-name { font-size: 29rpx; font-weight: 600; margin-bottom: 8rpx; overflow-wrap: anywhere; }.favorite-copy .row { flex-wrap: wrap; gap: 4rpx 16rpx; margin-top: 12rpx; }.favorite-copy .price { font-size: 30rpx; }.favorites-page .favorite-copy .xa-button.button-quiet { flex-shrink: 0; width: auto; min-height: var(--xa-control-compact); padding: 6rpx 12rpx; margin: 0 0 0 auto; border-radius: 12rpx; color: var(--xa-color-muted); background: #f5f1e9; font-size: var(--xa-control-small-font); line-height: 1.5; }.favorites-page .xa-button.browse { min-height: var(--xa-control-height); padding: 8rpx 20rpx; margin-top: 28rpx; font-size: var(--xa-control-font); border-radius: 16rpx; }
