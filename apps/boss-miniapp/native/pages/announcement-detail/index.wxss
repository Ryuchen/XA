.announcement-article { padding:12px; border:1px solid var(--xa-color-border); border-radius:12px; background:var(--xa-color-surface); }
.announcement-meta,.announcement-time { display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
.announcement-source,.announcement-pin,.announcement-time { font-size:var(--xa-control-small-font); line-height:16px; }
.announcement-source { color:var(--xa-color-muted); }
.announcement-pin { padding:0 4px; border-radius:4px; color:var(--xa-color-primary); background:var(--xa-color-primary-soft); font-weight:600; }
.announcement-title { display:block; margin-top:8px; color:var(--xa-color-text); font-size:20px; font-weight:600; line-height:28px; overflow-wrap:anywhere; }
.announcement-time { margin-top:8px; gap:4px 8px; color:var(--xa-color-muted); }
.time-label { flex-shrink:0; }
.announcement-body { min-width:0; margin-top:12px; padding-top:12px; border-top:1px solid var(--xa-color-border); }
.announcement-section-title { display:block; margin-bottom:8px; font-size:var(--xa-control-font); line-height:20px; font-weight:600; }
.announcement-content,.announcement-empty { display:block; max-width:100%; font-size:var(--xa-control-font); line-height:24px; overflow-wrap:anywhere; }
.announcement-content { color:var(--xa-color-text); white-space:pre-wrap; }
.announcement-empty { color:var(--xa-color-muted); }
.announcement-detail-page .login-hit { display:inline-flex; align-items:center; justify-content:flex-start; width:76px; min-height:var(--xa-control-compact); margin:0; padding:0; border:0; background:transparent; }
.login-face { display:inline-flex; align-items:center; min-height:24px; padding:0 8px; border-radius:4px; color:var(--xa-color-on-primary); background:var(--xa-color-primary); font-size:var(--xa-control-small-font); line-height:16px; }
