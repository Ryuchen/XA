<view class="page announcement-detail-page">
  <view wx:if="{{!logged}}" class="announcement-login"><button class="xa-button login-hit" bindtap="login" hover-class="xa-button-hover"><text class="login-face">登录后查看</text></button></view>
  <state-view wx:if="{{logged}}" loading="{{loading}}" error="{{error}}" bind:retry="load" />
  <view wx:if="{{logged && item && !error}}" class="announcement-article">
    <view class="announcement-heading">
      <view class="announcement-meta"><text class="announcement-source">兴安电竞 · 官方公告</text><text wx:if="{{item.is_pinned}}" class="announcement-pin">置顶</text></view>
      <text class="announcement-title" role="heading" aria-level="1" selectable>{{item.title}}</text>
      <view class="announcement-time"><text class="time-label">发布时间</text><text>{{item.dateText}}</text></view>
    </view>
    <view class="announcement-body">
      <text class="announcement-section-title" role="heading" aria-level="2">公告内容</text>
      <rich-text wx:if="{{item.content}}" class="announcement-content" nodes="{{item.content}}"/>
      <text wx:else class="announcement-empty">暂无公告正文</text>
    </view>
  </view>
</view>
<bottom-navigation/>
