<view class="page checkin-page">
  <view class="page-heading"><view class="checkin-heading"><view class="checkin-heading-icon"><image src="/assets/icons/calendar.png" aria-hidden="true"/></view><view><view class="title">每日签到</view><view class="subtitle">完成消费签到，领取本月专属奖励</view></view></view>
  <button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后查看</button></view>
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="load" />
  <block wx:if="{{logged && calendar && !loading && !error}}">
    <view class="panel summary"><view><text class="summary-value">{{calendar.checked_count}}</text><text class="small muted">本月已签 / 天</text></view><view><text class="summary-value">{{calendar.continuous_days}}</text><text class="small muted">连续签到 / 天</text></view><view><text class="summary-value">{{calendar.makeup_cards}}</text><text class="small muted">可用补签卡</text></view></view>
    <view class="panel rules"><view class="row between"><view class="section-title">今日消费</view><text class="tag">{{calendar.today_eligible ? '已达标' : '未达标'}}</text></view><view><text class="price">{{spendText}}</text><text class="muted"> / {{thresholdText}} 兴安币</text></view><view class="track"><view class="progress" style="width:{{progress}}%"></view></view><view class="small muted">当日消费满 {{cardThresholdText}} 兴安币可获得 1 张补签卡，最多持有 {{calendar.max_makeup_cards}} 张。</view></view>
    <view class="panel calendar"><view class="row between"><view class="section-title">{{calendar.year}} 年 {{calendar.month}} 月</view><text class="small muted">点击「补签」日期</text></view><view class="calendar-grid"><view wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</view></view><view class="calendar-grid"><button wx:for="{{cells}}" wx:key="key" class="xa-button day {{item.checked ? 'checked' : ''}} {{item.today ? 'today' : ''}}" disabled="{{!item.makeup || submitting || loading}}" data-day="{{item.day}}" bindtap="makeup" hover-class="xa-button-hover"><text>{{item.day || ''}}</text><text class="day-state">{{item.checked ? '已签' : item.makeup ? '补签' : item.today ? '今天' : ''}}</text></button></view>
    <button class="xa-button button checkin-button" loading="{{submitting}}" disabled="{{loading || !!error || submitting || calendar.today_checked || !calendar.today_eligible}}" bindtap="checkin" hover-class="xa-button-hover">{{buttonText}}</button></view>
    <view class="panel rewards-panel"><view class="section-title">本月签到礼物</view><scroll-view scroll-x class="reward-scroll"><view class="rewards"><view wx:for="{{rewards}}" wx:key="seq" class="card reward {{item.reached ? 'reached' : ''}}"><text class="small muted">第 {{item.seq}} 天{{item.reached ? ' · 已达成' : ''}}</text><text class="reward-name">{{item.name}}</text><text wx:if="{{item.amount > 0}}" class="price small">{{item.amountText}} 兴安币</text><text class="small muted">{{item.description}}</text></view></view></scroll-view></view>
    <view wx:if="{{calendar.full_attendance_reward.name}}" class="panel full-reward"><view class="row between"><view class="section-title">{{calendar.full_attendance_reward.name}}</view><text class="tag">{{calendar.full_attendance ? '已获得' : '全勤奖励'}}</text></view><text class="small muted">{{calendar.full_attendance_reward.description}}</text></view>
  </block>
</view>
<bottom-navigation/>
