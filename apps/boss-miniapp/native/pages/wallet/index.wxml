<view class="page wallet-page"><text class="title">我的钱包</text><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后查看钱包</button>
  <block wx:if="{{logged}}"><view class="panel balance-panel"><text class="muted">可用余额 · 兴安币</text><text class="balance">{{balance || '待加载'}}</text><text class="small muted">冻结金额 {{frozen || '待加载'}} 兴安币</text><button class="xa-button button" bindtap="recharge" hover-class="xa-button-hover">联系客服充值</button><text class="subtitle small">付款由客服核对，实际入账以余额与流水为准。</text></view>
  <text class="section-title">资金流水</text><view class="chips"><button wx:for="{{filters}}" wx:key="value" class="xa-button chip {{filter === item.value ? 'chip-active' : ''}}" data-value="{{item.value}}" bindtap="filter" hover-class="xa-button-hover">{{item.text}}</button></view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-text="暂无资金流水" bind:retry="load"/>
  <view class="panel transaction" wx:for="{{items}}" wx:key="id"><view class="between"><text>{{item.title}}</text><text class="amount {{item.amount > 0 ? 'positive' : ''}}">{{item.displayAmount}}</text></view><text class="small muted block">{{item.remark || item.tx_no}}</text><view class="between small muted"><text>{{item.time}}</text><text>余额 {{item.after}}</text></view></view>
  <text wx:if="{{moreError}}" class="error">{{moreError}}</text><button wx:if="{{hasMore}}" class="xa-button button-secondary" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="more" hover-class="xa-button-hover">加载更多</button></block>
</view>
