.balance-panel { margin-top: 28rpx; padding: 32rpx; background: #f7f4ec; border-color: #e9eefb; }.balance-panel > .muted { color: #002fa7; font-size: 25rpx; }.balance { display: block; font-size: 68rpx; color: #002fa7; font-weight: 650; line-height: 1.5; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }.balance-panel .xa-button.button { margin-top: 24rpx; }.amount { font-size: 32rpx; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }.positive { color: var(--xa-color-primary); }.block { display: block; margin: 12rpx 0 16rpx; overflow-wrap: anywhere; }.transaction { margin: 0; padding: 26rpx 0; border: 0; border-bottom: 1rpx solid var(--xa-color-border); background: transparent; border-radius: 0; }.transaction .between { flex-wrap: wrap; }.transaction .amount { margin-left: auto; }.chips { gap: 10rpx; }.wallet-page .chips .xa-button.chip { min-height: var(--xa-control-compact); padding: 6rpx 18rpx; font-size: var(--xa-control-small-font); border-radius: 16rpx; }

.wallet-page .balance-panel .xa-button.button { min-height: var(--xa-control-height); padding: 8rpx 20rpx; font-size: var(--xa-control-font); border-radius: 16rpx; }
