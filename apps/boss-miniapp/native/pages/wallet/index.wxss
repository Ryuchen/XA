.wallet-page .section-surface { padding:24rpx; margin-bottom:20rpx; border-color:var(--xa-color-border); border-radius:20rpx; }
.wallet-heading .title { font-size:20px; letter-spacing:0; }
.wallet-subtitle { display:block; margin-top:8rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; }
.wallet-page .xa-button.wallet-login { min-height:36px; margin-top:16rpx; padding:6px 12px; border-radius:12rpx; font-size:var(--xa-control-small-font); }
.balance-panel { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.balance-primary { flex:1; min-width:0; }
.balance-label { display:block; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; }
.balance { display:block; margin-top:6rpx; color:var(--xa-color-primary); font-size:24px; font-weight:700; line-height:1.3; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.balance.balance-long { font-size:18px; }
.frozen-panel { max-width:40%; min-width:0; padding-left:20rpx; border-left:1rpx solid var(--xa-color-border); text-align:right; }
.frozen-value { display:block; margin-top:6rpx; font-size:var(--xa-control-font); font-weight:500; line-height:1.5; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.recharge-panel { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.recharge-copy { flex:1; min-width:0; }
.section-label { display:block; font-size:var(--xa-control-font); font-weight:600; line-height:1.5; }
.recharge-note { display:block; margin-top:4rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; }
.wallet-page .xa-button.recharge-button { flex:0 0 104px; width:104px; min-height:36px; margin:0; padding:6px 8px; border-radius:12rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.wallet-page .transaction-controls { padding:16rpx 24rpx; margin-bottom:16rpx; }
.transaction-controls .chips { gap:12rpx; margin:12rpx 0 0; }
.wallet-page .chips .xa-button.chip { min-height:30px; margin:0; padding:4px 12px; border:0; border-radius:10rpx; background:var(--xa-color-surface-subtle); font-size:var(--xa-control-small-font); line-height:1.5; }
.wallet-page .chips .xa-button.chip-active { color:var(--xa-color-primary); background:var(--xa-color-primary-soft); }
.transaction { padding:16rpx; margin-bottom:16rpx; border:1rpx solid var(--xa-color-border); border-radius:20rpx; background:var(--xa-color-surface); }
.transaction-main { display:flex; align-items:baseline; justify-content:space-between; gap:12rpx; }
.transaction-title { flex:1; min-width:0; font-size:var(--xa-control-font); font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.transaction-amount { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:flex-end; gap:0 6rpx; max-width:65%; min-width:0; }
.amount { min-width:0; max-width:100%; font-size:16px; font-weight:700; line-height:1.4; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.amount.positive { color:var(--xa-color-primary); }
.amount.amount-long { font-size:var(--xa-control-font); }
.amount-unit { flex-shrink:0; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; white-space:nowrap; }
.transaction-remark { display:block; margin-top:6rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; white-space:pre-wrap; overflow-wrap:anywhere; }
.transaction-meta { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:4rpx 12rpx; margin-top:8rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; }
.transaction-time { flex-shrink:0; }
.transaction-after { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:flex-end; gap:0 6rpx; min-width:0; max-width:100%; margin-left:auto; }
.after-value { min-width:0; font-weight:500; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.wallet-page .transaction-actions { padding:16rpx; margin-bottom:0; }
.wallet-page .xa-button.more-button { min-height:36px; margin:0; padding:6px 12px; border-radius:12rpx; font-size:var(--xa-control-small-font); }
.more-error { display:block; margin-bottom:8rpx; color:var(--xa-color-danger); font-size:var(--xa-control-small-font); line-height:1.5; overflow-wrap:anywhere; }
