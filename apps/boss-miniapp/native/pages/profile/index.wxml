<view class="page profile-page">
  <view class="page-heading"><text class="title" role="heading" aria-level="1">个人资料</text><text class="subtitle">保存游戏信息，下次下单直接使用</text><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后编辑资料</button></view>
  <state-view wx:if="{{logged}}" loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{logged && !loading && !error}}">
    <view class="panel personal-panel">
      <button class="xa-button avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{busy}}" hover-class="xa-button-hover" aria-label="选择微信头像，选择后自动保存"><image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" aria-hidden="true"/><view wx:else class="avatar avatar-placeholder" aria-hidden="true">我</view><view class="avatar-copy"><text>选择微信头像</text><text class="avatar-hint">选择后自动保存</text></view><image class="entry-arrow" src="/assets/icons/chevron.png" aria-hidden="true"/></button>
      <view class="field"><label class="label" for="profile-nickname">昵称</label><input id="profile-nickname" class="input" type="nickname" value="{{nickname}}" maxlength="50" data-field="nickname" bindinput="input" placeholder="你的昵称" aria-label="昵称"/></view>
      <view class="phone-row"><view class="phone-copy"><text class="field-note">手机号</text><text class="phone-value">{{phone || '未设置'}}</text></view><button class="xa-button button-secondary verify-button" bindtap="security" hover-class="xa-button-hover">前往验证</button></view>
    </view>
    <view wx:if="{{profiles.length}}" class="panel game-panel">
      <text class="section-title" role="heading" aria-level="2">常用游戏</text><text class="label">当前默认游戏</text><picker range="{{profiles}}" range-key="name" value="{{selected}}" bindchange="choose" aria-label="选择默认游戏"><view class="input game-picker"><text>{{profiles[selected].name}}</text><text>切换 ›</text></view></picker><text class="field-note game-note">当前游戏将作为默认游戏</text>
      <view class="field"><label class="label" for="profile-region">游戏大区</label><input id="profile-region" class="input" value="{{profiles[selected].region}}" data-field="region" maxlength="50" bindinput="gameInput" placeholder="例如微信区、QQ区" aria-label="游戏大区"/></view>
      <view class="field"><label class="label" for="profile-game-nickname">游戏昵称</label><input id="profile-game-nickname" class="input" value="{{profiles[selected].nickname}}" data-field="nickname" maxlength="50" bindinput="gameInput" placeholder="用于联系和识别" aria-label="游戏昵称"/></view>
      <view class="field"><label class="label" for="profile-uid">游戏 UID</label><input id="profile-uid" class="input" value="{{profiles[selected].uid}}" data-field="uid" maxlength="50" bindinput="gameInput" placeholder="填写游戏账号编号" aria-label="游戏 UID"/></view>
    </view>
    <view class="section-surface profile-actions"><text class="field-note">保存后用于下次下单</text><button class="xa-button button" disabled="{{busy}}" loading="{{busy}}" bindtap="save" hover-class="xa-button-hover">保存资料</button></view>
  </block>
</view>
<bottom-navigation/>
