<view class="page profile-page"><text class="title">个人资料</text><text class="subtitle">保存游戏信息，下次下单直接使用</text><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后编辑资料</button><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{logged && !loading && !error}}"><view class="panel"><button class="xa-button avatar-button row" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{busy}}" hover-class="xa-button-hover"><image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill"/><view wx:else class="avatar avatar-placeholder">我</view><view><text>选择微信头像</text><text class="avatar-hint">选择后自动保存</text></view><text class="muted">›</text></button><view class="field"><text class="label">昵称</text><input class="input" type="nickname" value="{{nickname}}" maxlength="50" data-field="nickname" bindinput="input" placeholder="你的昵称"/></view><view class="between"><text class="muted">手机号 {{phone || '未设置'}}</text><text class="link" bindtap="security">前往验证</text></view></view>
  <view class="panel" wx:if="{{profiles.length}}"><text class="section-title">常用游戏</text><picker range="{{profiles}}" range-key="name" value="{{selected}}" bindchange="choose"><view class="input between"><text>{{profiles[selected].name}}</text><text>切换 ›</text></view></picker><text class="small muted">当前游戏将作为默认游戏</text><view class="field"><text class="label">游戏大区</text><input class="input" value="{{profiles[selected].region}}" data-field="region" maxlength="50" bindinput="gameInput" placeholder="例如微信区、QQ区"/></view><view class="field"><text class="label">游戏昵称</text><input class="input" value="{{profiles[selected].nickname}}" data-field="nickname" maxlength="50" bindinput="gameInput" placeholder="用于联系和识别"/></view><view class="field"><text class="label">游戏 UID</text><input class="input" value="{{profiles[selected].uid}}" data-field="uid" maxlength="50" bindinput="gameInput" placeholder="填写游戏账号编号"/></view></view>
  <button class="xa-button button" disabled="{{busy}}" loading="{{busy}}" bindtap="save" hover-class="xa-button-hover">保存资料</button></block>
</view>
