.profile-page > .subtitle { margin-bottom: 24rpx; }
.profile-page .panel { margin-top: 20rpx; }
.xa-button.avatar-button { display: flex; align-items: center; width: 100%; gap: 18rpx; padding: 0 0 22rpx; margin: 0; min-height: max(112rpx,56px); border-bottom: 1rpx solid var(--xa-color-border); border-radius: 0; background: transparent; text-align: left; font-size: var(--xa-control-font); }
.avatar-button .avatar { width: max(88rpx,44px); height: max(88rpx,44px); }
.xa-button.avatar-button > view:nth-child(2) { flex: 1; min-width: 0; }
.avatar-hint { display: block; margin-top: 4rpx; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); font-weight: 400; }
.profile-page .input { min-height: var(--xa-input-height); border-radius: var(--xa-radius-control); font-size: var(--xa-control-font); }
.profile-page input.input { height: var(--xa-input-height); padding: 0 18rpx; }
.profile-page picker .input { padding: 10rpx 18rpx; gap: 12rpx; }
.profile-page picker .input > text:first-child { flex: 1; }
.profile-page picker .input > text:last-child { flex-shrink: 0; font-size: var(--xa-control-small-font); color: var(--xa-color-primary); }
.profile-page .label { font-size: max(26rpx,13px); }
.profile-page .panel > .between { flex-wrap: wrap; gap: 8rpx 16rpx; font-size: max(26rpx,13px); }
.profile-page .panel > .between .link { display: flex; align-items: center; justify-content: flex-end; min-height: var(--xa-control-secondary); min-width: 36px; padding: 6rpx 0; font-size: max(26rpx,13px); }
.profile-page .panel > picker + .small { display: block; margin-top: 12rpx; font-size: var(--xa-control-small-font); }
.profile-page > .xa-button.button { min-height: var(--xa-control-height); padding: 12rpx 24rpx; font-size: var(--xa-control-font); }
