.profile-page .page-heading, .profile-page .panel, .profile-page .section-surface { margin-bottom:20rpx; padding:24rpx; border-color:var(--xa-color-border); border-radius:20rpx; }
.profile-page .title { font-size:20px; letter-spacing:0; }
.profile-page .subtitle { margin-top:8rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.profile-page .section-title { margin:0 0 16rpx; font-size:var(--xa-control-font); line-height:1.5; }
.profile-page .xa-button.avatar-button { display:flex; align-items:center; gap:16rpx; width:100%; min-height:44px; padding:0 0 16rpx; border-bottom:1rpx solid var(--xa-color-border); border-radius:0; background:transparent; text-align:left; font-size:var(--xa-control-font); }
.avatar-button .avatar { width:44px; height:44px; flex-shrink:0; font-size:18px; }
.avatar-copy { flex:1; min-width:0; }
.avatar-hint, .field-note { display:block; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); font-weight:400; line-height:1.5; overflow-wrap:anywhere; }
.avatar-hint { margin-top:4rpx; }
.entry-arrow { width:12px; height:12px; flex-shrink:0; }
.profile-page .field { margin:16rpx 0; }
.profile-page .field:last-child { margin-bottom:0; }
.profile-page .label { display:block; margin-bottom:8rpx; font-size:var(--xa-control-font); line-height:1.5; }
.profile-page .input { min-height:40px; border-radius:10rpx; font-size:var(--xa-control-font); }
.profile-page input.input { height:40px; padding:0 12px; }
.phone-row { display:flex; align-items:center; gap:16rpx; padding-top:12rpx; border-top:1rpx solid var(--xa-color-border); }
.phone-copy { flex:1; min-width:0; }
.phone-value { display:block; margin-top:4rpx; font-size:var(--xa-control-font); line-height:1.5; overflow-wrap:anywhere; }
.profile-page .xa-button.verify-button { width:88px; min-height:36px; margin:0; padding:6px; flex-shrink:0; border-radius:10rpx; font-size:var(--xa-control-small-font); }
.game-picker { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding:8px 12px; }
.game-picker > text:first-child { flex:1; min-width:0; overflow-wrap:anywhere; }
.game-picker > text:last-child { flex-shrink:0; color:var(--xa-color-primary); font-size:var(--xa-control-small-font); }
.game-note { margin-top:8rpx; }
.profile-page .profile-actions { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:16rpx 24rpx; }
.profile-actions .field-note { flex:1; min-width:0; }
.profile-page .profile-actions .xa-button.button { width:120px; min-height:40px; margin:0; padding:8px 12px; flex-shrink:0; border-radius:12rpx; font-size:var(--xa-control-font); }
.profile-page .page-heading .xa-button { min-height:36px; margin-top:12rpx; padding:6px 12px; border-radius:12rpx; font-size:var(--xa-control-small-font); }
