<view class="page catalog">
  <view wx:if="{{couponName}}" class="coupon-context"><view><text class="section-title">{{couponName}}</text><text class="small muted">以下为本券适用套餐，结算时选择使用</text></view><button class="xa-button button-quiet" bindtap="clearCoupon">全部服务 ›</button></view>
  <view class="catalog-heading page-heading"><text class="eyebrow">兴安服务商城</text><view class="title">好服务，合你心意</view><view class="subtitle">选好套餐，让下一局更有期待</view></view>
  <view wx:if="{{!logged}}" class="panel login-panel"><view class="section-title">登录后查看完整服务</view><view class="muted">绑定兴安账号，获取专属价格与可选陪玩。</view><button class="xa-button button" bindtap="login" hover-class="xa-button-hover">微信快捷登录</button></view>
  <block wx:else>
    <view wx:if="{{providerId}}" class="provider-banner row between"><text>为 {{providerName || '已选陪玩'}} 选择服务</text><button class="xa-button button-quiet" bindtap="clearProvider" hover-class="xa-button-hover">取消指定</button></view>
    <view class="catalog-controls"><view class="search-field"><image class="search-icon" src="/assets/icons/search.png"/><input class="input search" value="{{keyword}}" placeholder="搜索服务、玩法或游戏" bindinput="search" confirm-type="search" aria-label="搜索服务" /></view>
    <view wx:if="{{gameplayName}}" class="coupon-context"><view><text class="section-title">{{gameplayName}}</text><text class="small muted">当前仅展示此玩法下的套餐</text></view><button class="xa-button button-quiet" bindtap="clearGameplay">全部玩法 ›</button></view><view class="game-selector"><view class="label">先选游戏</view><scroll-view scroll-x class="filter-scroll"><view class="chips"><button wx:for="{{categories}}" wx:key="id" class="xa-button chip {{category === item.id ? 'chip-active' : ''}}" data-field="category" data-id="{{item.id}}" bindtap="choose" aria-pressed="{{category === item.id}}" hover-class="xa-button-hover"><image class="game-icon" src="{{item.iconUrl}}" mode="aspectFit" aria-hidden="true"/><text>{{item.name}}</text></button></view></scroll-view></view>
    <view class="panel filters">
      <view class="between filter-heading"><view class="label">选择分类</view><button class="xa-button button-quiet" bindtap="toggleFilters" aria-expanded="{{filtersExpanded}}" hover-class="xa-button-hover"><image class="filter-icon" src="/assets/icons/filter.png"/>{{filtersExpanded ? '收起筛选' : '更多筛选'}}{{category || platform || level ? ' · 已选' : ''}}</button></view><view class="service-tabs"><button wx:for="{{serviceTabs}}" wx:key="id" class="xa-button service-tab {{tab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseTab" aria-pressed="{{tab === item.id}}" hover-class="xa-button-hover">{{item.name}}</button></view>
      <block wx:if="{{filtersExpanded}}"><view wx:if="{{platforms.length}}" class="filter-line"><text class="label">平台</text><view class="chips"><button class="xa-button chip {{!platform ? 'chip-active' : ''}}" data-field="platform" bindtap="choose" hover-class="xa-button-hover">不限</button><button wx:for="{{platforms}}" wx:key="id" class="xa-button chip {{platform === item.id ? 'chip-active' : ''}}" data-field="platform" data-id="{{item.id}}" bindtap="choose" hover-class="xa-button-hover">{{item.name}}</button></view></view>
      <view wx:if="{{levels.length}}" class="filter-line"><text class="label">难度</text><view class="chips"><button class="xa-button chip {{!level ? 'chip-active' : ''}}" data-field="level" bindtap="choose" hover-class="xa-button-hover">不限</button><button wx:for="{{levels}}" wx:key="id" class="xa-button chip {{level === item.id ? 'chip-active' : ''}}" data-field="level" data-id="{{item.id}}" bindtap="choose" hover-class="xa-button-hover">{{item.name}}</button></view></view>
    </block></view></view>
    <view class="row between results-head section-surface"><text class="section-title">{{keyword ? '搜索结果' : '精选套餐'}} · {{total}}</text><view class="row"><button class="xa-button button-quiet {{sort === 'price' ? 'selected' : ''}}" data-field="sort" data-id="price" bindtap="choose" hover-class="xa-button-hover">价格 ↑</button><button class="xa-button button-quiet {{sort === 'default' ? 'selected' : ''}}" data-field="sort" data-id="default" bindtap="choose" hover-class="xa-button-hover">综合</button></view></view>
    <state-view wx:if="{{(loading && !displayed.length) || error || (!loading && !total)}}" loading="{{loading && !displayed.length}}" error="{{error}}" empty="{{!loading && !error && !total}}" bind:retry="load" />
    <button wx:if="{{!loading && !error && !total}}" class="xa-button button-secondary" bindtap="reset" hover-class="xa-button-hover">清除筛选条件</button>
    <button wx:for="{{displayed}}" wx:key="id" class="xa-button card service-card" data-id="{{item.id}}" bindtap="open" hover-class="xa-button-hover" aria-label="{{item.name + '，' + item.displayPrice + '兴安币每' + (item.price_unit || '份') + (item.variantCount > 1 ? '起' : '') + (item.purchase_mode === 'CONSULT' ? '，需客服确认' : '') + '，查看详情'}}">
      <image wx:if="{{item.cover}}" class="service-cover" src="{{item.cover}}" mode="aspectFit"/><view wx:else class="service-placeholder"><image src="/assets/icons/headphones.png" class="ui-icon"/></view>
      <view class="service-body"><view class="row between service-title-row"><text class="section-title">{{item.name}}</text><text class="arrow">›</text></view><view class="chips"><text wx:if="{{item.purchase_mode === 'CONSULT'}}" class="tag consult-tag">需客服确认</text><text wx:if="{{item.platform_name}}" class="tag">{{item.platform_name}}</text><text wx:if="{{item.security_level_name}}" class="tag">{{item.security_level_name}}</text><text wx:if="{{item.game_category_name}}" class="tag">{{item.game_category_name}}</text></view><view class="price service-price"><text class="service-amount">{{item.displayPrice}}</text><text class="muted small">兴安币 / {{ item.price_unit || '份' }}{{item.variantCount > 1 ? '起' : ''}}</text></view></view>
    </button>
    <button wx:if="{{!loading && !error && displayed.length < total}}" class="xa-button button-secondary" bindtap="more" hover-class="xa-button-hover">继续查看 · 还有 {{total - displayed.length}} 个项目</button>
  </block>
</view>
<bottom-navigation/>
