.detail-page { background: var(--xa-color-page); padding-bottom: calc(166rpx + env(safe-area-inset-bottom)); }.gallery,.gallery-image { display: block; width: 100%; height: 420rpx; border-radius: 24rpx; overflow: hidden; }.detail-placeholder { display: flex; align-items: center; justify-content: center; gap: 20rpx; width: 100%; height: 200rpx; background: var(--xa-color-primary-soft); color: var(--xa-color-primary); border-radius: 24rpx; font-size: 26rpx; }.detail-placeholder image { width: 64rpx; height: 64rpx; opacity: .65; }.intro { margin-top: 24rpx; }.intro .title { font-size: 36rpx; margin: 10rpx 0; }.intro .chips { margin: 18rpx 0; }.price-line { margin: 24rpx 0 14rpx; flex-wrap: wrap; }.price-line .price { font-size: 44rpx; }.description,.rules { font-size: 27rpx; line-height: 1.8; color: var(--xa-color-muted); white-space: pre-wrap; overflow-wrap: anywhere; }.rules { display: block; }.highlight { margin-top: 16rpx; font-size: 27rpx; display: flex; gap: 16rpx; }.check { color: var(--xa-color-primary); }.pool-note { margin-top: 12rpx; }.pool-row { padding: 20rpx 0; border-bottom: 1rpx solid var(--xa-color-border); }.pool-row:last-child { border-bottom: 0; padding-bottom: 0; }.pool-row .muted { margin-top: 8rpx; }.step { display: flex; align-items: flex-start; gap: 18rpx; margin-top: 22rpx; font-size: 26rpx; }.step > text { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--xa-color-primary-soft); color: var(--xa-color-primary); font-size: 22rpx; flex-shrink: 0; }.step > view { flex: 1; min-width: 0; }.review { border-top: 1rpx solid var(--xa-color-border); padding-top: 24rpx; margin-top: 22rpx; font-size: 26rpx; }.review-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; flex-shrink: 0; }.review-content { margin: 16rpx 0; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }.review-empty { margin-top: 20rpx; font-size: 26rpx; }.reply { background: var(--xa-color-page); padding: 18rpx; border-radius: 16rpx; margin: 12rpx 0; font-size: 25rpx; }.service-actions { display: flex; gap: 14rpx; }.service-actions .xa-button.button,.service-actions .xa-button.button-secondary { flex: 1; min-width: 0; width: auto; margin: 0; font-size:var(--xa-control-font); padding: 8rpx 12rpx; }.service-actions .xa-button.favorite { width: 104rpx; flex: 0 0 104rpx; padding: 6rpx 0; font-size: 24rpx; margin: 0; }.panel > .between > .price { font-size: 30rpx; }
