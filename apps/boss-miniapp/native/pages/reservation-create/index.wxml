<view class="page reservation-page">
  <view class="panel"><view class="title">预约陪玩</view><view class="subtitle">先约时间，确认后再转为订单</view></view>
  <view wx:if="{{!logged}}" class="panel"><button class="xa-button button" bindtap="login">登录后预约</button></view>
  <state-view wx:else loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <view wx:if="{{logged && !loading && error}}" class="panel"><button class="xa-button button-secondary" bindtap="browse">重新选择服务</button></view>
  <block wx:if="{{logged && !loading && !error && service && provider}}">
    <view class="panel"><view class="section-title">预约内容</view><view class="row"><text>服务</text><text>{{service.name}}</text></view><view class="row"><text>陪玩</text><text>{{provider.nickname}}</text></view></view>
    <view class="panel"><view class="section-title">选择时间</view><view class="row"><text>日期</text><picker mode="date" value="{{day}}" bindchange="day"><view class="picker">{{day}} ›</view></picker></view><view class="row"><text>开始时间</text><picker mode="time" value="{{time}}" bindchange="time"><view class="picker">{{time}} ›</view></picker></view><view class="row"><text>时长</text><picker range="{{durations}}" value="{{durationIndex}}" bindchange="duration"><view class="picker">{{durations[durationIndex]}} 分钟 ›</view></picker></view><text class="small muted">北京时间（UTC+8）；开始时间须为 15 分钟刻度，最多提前 30 天。</text></view>
    <view class="panel"><view class="section-title">游戏信息</view><view class="row"><text>服务数量</text><input type="number" value="{{rounds}}" data-key="rounds" bindinput="input"/></view><view class="row"><text>游戏区服</text><input placeholder="选填" value="{{region}}" data-key="region" bindinput="input"/></view><view class="row"><text>游戏昵称</text><input placeholder="选填" value="{{nickname}}" data-key="nickname" bindinput="input"/></view><view class="row"><text>游戏 ID</text><input placeholder="选填" value="{{uid}}" data-key="uid" bindinput="input"/></view><view class="row"><text>备注</text><input placeholder="选填" maxlength="255" value="{{remark}}" data-key="remark" bindinput="input"/></view></view>
    <view class="panel"><text class="small muted">提交预约不扣款；陪玩确认后，转单时查看实时价格并确认支付。</text><view wx:if="{{uncertain}}"><text class="small error">预约结果未确认，请先到我的预约核对，避免重复预约。</text><button class="xa-button button" bindtap="list">查看我的预约</button><button class="xa-button button-secondary" bindtap="reviewed">已核对，继续预约</button></view><block wx:else><button class="xa-button button" bindtap="submit" disabled="{{busy}}" loading="{{busy}}">提交预约</button><button class="xa-button button-secondary" bindtap="list">我的预约</button></block></view>
  </block>
</view>
<bottom-navigation/>
