.messages-page { background:var(--xa-color-page); }
.message-overview, .message-panel { padding:24rpx; margin-bottom:20rpx; border:1rpx solid var(--xa-color-border); border-radius:24rpx; background:var(--xa-color-surface); }
.message-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.message-heading .title { min-width:0; font-size:20px; letter-spacing:0; }
.unread-total { flex-shrink:0; padding:4rpx 12rpx; border-radius:10rpx; background:rgba(var(--xa-danger-rgb),.1); color:var(--xa-color-danger); font-size:var(--xa-control-small-font); font-weight:600; line-height:1.5; white-space:nowrap; }
.shortcuts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; margin-top:16rpx; padding-top:12rpx; border-top:1rpx solid var(--xa-color-border); }
.messages-page .xa-button.shortcut { display:flex; align-items:center; gap:12rpx; min-width:0; min-height:44px; width:100%; padding:4rpx 0; background:transparent; text-align:left; font-weight:400; }
.shortcut > view:last-child { flex:1; min-width:0; }
.shortcut-icon, .announcement-icon { display:flex; align-items:center; justify-content:center; width:32px; height:32px; flex-shrink:0; border-radius:12rpx; background:var(--xa-color-primary-soft); }
.shortcut-icon image, .announcement-icon image { width:16px; height:16px; }
.shortcut-title { display:block; font-size:var(--xa-control-font); font-weight:600; line-height:1.4; white-space:nowrap; }
.shortcut-note { display:block; margin-top:2rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; }
.messages-page .xa-button.login-button { margin-top:12rpx; }
.messages-page .xa-button.announcement-entry { display:flex; align-items:center; gap:16rpx; width:100%; min-height:54px; margin:0 0 20rpx; padding:16rpx; border:1rpx solid var(--xa-color-border); border-radius:20rpx; background:var(--xa-color-surface); text-align:left; font-weight:400; }
.announcement-icon { background:var(--xa-color-surface-subtle); }
.announcement-copy { flex:1; min-width:0; }
.announcement-title { display:block; font-size:var(--xa-control-font); font-weight:600; line-height:1.4; }
.announcement-note { display:block; margin-top:2rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; }
.entry-arrow { width:12px; height:12px; flex-shrink:0; }
.message-panel { padding:16rpx; border-radius:20rpx; }
.message-segments { display:flex; gap:8rpx; padding:6rpx; border-radius:14rpx; background:var(--xa-color-surface-subtle); }
.message-segments .xa-button { display:flex; flex:1; align-items:center; justify-content:center; gap:8rpx; min-width:0; min-height:30px; margin:0; padding:4px 6px; border-radius:10rpx; background:transparent; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); font-weight:500; line-height:1.3; }
.message-segments .xa-button.active { color:var(--xa-color-primary); background:var(--xa-color-surface); font-weight:600; }
.segment-count { min-width:18px; padding:1px 5px; border-radius:6rpx; background:rgba(var(--xa-danger-rgb),.1); color:var(--xa-color-danger); font-size:var(--xa-control-small-font); line-height:1.3; }
.feed-filter-scroll, .filter-scroll { width:100%; margin-top:14rpx; white-space:nowrap; }
.feed-filter-scroll .chips, .filter-scroll .chips { display:inline-flex; flex-wrap:nowrap; gap:10rpx; margin:0; }
.feed-filter-scroll .xa-button.chip, .filter-scroll .xa-button.chip { min-height:30px; margin:0; padding:4px 12px; border:0; border-radius:10rpx; background:var(--xa-color-surface-subtle); font-size:var(--xa-control-small-font); line-height:1.3; }
.feed-filter-scroll .xa-button.chip-active, .filter-scroll .xa-button.chip-active { color:var(--xa-color-primary); background:var(--xa-color-primary-soft); }
.private-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin-top:10rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; }
.private-toolbar > text { min-width:0; overflow-wrap:anywhere; }
.messages-page .private-toolbar .xa-button.mark-read { flex:0 0 96px; width:96px; min-height:30px; margin:0; padding:4px 6px; border-radius:10rpx; background:var(--xa-color-primary-soft); color:var(--xa-color-primary); font-size:var(--xa-control-small-font); line-height:1.3; }
.messages-page .private-toolbar .xa-button.mark-read[disabled] { background:var(--xa-color-surface-subtle); color:var(--xa-color-muted); }
.broadcast-card { display:flex; align-items:flex-start; gap:16rpx; padding:16rpx; margin-bottom:16rpx; border:1rpx solid var(--xa-color-border); border-radius:20rpx; background:var(--xa-color-surface); }
.broadcast-symbol { display:flex; align-items:center; justify-content:center; width:30px; height:30px; flex-shrink:0; border-radius:10rpx; background:var(--xa-color-primary-soft); }
.broadcast-symbol image { width:16px; height:16px; }
.broadcast-copy { flex:1; min-width:0; }
.broadcast-meta { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:4rpx 12rpx; }
.broadcast-label { color:var(--xa-color-primary); font-size:var(--xa-control-small-font); font-weight:600; line-height:1.4; }
.broadcast-time { color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; }
.broadcast-text { display:block; margin-top:6rpx; font-size:var(--xa-control-font); line-height:1.5; overflow-wrap:anywhere; white-space:pre-wrap; }
.feed-end { display:block; padding:12rpx; border-radius:12rpx; background:var(--xa-color-surface); color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; text-align:center; }
.notice { padding:16rpx; margin-bottom:16rpx; border:1rpx solid var(--xa-color-border); border-radius:20rpx; background:var(--xa-color-surface); }
.notice-unread { border-color:var(--xa-color-primary); box-shadow:inset 3px 0 0 var(--xa-color-primary); }
.notice-meta { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.notice-labels { display:flex; flex-shrink:0; align-items:center; gap:8rpx; }
.notice-type { padding:2rpx 8rpx; border-radius:6rpx; background:var(--xa-color-surface-subtle); color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; }
.notice-state { display:flex; align-items:center; gap:4px; padding:2rpx 6rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; white-space:nowrap; }
.notice-state.is-unread { color:var(--xa-color-danger); font-weight:600; }
.unread-dot { width:6px; height:6px; flex-shrink:0; border-radius:50%; background:var(--xa-color-danger); }
.notice-time { min-width:0; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; text-align:right; }
.notice-title { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; margin-top:10rpx; overflow:hidden; color:var(--xa-color-text); font-size:var(--xa-control-font); font-weight:500; line-height:1.35; overflow-wrap:anywhere; }
.notice-unread .notice-title { font-weight:700; }
.preview { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; margin-top:6rpx; overflow:hidden; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; overflow-wrap:anywhere; }
.list-actions { padding:16rpx; margin-bottom:0; border-radius:20rpx; }
.messages-page .list-actions .xa-button { min-height:36px; margin:0; padding:6px 12px; border-radius:12rpx; font-size:var(--xa-control-small-font); }
.more-error { display:block; padding:8rpx 0 0; font-size:var(--xa-control-small-font); }
.message-guest { display:block; padding:24rpx 8rpx 8rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; text-align:center; }
.notice-hover { opacity:.82; }
@media (prefers-reduced-motion:reduce) { .notice-hover { opacity:1; } }
