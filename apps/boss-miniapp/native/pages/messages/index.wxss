.messages-page { background: var(--xa-color-page); }
.message-overview, .message-panel { padding: 24rpx; border: 1rpx solid var(--xa-color-border); border-radius: 24rpx; background: #fffdf5; }
.message-overview { margin-bottom: 24rpx; }
.message-heading .title { font-size: 34rpx; letter-spacing: 0; }
.message-heading .tag { font-size: 22rpx; }
.shortcuts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; margin-top: 20rpx; padding-top: 8rpx; border-top: 1rpx solid var(--xa-color-border); }
.xa-button.shortcut { display: flex; align-items: center; gap: 12rpx; min-height: 104rpx; width: 100%; padding: 14rpx 0; background: transparent; text-align: left; font-weight: 400; }
.xa-button.shortcut + .shortcut { padding-left: 20rpx; }
.shortcut-icon { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 16rpx; background: var(--xa-color-primary-soft); flex-shrink: 0; }
.shortcut-icon image { width:var(--xa-icon-medium); height:var(--xa-icon-medium); }
.shortcut-title { display: block; margin-bottom: 3rpx; font-size: var(--xa-control-font); font-weight: 600; white-space: nowrap; }
.shortcut .small { display: block; font-size: var(--xa-control-small-font); }
.shortcut .shortcut-arrow { display: none; width: 28rpx; height: 28rpx; }
.xa-button.login-button { margin-top: 12rpx; }
.xa-button.announcement-entry { display: flex; align-items: center; gap: 16rpx; width: 100%; min-height: 116rpx; padding: 22rpx 24rpx; margin: 0 0 24rpx; border: 1rpx solid var(--xa-color-border); border-radius: 24rpx; background: #fffdf5; text-align: left; font-weight: 400; }
.announcement-icon { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 16rpx; background: #f5f1e9; flex-shrink: 0; }
.announcement-icon image { width:var(--xa-icon-small); height:var(--xa-icon-small); }
.announcement-entry > view:nth-child(2) { flex: 1; min-width: 0; }
.announcement-title { display: block; font-size: var(--xa-control-font); font-weight: 600; }
.announcement-entry .small { display: block; margin-top: 3rpx; font-size: var(--xa-control-small-font); }
.announcement-entry .entry-arrow { width: var(--xa-icon-small); height: var(--xa-icon-small); flex-shrink: 0; }
.message-panel { overflow: hidden; }
.message-segments { display: flex; gap: 8rpx; padding: 6rpx; border-radius: 18rpx; background: #f3f1f5; }
.message-segments .xa-button { display: flex; align-items: center; justify-content: center; gap: 8rpx; flex: 1; min-height: var(--xa-control-compact); margin: 0; padding: 6rpx 4rpx; border-radius: 14rpx; background: transparent; color: var(--xa-color-muted); font-size: max(26rpx,13px); font-weight: 500; }
.message-segments .xa-button.active { color: var(--xa-color-primary); background: #fffdf5; box-shadow: 0 2rpx 8rpx #41303b0a; font-weight: 600; }
.segment-count { min-width: 30rpx; padding: 2rpx 8rpx; border-radius: 8rpx; background: var(--xa-color-primary-soft); color: var(--xa-color-primary); font-size: 20rpx; line-height: 1.4; }
.feed-filter-scroll, .filter-scroll { width: 100%; white-space: nowrap; margin-top: 16rpx; }
.feed-filter-scroll .chips, .filter-scroll .chips { display: inline-flex; flex-wrap: nowrap; gap: 10rpx; margin: 0; padding-bottom: 8rpx; }
.feed-filter-scroll .xa-button.chip, .filter-scroll .xa-button.chip { min-height:var(--xa-control-compact); padding: 6rpx 18rpx; border: 0; border-radius: 12rpx; background: #f5f1e9; font-size:var(--xa-control-small-font); }
.feed-filter-scroll .xa-button.chip-active, .filter-scroll .xa-button.chip-active { color: var(--xa-color-primary); background: var(--xa-color-primary-soft); }
.broadcast-card { display: flex; gap: 16rpx; padding: 26rpx 0; }
.broadcast-card + .broadcast-card { border-top: 1rpx solid var(--xa-color-border); }
.broadcast-symbol { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 16rpx; background: var(--xa-color-primary-soft); flex-shrink: 0; }
.broadcast-symbol image { width:var(--xa-icon-small); height:var(--xa-icon-small); }
.broadcast-copy { flex: 1; min-width: 0; }
.broadcast-copy .between { flex-wrap: wrap; gap: 4rpx 12rpx; }
.broadcast-label { color: var(--xa-color-primary); font-size: 24rpx; font-weight: 600; }
.broadcast-copy .small { font-size: 21rpx; }
.broadcast-text { display: block; margin-top: 8rpx; font-size: 26rpx; line-height: 1.7; overflow-wrap: anywhere; }
.feed-end { display: block; padding: 10rpx 0 4rpx; text-align: center; color: var(--xa-color-muted); font-size: 22rpx; }
.xa-button.more-feed { margin: 4rpx 0 0; }
.private-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 8rpx; }
.private-toolbar .small { font-size: 22rpx; }
.private-toolbar .xa-button.button-quiet { width: auto; min-height: var(--xa-control-secondary); padding: 6rpx 0; margin: 0; font-size: var(--xa-control-small-font); flex-shrink: 0; }
.notice { padding: 24rpx 0; border-bottom: 1rpx solid var(--xa-color-border); }
.notice-title { margin: 14rpx 0 8rpx; font-weight: 600; font-size: 28rpx; line-height: 1.5; overflow-wrap: anywhere; }
.unread-dot { display: inline-block; width: 10rpx; height: 10rpx; margin-right: 10rpx; border-radius: 50%; background: var(--xa-color-primary); vertical-align: middle; }
.preview { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 25rpx; line-height: 1.65; }
.notice .tag { font-size: 21rpx; }
.notice .small { font-size: 22rpx; }
.xa-button.more { margin: 24rpx 0 0; }
.message-guest { padding: 32rpx 4rpx 12rpx; text-align: center; font-size: 24rpx; }
