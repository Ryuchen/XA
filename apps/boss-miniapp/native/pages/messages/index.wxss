/* 消息中心 · 澄海 2026
   概览卡 + 分段控件（白色滑片）+ 未读左侧强调条。 */
.messages-page { background:transparent; }

.message-overview, .message-panel {
  padding:26rpx; margin-bottom:20rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-2xl);
  background:var(--xa-color-surface-card); box-shadow:var(--xa-elev-1);
}
.message-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.message-heading .title { min-width:0; font-size:40rpx; letter-spacing:-1.2rpx; }
.unread-total {
  flex-shrink:0; padding:6rpx 18rpx; border-radius:var(--xa-r-pill);
  background:rgba(var(--xa-danger-rgb),.1); color:var(--xa-color-danger);
  font-size:21rpx; font-weight:600; line-height:1.4; white-space:nowrap;
}

.shortcuts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; margin-top:20rpx; padding-top:18rpx; border-top:1rpx solid var(--xa-hairline); }
.messages-page .xa-button.shortcut {
  display:flex; align-items:center; gap:14rpx; min-width:0; min-height:var(--xa-control-height); width:100%;
  margin:0; padding:8rpx 12rpx; border-radius:var(--xa-r-md); background:#f7f9fd;
  text-align:left; font-weight:400;
}
.shortcut > view:last-child { flex:1; min-width:0; }
.shortcut-icon, .announcement-icon {
  display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; flex-shrink:0;
  border-radius:20rpx; background:linear-gradient(150deg,#eef4ff,#dbeafe);
  box-shadow:inset 0 0 0 1rpx rgba(37,99,235,.10);
}
.shortcut-icon image, .announcement-icon image { width:30rpx; height:30rpx; }
.shortcut-title { display:block; font-size:27rpx; font-weight:600; line-height:1.35; white-space:nowrap; }
.shortcut-note { display:block; margin-top:2rpx; font-size:21rpx; line-height:1.4; color:var(--xa-color-muted); }
.messages-page .xa-button.login-button { margin-top:16rpx; }

.messages-page .xa-button.announcement-entry {
  display:flex; align-items:center; gap:16rpx; width:100%; min-height:var(--xa-control-height);
  margin:0 0 20rpx; padding:20rpx; border:1rpx solid var(--xa-hairline);
  border-radius:var(--xa-r-xl); background:var(--xa-color-surface-card);
  text-align:left; font-weight:400; box-shadow:var(--xa-elev-1);
}
.announcement-icon { background:#f3f6fc; box-shadow:none; }
.announcement-copy { flex:1; min-width:0; }
.announcement-title { display:block; font-size:27rpx; font-weight:600; line-height:1.35; }
.announcement-note { display:block; margin-top:2rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:21rpx; line-height:1.4; color:var(--xa-color-muted); }
.entry-arrow { width:22rpx; height:22rpx; flex-shrink:0; opacity:.5; }

.message-panel { padding:18rpx; border-radius:var(--xa-r-xl); }
.message-segments { display:flex; gap:6rpx; padding:6rpx; border-radius:var(--xa-r-md); background:#eff3f9; }
.message-segments .xa-button {
  display:flex; flex:1; align-items:center; justify-content:center; gap:8rpx; min-width:0;
  min-height:64rpx; margin:0; padding:6rpx; border-radius:var(--xa-r-sm);
  background:transparent; color:var(--xa-color-muted); font-size:24rpx; font-weight:600; line-height:1.3;
}
.message-segments .xa-button.active { color:var(--xa-color-primary); background:#fff; box-shadow:var(--xa-elev-1); }
.segment-count { min-width:20px; padding:1px 6px; border-radius:var(--xa-r-pill); background:rgba(var(--xa-danger-rgb),.1); color:var(--xa-color-danger); font-size:19rpx; line-height:1.35; }

.feed-filter-scroll, .filter-scroll { width:100%; margin-top:16rpx; white-space:nowrap; }
.feed-filter-scroll .chips, .filter-scroll .chips { display:inline-flex; flex-wrap:nowrap; gap:10rpx; margin:0; }
.feed-filter-scroll .xa-button.chip, .filter-scroll .xa-button.chip {
  min-height:60rpx; height:60rpx; margin:0; padding:0 22rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-pill);
  background:var(--xa-color-surface-card); font-size:22rpx; line-height:1.3;
}
.feed-filter-scroll .xa-button.chip-active, .filter-scroll .xa-button.chip-active {
  color:var(--xa-color-on-primary); border-color:transparent; background:var(--xa-color-primary);
  box-shadow:0 8px 16px -10px rgba(37,99,235,.9);
}

.private-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin-top:14rpx; font-size:21rpx; line-height:1.4; color:var(--xa-color-muted); }
.private-toolbar > text { min-width:0; overflow-wrap:anywhere; }
.messages-page .private-toolbar .xa-button.mark-read {
  flex:0 0 auto; width:auto; min-height:56rpx; margin:0; padding:0 20rpx; border-radius:var(--xa-r-pill);
  background:rgba(37,99,235,.08); color:var(--xa-color-primary-hover);
  font-size:21rpx; font-weight:600; line-height:1.3;
}
.messages-page .private-toolbar .xa-button.mark-read[disabled] { background:#f3f6fc; color:var(--xa-color-muted); }

/* ── 俱乐部动态 ───────────────────────────────────────────── */
.broadcast-card {
  display:flex; align-items:flex-start; gap:16rpx; padding:20rpx; margin-bottom:16rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-xl);
  background:var(--xa-color-surface-card); box-shadow:var(--xa-elev-1);
}
.broadcast-symbol {
  display:flex; align-items:center; justify-content:center; width:60rpx; height:60rpx; flex-shrink:0;
  border-radius:18rpx; background:linear-gradient(150deg,#eef4ff,#dbeafe);
}
.broadcast-symbol image { width:28rpx; height:28rpx; }
.broadcast-copy { flex:1; min-width:0; }
.broadcast-meta { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:4rpx 12rpx; }
.broadcast-label { font-size:21rpx; font-weight:600; line-height:1.4; color:var(--xa-color-primary); letter-spacing:.4rpx; }
.broadcast-time { font-size:20rpx; line-height:1.4; color:var(--xa-color-muted); }
.broadcast-text { display:block; margin-top:8rpx; font-size:27rpx; line-height:1.55; overflow-wrap:anywhere; white-space:pre-wrap; }
.feed-end { display:block; padding:14rpx; border-radius:var(--xa-r-md); background:rgba(255,254,250,.7); text-align:center; font-size:21rpx; line-height:1.4; color:var(--xa-color-muted); }

/* ── 我的通知 ─────────────────────────────────────────────── */
.notice {
  position:relative; padding:20rpx 20rpx 20rpx 24rpx; margin-bottom:16rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-xl);
  background:var(--xa-color-surface-card); box-shadow:var(--xa-elev-1);
  overflow:hidden;
}
.notice-unread { border-color:rgba(37,99,235,.28); }
.notice-unread::before {
  content:''; position:absolute; left:0; top:0; bottom:0; width:6rpx;
  background:linear-gradient(180deg,#38bdf8,#2563eb); border-radius:0 6rpx 6rpx 0;
}
.notice-meta { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.notice-labels { display:flex; flex-shrink:0; align-items:center; gap:8rpx; }
.notice-type { padding:3rpx 12rpx; border-radius:var(--xa-r-pill); background:#f3f6fc; font-size:20rpx; line-height:1.4; color:var(--xa-color-muted); }
.notice-state { display:flex; align-items:center; gap:6rpx; padding:2rpx 6rpx; font-size:20rpx; line-height:1.4; color:var(--xa-color-muted); white-space:nowrap; }
.notice-state.is-unread { color:var(--xa-color-danger); font-weight:600; }
.unread-dot { width:10rpx; height:10rpx; flex-shrink:0; border-radius:50%; background:var(--xa-color-danger); }
.notice-time { min-width:0; font-size:20rpx; line-height:1.4; color:var(--xa-color-muted); text-align:right; }
.notice-title {
  display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; margin-top:12rpx; overflow:hidden;
  font-size:28rpx; font-weight:600; line-height:1.4; letter-spacing:-.2rpx; color:var(--xa-color-text); overflow-wrap:anywhere;
}
.notice-unread .notice-title { font-weight:700; }
.preview { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; margin-top:6rpx; overflow:hidden; font-size:22rpx; line-height:1.55; color:var(--xa-color-muted); overflow-wrap:anywhere; }

.list-actions { padding:16rpx; margin-bottom:0; border-radius:var(--xa-r-xl); }
.messages-page .list-actions .xa-button { min-height:80rpx; margin:0; padding:0 24rpx; border-radius:var(--xa-r-pill); font-size:24rpx; }
.more-error { display:block; padding:8rpx 0 0; font-size:21rpx; }
.message-guest { display:block; padding:24rpx 8rpx 8rpx; font-size:22rpx; line-height:1.5; text-align:center; color:var(--xa-color-muted); }

.notice-hover { transform:translate3d(0,-2rpx,0); box-shadow:var(--xa-elev-2); }
@media (prefers-reduced-motion:reduce) { .notice-hover { transform:none; } }
