/* 消息中心 · 澄海 App 基线
   标题与未读数同一行；分段控件用 iOS 式轨道 + 白色滑片；未读只靠一个小圆点，
   不再用左侧彩条——那是网页时代的装饰，分组列表里一个点就够。 */

.messages-page { background: transparent; }

.message-overview {
  padding: 0; margin-bottom: var(--xa-s-4);
  border: 0; background: transparent; box-shadow: none;
}
.message-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--xa-s-4); }
.message-heading .title { min-width: 0; font-size: var(--xa-fs-h1); letter-spacing: -1rpx; }
.unread-total {
  flex-shrink: 0; padding: 6rpx 18rpx; border-radius: var(--xa-r-pill);
  background: rgba(var(--xa-danger-rgb), .09); color: var(--xa-color-danger);
  font-size: var(--xa-fs-cap); font-weight: 600; line-height: var(--xa-lh-cap); white-space: nowrap;
}

.shortcuts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--xa-s-3); margin-top: var(--xa-s-4); }
.messages-page .xa-button.shortcut {
  display: flex; align-items: center; gap: var(--xa-s-3); min-width: 0;
  min-height: 108rpx; width: 100%; margin: 0; padding: 16rpx;
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-lg);
  background: var(--xa-color-surface-card); text-align: left; font-weight: 400;
  box-shadow: var(--xa-elev-1);
}
.shortcut > view:last-child { flex: 1; min-width: 0; }
.shortcut-icon, .announcement-icon {
  display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; flex-shrink: 0;
  border-radius: 18rpx; background: linear-gradient(150deg, #eef4ff, #dbeafe);
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, .09);
}
.shortcut-icon image, .announcement-icon image { width: 30rpx; height: 30rpx; }
.shortcut-title { display: block; font-size: var(--xa-fs-strong); font-weight: 600; line-height: var(--xa-lh-strong); white-space: nowrap; }
.shortcut-note { display: block; margin-top: 2rpx; font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted); }
.messages-page .xa-button.login-button { margin-top: var(--xa-s-4); }

.messages-page .xa-button.announcement-entry {
  display: flex; align-items: center; gap: var(--xa-s-3); width: 100%; min-height: 108rpx;
  margin: 0 0 var(--xa-s-4); padding: 16rpx; border: 1rpx solid var(--xa-hairline);
  border-radius: var(--xa-r-lg); background: var(--xa-color-surface-card);
  text-align: left; font-weight: 400; box-shadow: var(--xa-elev-1);
}
.announcement-icon { background: #f3f6fc; box-shadow: none; }
.announcement-copy { flex: 1; min-width: 0; }
.announcement-title { display: block; font-size: var(--xa-fs-strong); font-weight: 600; line-height: var(--xa-lh-strong); }
.announcement-note {
  display: block; margin-top: 2rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted);
}
.entry-arrow { width: 20rpx; height: 20rpx; flex-shrink: 0; opacity: .38; }

/* ── 分段控件 ─────────────────────────────────────────────── */
.message-panel { padding: 8rpx; margin-bottom: var(--xa-s-4); border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-lg); background: var(--xa-color-surface-card); box-shadow: var(--xa-elev-1); }
.message-segments { display: flex; gap: 4rpx; padding: 5rpx; border-radius: var(--xa-r-sm); background: #eef1f6; }
.message-segments .xa-button {
  display: flex; flex: 1; align-items: center; justify-content: center; gap: 8rpx; min-width: 0;
  min-height: 66rpx; margin: 0; padding: 6rpx 8rpx; border-radius: 8rpx;
  background: transparent; color: var(--xa-color-muted);
  font-size: var(--xa-fs-sub); font-weight: 600; line-height: 1.3;
  transition: background-color var(--xa-motion-base), color var(--xa-motion-base), box-shadow var(--xa-motion-base);
}
.message-segments .xa-button.active {
  color: var(--xa-color-text-primary); background: #fff;
  box-shadow: 0 1px 2px rgba(15, 23, 42, .06), 0 2px 8px -4px rgba(30, 58, 138, .16);
}
.segment-count {
  min-width: 32rpx; padding: 1rpx 8rpx; border-radius: var(--xa-r-pill);
  background: rgba(var(--xa-danger-rgb), .1); color: var(--xa-color-danger);
  font-size: var(--xa-fs-cap); line-height: 1.4; text-align: center;
}

.feed-filter-scroll, .filter-scroll { width: 100%; margin-top: 12rpx; padding: 0 8rpx 8rpx; white-space: nowrap; }
.feed-filter-scroll .chips, .filter-scroll .chips { display: inline-flex; flex-wrap: nowrap; gap: var(--xa-s-2); margin: 0; }
.feed-filter-scroll .xa-button.chip, .filter-scroll .xa-button.chip {
  min-height: 58rpx; height: 58rpx; margin: 0; padding: 0 22rpx;
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-pill);
  background: var(--xa-color-surface-card); font-size: var(--xa-fs-cap); line-height: 1.3;
}
.feed-filter-scroll .xa-button.chip-active, .filter-scroll .xa-button.chip-active {
  color: var(--xa-color-on-primary); border-color: transparent; background: var(--xa-color-primary);
  box-shadow: 0 8px 16px -10px rgba(37, 99, 235, .9);
}

.private-toolbar {
  display: flex; align-items: center; justify-content: space-between; gap: 12rpx;
  margin-top: 12rpx; padding: 0 8rpx; font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted);
}
.private-toolbar > text { min-width: 0; overflow-wrap: anywhere; }
.messages-page .private-toolbar .xa-button.mark-read {
  flex: 0 0 auto; width: auto; min-height: 56rpx; margin: 0; padding: 0 20rpx; border-radius: var(--xa-r-pill);
  background: rgba(37, 99, 235, .07); color: var(--xa-color-primary-hover);
  font-size: var(--xa-fs-cap); font-weight: 600; line-height: 1.3;
}
.messages-page .private-toolbar .xa-button.mark-read[disabled] { background: #f3f6fc; color: var(--xa-color-muted); }

/* ── 俱乐部动态 ───────────────────────────────────────────── */
.broadcast-card {
  display: flex; align-items: flex-start; gap: var(--xa-s-3); padding: 20rpx; margin-bottom: var(--xa-s-3);
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-lg);
  background: var(--xa-color-surface-card); box-shadow: var(--xa-elev-1);
}
.broadcast-symbol {
  display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; flex-shrink: 0;
  border-radius: 18rpx; background: linear-gradient(150deg, #eef4ff, #dbeafe);
}
.broadcast-symbol image { width: 30rpx; height: 30rpx; }
.broadcast-copy { flex: 1; min-width: 0; }
.broadcast-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4rpx 12rpx; }
.broadcast-label { font-size: var(--xa-fs-cap); font-weight: 600; line-height: var(--xa-lh-cap); color: var(--xa-color-primary); }
.broadcast-time { font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted); }
.broadcast-text { display: block; margin-top: 6rpx; font-size: var(--xa-fs-body); line-height: var(--xa-lh-body); overflow-wrap: anywhere; white-space: pre-wrap; }
.feed-end {
  display: block; padding: 14rpx; border-radius: var(--xa-r-md); background: rgba(255, 254, 250, .7);
  text-align: center; font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted);
}

/* ── 我的通知 ─────────────────────────────────────────────── */
.notice {
  position: relative; padding: 20rpx 22rpx; margin-bottom: 12px;
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-lg);
  background: var(--xa-color-surface-card);
  transition: transform var(--xa-press), background-color var(--xa-motion-fast);
}
.notice-unread { border-color: rgba(37, 99, 235, .2); background: rgba(37, 99, 235, .035); }
.notice-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.notice-labels { display: flex; flex-shrink: 0; align-items: center; gap: 8rpx; }
.notice-type {
  padding: 3rpx 12rpx; border-radius: var(--xa-r-pill); background: #f3f6fc;
  font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted);
}
/* 未读只用一个圆点表示；已读不画标记——默认状态不需要被说明 */
.notice-state { display: none; align-items: center; gap: 6rpx; white-space: nowrap; }
.notice-state.is-unread { display: flex; }
.notice-state text + text { display: none; }
.unread-dot { width: 10rpx; height: 10rpx; flex-shrink: 0; border-radius: 50%; background: var(--xa-color-primary); }
.notice-time { min-width: 0; font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted); text-align: right; }
.notice-title {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; margin-top: 10rpx; overflow: hidden;
  font-size: var(--xa-fs-strong); font-weight: 400; line-height: var(--xa-lh-strong);
  letter-spacing: -.2rpx; color: var(--xa-color-text-secondary); overflow-wrap: anywhere;
}
.notice-unread .notice-title { font-weight: 600; color: var(--xa-color-text-primary); }
.preview {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; margin-top: 6rpx; overflow: hidden;
  font-size: var(--xa-fs-sub); line-height: var(--xa-lh-body); color: var(--xa-color-muted); overflow-wrap: anywhere;
}

.list-actions { padding: 14rpx; margin-bottom: 0; border-radius: var(--xa-r-lg); }
.messages-page .list-actions .xa-button { min-height: 80rpx; margin: 0; padding: 0 24rpx; border-radius: var(--xa-r-pill); font-size: var(--xa-fs-sub); }
.more-error { display: block; padding: 8rpx 0 0; font-size: var(--xa-fs-cap); }
.message-guest { display: block; padding: var(--xa-s-5) 8rpx 8rpx; font-size: var(--xa-fs-sub); line-height: var(--xa-lh-body); text-align: center; color: var(--xa-color-muted); }

.notice-hover { transform: scale(.988); }
@media (prefers-reduced-motion: reduce) { .notice-hover { transform: none; } }
