.poster{width:100%;display:block;border-radius:18rpx;margin:24rpx 0}.rich{display:block;font-size:28rpx;line-height:1.85;color:var(--xa-color-text);overflow-wrap:anywhere}.content-page>.title{margin-bottom:16rpx}.content-page>.subtitle{margin-bottom:30rpx}.poster-page{padding:0 0 env(safe-area-inset-bottom)}.poster-page .poster{border-radius:0;margin:0}.content-list{background:#fffdf5;border:1rpx solid var(--xa-color-border);border-radius:24rpx;overflow:hidden}.page .xa-button.content-row{display:flex;align-items:center;gap:20rpx;width:100%;min-height:var(--xa-control-height);padding:24rpx;text-align:left;background:#fffdf5;border-bottom:1rpx solid var(--xa-color-border);border-radius:0;font-weight:400}.content-row:last-child{border-bottom:0}.content-mark{width:var(--xa-control-secondary);height:var(--xa-control-secondary);border-radius:16rpx;background:var(--xa-color-primary-soft);display:flex;align-items:center;justify-content:center;flex-shrink:0}.content-mark image{width:var(--xa-icon-medium);height:var(--xa-icon-medium)}.content-copy{flex:1;min-width:0}.content-name{font-size:var(--xa-control-font);font-weight:600;line-height:1.55;margin-bottom:8rpx}.content-arrow{flex-shrink:0;font-size:var(--xa-icon-medium);line-height:1;color:var(--xa-color-muted)}.content-page .xa-button.load-more{min-height:var(--xa-control-secondary);padding:8rpx 20rpx;margin:20rpx auto;font-size:var(--xa-control-small-font);border-radius:16rpx}.content-copy .small{font-size:var(--xa-control-small-font);line-height:1.5}
