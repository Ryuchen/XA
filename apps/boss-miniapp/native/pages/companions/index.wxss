@import "../../styles/companion-cards.wxss";
/* 陪玩列表 · 澄海 App 基线
   筛选收在一张卡里：搜索 → 游戏胶囊 → 两列条件 → 开关。
   条件控件把「标签 + 值」并到一行，省掉近半屏纵向空间，筛选区不再压住列表。 */

.companions { background: transparent; }

.companion-search-panel {
  --filter-height: 88rpx;
  padding: var(--xa-s-5) var(--xa-s-4) 0; margin-bottom: var(--xa-s-4);
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-2xl);
  background: var(--xa-color-surface-card); box-shadow: var(--xa-elev-1);
}
.companion-heading { margin-bottom: var(--xa-s-4); }
.companion-heading .title { font-size: var(--xa-fs-h1); letter-spacing: -1rpx; }
.companion-heading .subtitle { margin-top: 6rpx; }

.search-field {
  display: flex; align-items: center; gap: var(--xa-s-3); height: 84rpx;
  padding: 0 24rpx; border-radius: var(--xa-r-pill); background: #f3f6fc;
}
.search-field image { width: 30rpx; height: 30rpx; flex-shrink: 0; opacity: .5; }
.search-field .input {
  flex: 1; min-width: 0; height: 84rpx; padding: 0; border: 0; background: transparent;
  font-size: var(--xa-fs-body); box-shadow: none;
}

.game-filter-group { margin-top: var(--xa-s-5); }
.filter-group-label {
  display: block; margin-bottom: 12rpx; font-size: var(--xa-fs-cap); font-weight: 600;
  letter-spacing: 1rpx; color: var(--xa-color-muted);
}
.category-scroll { white-space: nowrap; }
.category-scroll .chips { display: inline-flex; flex-wrap: nowrap; gap: var(--xa-s-2); margin: 0; padding: 0 0 2rpx; }
.category-scroll .xa-button.game-filter-button {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  width: auto; height: 72rpx; min-height: 72rpx; margin: 0; padding: 0 24rpx;
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-pill);
  background: var(--xa-color-surface-card); color: var(--xa-color-text-secondary);
  font-size: var(--xa-fs-sub); font-weight: 600; line-height: 1.3;
  transition: background-color var(--xa-motion-fast), color var(--xa-motion-fast), transform var(--xa-press);
}
.category-scroll .game-icon { width: 26rpx; height: 26rpx; flex-shrink: 0; border-radius: 6rpx; }
.category-scroll .xa-button.game-filter-active {
  border-color: transparent; color: var(--xa-color-on-primary);
  background: var(--xa-color-primary); box-shadow: 0 8px 16px -10px rgba(37, 99, 235, .9);
}

/* 条件：标签与取值并排一行，控件高度回到 40px */
.filter-grid, .filter-tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--xa-s-2); margin-top: var(--xa-s-3); }
.filter-grid picker { min-width: 0; }
.filter-control {
  display: flex; align-items: center; justify-content: space-between; gap: 8rpx;
  width: 100%; height: var(--filter-height); min-height: var(--filter-height);
  padding: 0 20rpx; border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-sm);
  background: #f7f9fd; color: var(--xa-color-text);
}
.filter-control-copy {
  display: flex; flex: 1; min-width: 0; flex-direction: column; justify-content: center; gap: 2rpx;
}
.filter-caption {
  display: block; flex-shrink: 0; color: var(--xa-color-muted);
  font-size: var(--xa-fs-cap); line-height: 1.2; letter-spacing: 0;
}
.filter-value {
  display: block; min-width: 0; font-size: var(--xa-fs-sub); font-weight: 600; line-height: 1.25;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.filter-arrow { width: 22rpx; height: 22rpx; flex-shrink: 0; opacity: .38; transform: rotate(90deg); }
.filter-selected {
  border-color: rgba(37, 99, 235, .32); background: rgba(37, 99, 235, .06); color: var(--xa-color-primary-hover);
}
.filter-disabled { background: #f3f6fc; }
.filter-disabled .filter-arrow { opacity: .2; }
.filter-disabled .filter-value { color: var(--xa-color-muted); }

.filter-tools { margin-top: var(--xa-s-2); }
.filter-tools .xa-button.filter-control {
  display: flex; align-items: center; justify-content: space-between; box-sizing: border-box;
  width: 100%; height: var(--filter-height); min-height: var(--filter-height); margin: 0; padding: 0 20rpx;
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-sm);
  background: #f7f9fd; color: var(--xa-color-muted);
  font-size: var(--xa-fs-sub); font-weight: 500; line-height: 1.3;
}
.filter-tools .xa-button.filter-selected { border-color: rgba(37, 99, 235, .32); color: var(--xa-color-primary-hover); background: rgba(37, 99, 235, .06); }
.filter-toggle image { width: 26rpx; height: 26rpx; flex-shrink: 0; opacity: .6; }
.filter-toggle text { flex: 1; padding-left: 8rpx; text-align: left; white-space: nowrap; font-size: var(--xa-fs-sub); }
.filter-check {
  width: 32rpx; height: 32rpx; flex-shrink: 0; box-sizing: border-box;
  border: 1rpx solid var(--xa-hairline-strong); border-radius: var(--xa-r-pill); background: #fff;
  transition: background-color var(--xa-motion-fast);
}
.filter-check-active { border-color: transparent; background: var(--xa-color-primary); box-shadow: inset 0 0 0 6rpx #fff; }
.filter-tools .xa-button.filter-clear { justify-content: center; }
.filter-tools .xa-button.filter-clear[disabled] { color: var(--xa-color-muted); opacity: .45; }

.result-summary {
  display: flex; align-items: center; justify-content: space-between; gap: var(--xa-s-3);
  margin-top: var(--xa-s-4); padding: 18rpx 0; border-top: 1rpx solid var(--xa-hairline);
  font-size: var(--xa-fs-strong); font-weight: 600;
}
.result-summary .muted { font-weight: 400; }

.service-context .section-title { margin: 8rpx 0 var(--xa-s-4); }
.companion-guest { border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-2xl); box-shadow: var(--xa-elev-1); }
.companion-guest .guest-icon { width: 44rpx; height: 44rpx; margin-bottom: 12rpx; }
.companion-guest .muted { line-height: var(--xa-lh-body); }

/* 标签：一行放不下就省略，不换行撑高卡片 */
.companion-tags {
  display: flex; gap: 6rpx; width: auto; margin: 8rpx 20rpx 0;
  overflow: hidden; flex-wrap: nowrap;
}
.companion-tag {
  flex-shrink: 0; max-width: 100%; padding: 3rpx 12rpx; border-radius: var(--xa-r-pill);
  background: #f2f5fb; color: var(--xa-color-text-secondary);
  font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.companion-tag-highlighted { background: rgba(37, 99, 235, .09); color: var(--xa-color-primary-hover); font-weight: 600; }
