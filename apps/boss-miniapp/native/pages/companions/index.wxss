@import "../../styles/companion-cards.wxss";
/* 陪玩列表 · 澄海 2026
   筛选区收进一张悬浮卡：搜索胶囊、游戏胶囊、两列下拉。
   44px 触控高度与筛选逻辑保持不变。 */
.companions { background:transparent; }

.companion-search-panel {
  --filter-height:44px;
  padding:26rpx 24rpx 0; margin-bottom:24rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-2xl);
  background:var(--xa-color-surface-card); box-shadow:var(--xa-elev-1);
}
.companion-heading { margin-bottom:20rpx; }
.companion-heading .title { font-size:38rpx; letter-spacing:-1rpx; }
.companion-heading .subtitle { margin-top:6rpx; font-size:23rpx; }

.search-field {
  display:flex; align-items:center; gap:14rpx; height:var(--filter-height);
  padding:0 24rpx; border:1rpx solid transparent; border-radius:var(--xa-r-pill);
  background:#f3f6fc;
}
.search-field image { width:30rpx; height:30rpx; flex-shrink:0; opacity:.6; }
.search-field .input { flex:1; min-width:0; height:var(--filter-height); padding:0; border:0; background:transparent; font-size:28rpx; box-shadow:none; }

.game-filter-group { margin-top:22rpx; }
.filter-group-label { display:block; margin-bottom:12rpx; font-size:22rpx; font-weight:600; letter-spacing:1rpx; color:var(--xa-color-muted); }
.category-scroll { white-space:nowrap; }
.category-scroll .chips { display:inline-flex; flex-wrap:nowrap; gap:12rpx; margin:0; padding:0 0 2rpx; }
.category-scroll .xa-button.game-filter-button {
  display:flex; align-items:center; justify-content:center; gap:10rpx;
  width:auto; height:72rpx; min-height:72rpx; margin:0; padding:0 24rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-pill);
  background:var(--xa-color-surface-card); color:var(--xa-color-text-secondary);
  font-size:26rpx; font-weight:600; line-height:1.3;
}
.category-scroll .game-icon { width:26rpx; height:26rpx; flex-shrink:0; border-radius:6rpx; }
.category-scroll .xa-button.game-filter-active {
  border-color:transparent; color:var(--xa-color-on-primary);
  background:var(--xa-color-primary); box-shadow:0 8px 16px -10px rgba(37,99,235,.9);
}

.filter-grid, .filter-tools { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; margin-top:16rpx; }
.filter-grid picker { min-width:0; }
.filter-control {
  display:flex; align-items:center; justify-content:space-between; gap:12rpx;
  width:100%; height:var(--filter-height); min-height:var(--filter-height);
  padding:5px 22rpx; border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-md);
  background:#f7f9fd; color:var(--xa-color-text);
}
.filter-control-copy { display:flex; flex:1; flex-direction:column; justify-content:center; min-width:0; }
.filter-caption { display:block; color:var(--xa-color-muted); font-size:10px; line-height:14px; letter-spacing:.4rpx; }
.filter-value { display:block; font-size:26rpx; font-weight:600; line-height:1.35; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.filter-arrow { width:24rpx; height:24rpx; flex-shrink:0; opacity:.5; transform:rotate(90deg); }
.filter-selected {
  border-color:rgba(37,99,235,.4); background:rgba(37,99,235,.07); color:var(--xa-color-primary-hover);
  box-shadow:inset 0 0 0 1rpx rgba(37,99,235,.16);
}
.filter-disabled { background:#f3f6fc; }
.filter-disabled .filter-arrow { opacity:.3; }
.filter-disabled .filter-value { color:var(--xa-color-muted); }

.filter-tools { margin-top:12rpx; }
.filter-tools .xa-button.filter-control {
  display:flex; align-items:center; justify-content:space-between; box-sizing:border-box;
  width:100%; height:var(--filter-height); min-height:var(--filter-height); margin:0; padding:0 22rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-md);
  background:#f7f9fd; color:var(--xa-color-muted); font-size:26rpx; font-weight:500; line-height:1.3;
}
.filter-tools .xa-button.filter-selected { border-color:rgba(37,99,235,.4); color:var(--xa-color-primary-hover); background:rgba(37,99,235,.07); }
.filter-toggle image { width:26rpx; height:26rpx; flex-shrink:0; opacity:.75; }
.filter-toggle text { flex:1; text-align:left; white-space:nowrap; font-size:24rpx; }
.filter-check { width:32rpx; height:32rpx; flex-shrink:0; border:1rpx solid var(--xa-hairline-strong); border-radius:var(--xa-r-pill); background:#fff; }
.filter-check-active { border-color:transparent; background:var(--xa-color-primary); box-shadow:inset 0 0 0 6rpx #fff; }
.filter-tools .xa-button.filter-clear { justify-content:center; }
.filter-tools .xa-button.filter-clear[disabled] { color:var(--xa-color-muted); opacity:.5; }

.result-summary {
  display:flex; align-items:center; justify-content:space-between; gap:12rpx;
  margin-top:20rpx; padding:18rpx 0; border-top:1rpx solid var(--xa-hairline);
  font-size:26rpx; font-weight:600;
}
.result-summary .muted { font-size:22rpx; font-weight:400; }

.service-context .section-title { margin:8rpx 0 20rpx; }
.companion-guest { border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-2xl); box-shadow:var(--xa-elev-1); }
.companion-guest .guest-icon { width:44rpx; height:44rpx; margin-bottom:14rpx; }
.companion-guest .muted { font-size:26rpx; line-height:1.7; }

.companion-tags { display:flex; flex-wrap:wrap; gap:8rpx; width:100%; margin-top:8rpx; }
.companion-tag { max-width:100%; padding:4rpx 12rpx; border-radius:var(--xa-r-pill); background:#f3f6fc; color:var(--xa-color-text-secondary); font-size:20rpx; overflow-wrap:anywhere; }
.companion-tag-highlighted { background:rgba(37,99,235,.1); color:var(--xa-color-primary-hover); font-weight:600; }
