@import "../../styles/companion-cards.wxss";
.companions { background: var(--xa-color-page); }
/* Shared native filter geometry: 44px controls, two equal columns, club palette. */
.companion-search-panel { --filter-height:44px; padding:28rpx 24rpx 0; margin-bottom:24rpx; border:1rpx solid var(--xa-color-border); border-radius:24rpx; background:var(--xa-color-surface); }
.companion-heading { margin-bottom:20rpx; }
.companion-heading .title { font-size:34rpx; letter-spacing:0; }
.companion-heading .subtitle { margin-top:6rpx; font-size:24rpx; }
.search-field { display:flex; align-items:center; gap:12rpx; height:var(--filter-height); padding:0 20rpx; border:1rpx solid transparent; border-radius:16rpx; background:var(--xa-color-primary-soft); }
.search-field image { width:var(--xa-icon-small); height:var(--xa-icon-small); flex-shrink:0; }
.search-field .input { flex:1; min-width:0; height:var(--filter-height); padding:0; border:0; background:transparent; font-size:var(--xa-control-font); }
.game-filter-group { margin-top:20rpx; }
.filter-group-label { display:block; margin-bottom:10rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); }
.category-scroll { white-space:nowrap; }
.category-scroll .chips { display:inline-flex; flex-wrap:nowrap; margin:0; padding:0 0 2rpx; gap:16rpx; }
.category-scroll .xa-button.game-filter-button { display:flex; align-items:center; justify-content:center; gap:10rpx; width:auto; height:var(--filter-height); min-height:var(--filter-height); margin:0; padding:0 20rpx; border:1rpx solid var(--xa-color-border); border-radius:16rpx; background:var(--xa-color-surface); color:var(--xa-color-text); font-size:var(--xa-control-font); line-height:1.3; font-weight:500; }
.category-scroll .game-icon { width:var(--xa-icon-small); height:var(--xa-icon-small); flex-shrink:0; border-radius:4rpx; }
.category-scroll .xa-button.game-filter-active { border-color:var(--xa-color-primary); color:var(--xa-color-primary); background:var(--xa-color-primary-soft); }
.filter-grid,.filter-tools { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; margin-top:20rpx; }
.filter-grid picker { min-width:0; }
.filter-control { display:flex; align-items:center; justify-content:space-between; gap:12rpx; width:100%; height:var(--filter-height); min-height:var(--filter-height); padding:5px 20rpx; border:1rpx solid var(--xa-color-border); border-radius:16rpx; background:var(--xa-color-surface); color:var(--xa-color-text); }
.filter-control-copy { display:flex; flex:1; flex-direction:column; justify-content:center; min-width:0; }
.filter-caption { display:block; color:var(--xa-color-muted); font-size:10px; line-height:14px; }
.filter-value { display:block; font-size:var(--xa-control-font); font-weight:500; line-height:18px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.filter-arrow { width:var(--xa-icon-small); height:var(--xa-icon-small); flex-shrink:0; transform:rotate(90deg); }
.filter-selected { border-color:var(--xa-color-primary); background:var(--xa-color-primary-soft); color:var(--xa-color-primary); }
.filter-disabled { background:var(--xa-color-primary-soft); }
.filter-disabled .filter-arrow { opacity:.35; }
.filter-disabled .filter-value { color:var(--xa-color-muted); }
.filter-tools { margin-top:16rpx; }
.filter-tools .xa-button.filter-control { display:flex; align-items:center; justify-content:space-between; padding:0 20rpx; box-sizing:border-box; width:100%; height:var(--filter-height); min-height:var(--filter-height); margin:0; border:1rpx solid var(--xa-color-border); border-radius:16rpx; font-size:var(--xa-control-font); font-weight:500; line-height:1.3; background:var(--xa-color-surface); color:var(--xa-color-muted); }
.filter-tools .xa-button.filter-selected { border-color:var(--xa-color-primary); color:var(--xa-color-primary); background:var(--xa-color-primary-soft); }
.filter-toggle image { width:var(--xa-icon-small); height:var(--xa-icon-small); flex-shrink:0; }
.filter-toggle text { flex:1; text-align:left; white-space:nowrap; font-size:var(--xa-control-small-font); }
.filter-check { width:12px; height:12px; border:1rpx solid var(--xa-color-border); border-radius:4px; background:var(--xa-color-surface); flex-shrink:0; }
.filter-check-active { border-color:var(--xa-color-primary); background:var(--xa-color-primary); box-shadow:inset 0 0 0 2px var(--xa-color-primary-soft); }
.filter-tools .xa-button.filter-clear { justify-content:center; }
.filter-tools .xa-button.filter-clear[disabled] { color:var(--xa-color-muted); opacity:.55; }
.result-summary { display:flex; align-items:center; justify-content:space-between; gap:12rpx; border-top:1rpx solid var(--xa-color-border); margin-top:20rpx; padding:18rpx 0; font-size:24rpx; font-weight:600; }
.result-summary .muted { font-size:22rpx; font-weight:400; }
.service-context .section-title { margin: 8rpx 0 20rpx; }
.companion-guest .guest-icon { width: 44rpx; height: 44rpx; margin-bottom: 14rpx; }
.companion-guest .muted { font-size: 26rpx; line-height: 1.7; }
