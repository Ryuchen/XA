.lottery-page { text-align:left; }
.points-value { color:#00278d;font-weight:700;font-size:34rpx;font-variant-numeric:tabular-nums; }
.lottery-page>.between { margin-top:12rpx;gap:16rpx; }
.lottery-page>.between>.muted { flex:1;min-width:0;font-size:var(--xa-control-font); }
.lottery-page .between .xa-button.button-quiet { display:flex;align-items:center;justify-content:center;flex-shrink:0;min-height:var(--xa-control-secondary);padding:8rpx;font-size:var(--xa-control-font);white-space:nowrap; }
.wheel-wrap { position:relative;margin:40rpx auto; }
.wheel-rotation { width:100%;height:100%;transition:transform 2.8s cubic-bezier(.12,.8,.16,1);transform-origin:50% 50%; }
.wheel { display:block; }
.pointer { position:absolute;left:50%;top:-4px;margin-left:-10px;border-left:10px solid transparent;border-right:10px solid transparent;border-top:27px solid #002fa7;z-index:3; }
.lottery-page .xa-button.spin-button { position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;width:max(176rpx,88px);height:max(176rpx,88px);min-width:0;padding:12rpx;border-radius:50%;background:#00278d;color:#fffdf5;box-shadow:0 0 0 8rpx #fffdf5;font-size:var(--xa-control-font);line-height:1.5;z-index:2; }
.spin-cost { font-size:var(--xa-control-small-font);font-weight:400;opacity:.9; }
.lottery-page .xa-button.spin-button[disabled] { background:#f7f4ec;color:#002fa7;border:2rpx solid #657188; }
.centered { margin:24rpx 0;text-align:center;font-size:var(--xa-control-font); }
.result { text-align:center;background:#f7f4ec; }
.result .section-title { display:block;margin:16rpx 0 24rpx; }
.lottery-page .result .xa-button.button { display:flex;align-items:center;justify-content:center;min-height:var(--xa-control-height);padding:12rpx 24rpx;border-radius:var(--xa-radius-control);font-size:var(--xa-control-font); }
.prize-row { display:flex;justify-content:space-between;gap:16rpx;padding:18rpx 0;border-bottom:1rpx solid #f7f4ec;font-size:var(--xa-control-font); }
.prize-row>text:first-child { flex:1;min-width:0;overflow-wrap:anywhere; }
.prize-row>text:last-child { flex-shrink:0; }
.lottery-page .small { font-size:var(--xa-control-small-font); }
.rules { white-space:pre-wrap;line-height:1.8;font-size:var(--xa-control-font);color:#657188; }
@media (prefers-reduced-motion:reduce) { .wheel-rotation { transition:none; } }
