<view class="page lottery-page"><text class="eyebrow">兴安俱乐部 · 积分好礼</text><text class="title">{{campaign.name || '幸运转盘'}}</text><view class="between"><text class="muted">我的积分 <text class="points-value">{{points}}</text></text><button class="xa-button button-quiet" bindtap="records">中奖记录 ›</button></view><state-view wx:if="{{loading || error}}" loading="{{loading}}" error="{{error}}" bind:retry="load"/><block wx:if="{{campaign && !loading}}"><view class="wheel-wrap" style="width:{{size}}px;height:{{size}}px"><view class="pointer"></view><view class="wheel-rotation" style="transform:rotate({{rotation}}deg)"><canvas canvas-id="wheel" class="wheel" style="width:{{size}}px;height:{{size}}px"/></view><button class="xa-button spin-button" bindtap="spin" disabled="{{busy || !campaign.enabled}}"><text>{{busy ? '好运揭晓中' : campaign.enabled ? '抽一次' : '即将开启'}}</text><text class="spin-cost">{{campaign.point_cost}} 积分</text></button></view><view wx:if="{{!campaign.enabled}}" class="muted centered">奖池准备中，开放后即可参与</view><view wx:if="{{result}}" class="panel result"><text class="small">本次获得</text><text class="section-title">{{result.name_snapshot}}</text><button class="xa-button button" bindtap="claim">{{result.status === 'COMPLETED' ? '查看奖励记录' : '查看并领取奖品'}}</button></view><view class="panel"><text class="section-title">本期奖池</text><view class="prize-row" wx:for="{{campaign.prizes}}" wx:key="id"><text>{{item.name}}</text><text class="muted small">{{item.probability / 100}}%</text></view><text class="subtitle small">转盘分区仅用于展示，实际中奖概率以以上公示为准。</text></view><view class="panel" wx:if="{{campaign.rules}}"><text class="section-title">参与说明</text><text class="rules">{{campaign.rules}}</text></view></block></view>
