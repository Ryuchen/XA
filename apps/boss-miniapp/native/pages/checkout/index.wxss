.checkout { padding-bottom: calc(var(--xa-navigation-inset) + 108px); }
.checkout-header { padding: 24rpx; margin-bottom: 24rpx; border: 1rpx solid var(--xa-hairline); border-radius: 24rpx; background: var(--xa-color-surface); }
.checkout-header .title { font-size: 20px; }
.checkout-header .subtitle { margin-top: 8rpx; font-size: var(--xa-control-small-font); line-height: 1.5; }
/* 三步进度：三段轨道，已完成/当前/待办用饱和度区分，不靠数字说话 */
.checkout-steps {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--xa-s-2);
  padding-top: 0; margin-top: var(--xa-s-4); border-top: 0;
  color: var(--xa-color-muted); font-size: var(--xa-fs-cap); line-height: 1.4;
}
.checkout-steps > text { position: relative; min-width: 0; padding-top: var(--xa-s-3); text-align: left; overflow-wrap: anywhere; }
.checkout-steps > text::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4rpx;
  border-radius: 2rpx; background: var(--xa-hairline-strong);
}
.checkout-steps > text:first-child::before { background: rgba(37, 99, 235, .34); }
.checkout-steps .current { color: var(--xa-color-primary); font-weight: 600; }
.checkout-steps .current::before { background: var(--xa-color-primary); }
.checkout .panel { padding: 24rpx; margin: 0 0 24rpx; border-radius: 24rpx; }
.checkout .panel > .section-title, .checkout .section-heading { margin: 0 0 24rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid var(--xa-hairline); }
.checkout .section-title { font-size:15px; line-height: 1.5; }
.section-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx 16rpx; }
.checkout .section-heading .section-title { margin: 0; }
.section-note { color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.5; }
.service-summary { display: flex; align-items: flex-start; gap: 24rpx; }
.service-cover { width: 176rpx; height: 99rpx; border-radius: 12rpx; flex-shrink: 0; background: var(--xa-color-surface-subtle); }
.service-content { flex: 1; min-width: 0; }
.service-name { display: block; font-size: var(--xa-control-font); font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.service-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; margin-top: 8rpx; }
.service-tag { padding: 0 8rpx; border-radius: 8rpx; background: var(--xa-color-primary-soft); color: var(--xa-color-primary); font-size: var(--xa-control-small-font); line-height: 1.5; }
.service-requirement { color: var(--xa-color-muted); font-size: var(--xa-control-small-font); overflow-wrap: anywhere; }
.service-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx; margin-top: 8rpx; }
.checkout .service-price .price { font-size:17px; }
.price-unit { color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.5; }
.row-label { flex-shrink: 0; font-size: var(--xa-control-font); font-weight: 400; line-height: 1.5; }
.setting-group { display: block; border-top: 1rpx solid var(--xa-hairline); }
.setting-row, .quantity-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 44px; padding: 16rpx 0; }
.row-value { display: flex; flex: 1; align-items: center; justify-content: flex-end; gap: 8rpx; min-width: 0; color: var(--xa-color-muted); font-size: var(--xa-control-font); font-weight: 400; line-height: 1.5; text-align: right; }
.row-value > text { min-width: 0; overflow-wrap: anywhere; }
.row-chevron { width: 12px; height: 12px; flex-shrink: 0; }
.quantity-row { padding-top: 0; }
.quantity-control {
  display: flex; align-items: center; gap: var(--xa-s-1);
  height: var(--xa-input-height); padding: 0 var(--xa-s-3);
  border: 1rpx solid var(--xa-hairline-strong); border-radius: var(--xa-radius-control);
  background: var(--xa-color-surface-card);
}
.checkout .quantity-input {
  width: 56px; height: auto; min-height: 0; padding: 0; text-align: center;
  background: transparent; border: 0; border-radius: 0;
  font-size: var(--xa-fs-title); font-weight: 600; font-variant-numeric: tabular-nums;
}
.quantity-unit { max-width: none; color: var(--xa-color-muted); font-size: var(--xa-fs-sub); white-space: nowrap; }
.field-hint { display: block; padding: 0 0 16rpx; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.5; overflow-wrap: anywhere; }
.dispatch-routes { padding-top: 16rpx; }
.dispatch-routes-label { display: block; margin-bottom: 16rpx; font-size: var(--xa-control-font); line-height: 1.5; }
.checkout .xa-button.route-option { display: flex; flex-direction: column; align-items: flex-start; width: 100%; min-height: 44px; margin: 0 0 16rpx; padding: 16rpx; border: 1rpx solid var(--xa-hairline); border-radius: 12rpx; background: var(--xa-color-surface); color: var(--xa-color-text); text-align: left; white-space: normal; line-height: 1.5; }
.checkout .xa-button.route-selected { border-color: var(--xa-color-primary); background: var(--xa-color-primary-soft); }
.route-title { font-size: var(--xa-control-font); font-weight: 600; }
.route-description { margin-top: 8rpx; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); }
.selected-route-hint { padding-top: 16rpx; }
.pending-order-panel .field-hint { padding-top: 8rpx; }
.pending-order-actions { display: flex; flex-wrap: wrap; gap: 16rpx; }
.pending-order-actions .xa-button { flex: 1 1 auto; min-height: 44px; margin: 0; }
.checkout .arrangement-error { padding-top: 0; }
.checkout .xa-button.provider-select { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; width: 100%; min-height: 44px; margin: 0; padding: 16rpx; border-radius: 12rpx; background: var(--xa-color-primary-soft); color: var(--xa-color-text); text-align: left; white-space: normal; }
.provider-select .row-value { color: var(--xa-color-primary); }
.checkout .xa-button.provider-selected { border: 1rpx solid var(--xa-color-primary); }
.selected-provider-list { display: flex; flex: 1; flex-direction: column; gap: 16rpx; min-width: 0; }
.selected-provider { display: flex; flex: 1; align-items: center; gap: 16rpx; min-width: 0; }
.selected-provider-avatar { width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%; }
.selected-provider-initial { display: flex; align-items: center; justify-content: center; background: var(--xa-color-surface); color: var(--xa-color-primary); font-size:17px; font-weight: 600; }
.selected-provider-info { display: flex; flex: 1; flex-direction: column; gap: 8rpx; min-width: 0; }
.selected-provider-label { color: var(--xa-color-primary); font-size: var(--xa-control-small-font); font-weight: 400; line-height: 1.5; }
.selected-provider-name { color: var(--xa-color-text); font-size: var(--xa-control-font); font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.provider-select .provider-select-action { flex: 0 0 auto; white-space: nowrap; font-size: var(--xa-control-small-font); }
.selection-hint { padding: 16rpx 0 0; }
.selection-incomplete { color: var(--xa-color-danger); }
.shortcut-loading { padding: 24rpx 0 0; }
.shortcut-group { margin-top: 24rpx; }
.shortcut-heading { display: block; margin-bottom: 16rpx; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); font-weight: 500; }
.shortcut-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16rpx; }
.checkout .xa-button.shortcut-card { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 16rpx 8rpx; margin: 0; border: 1rpx solid var(--xa-hairline); border-radius: 12rpx; background: var(--xa-color-surface); color: var(--xa-color-text); line-height: 1.5; }
.checkout .xa-button.shortcut-selected { border-color: var(--xa-color-primary); background: var(--xa-color-primary-soft); }
.checkout .xa-button.route-option, .checkout .xa-button.shortcut-card, .checkout .selection-hint { transition: background-color var(--xa-motion-fast), border-color var(--xa-motion-fast), box-shadow var(--xa-motion-fast), color var(--xa-motion-fast), transform var(--xa-motion-fast); }
.shortcut-status { transition: color var(--xa-motion-fast); }
.shortcut-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; }
.shortcut-initial { display: flex; align-items: center; justify-content: center; background: var(--xa-color-primary-soft); color: var(--xa-color-primary); }
.shortcut-name { width: 100%; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; font-size: var(--xa-control-small-font); font-weight: 500; }
.shortcut-status { color: var(--xa-color-muted); font-size: var(--xa-control-small-font); font-weight: 400; }
.shortcut-selected .shortcut-status { color: var(--xa-color-primary); }
.shortcut-unavailable { opacity: .6; }
.checkout .xa-button.provider-select[disabled], .checkout .xa-button.shortcut-card[disabled] { background: var(--xa-color-surface-subtle); color: var(--xa-color-muted); }
.empty-hint { display: block; padding: 16rpx; border-radius: 12rpx; background: var(--xa-color-surface-subtle); color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.5; }
.game-fields { display: flex; flex-direction: column; gap: 32rpx; }
.checkout .game-fields .field { margin: 0; }
.checkout .label { margin-bottom: 8rpx; font-size: var(--xa-control-font); }
.required { color: var(--xa-color-primary); }
.checkout .input { min-height: var(--xa-input-height); border-radius: 12rpx; border-color: var(--xa-color-surface-subtle); background: var(--xa-color-surface-subtle); font-size: var(--xa-control-font); }
.checkout input.input { height: var(--xa-input-height); }
.checkout .input:focus { border-color: var(--xa-color-primary); }
.checkout textarea.input { height: 80px; padding: 16rpx; }
.coupon-picker { display: block; }
.quote-recovery { display: flex; flex-direction: column; gap: 8rpx; }
.coupon-picker .setting-row { padding-top: 0; padding-bottom: 16rpx; }
.fee-breakdown { padding: 16rpx 0; border-top: 1rpx solid var(--xa-hairline); }
.fee-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; padding: 8rpx 0; font-size: var(--xa-control-font); line-height: 1.5; }
.fee-row > text:first-child { flex-shrink: 0; }
.fee-row > text:last-child { min-width: 0; text-align: right; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.discount { color: var(--xa-color-primary); }
.total-row { padding: 16rpx 0; border-top: 1rpx solid var(--xa-hairline); font-weight: 600; }
.total-value { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: flex-end; gap: 8rpx; min-width: 0; }
.checkout .total-value .price { font-size: 20px; }
.balance-summary { padding: 16rpx; border-radius: 12rpx; background: var(--xa-color-surface-subtle); color: var(--xa-color-muted); }
.balance-summary .fee-row { padding: 0; font-size: var(--xa-control-small-font); }
.balance-warning { display: block; margin-top: 8rpx; color: var(--xa-color-danger); font-size: var(--xa-control-small-font); line-height: 1.5; }
.quote-loading { display: block; padding: 16rpx 0 0; border-top: 1rpx solid var(--xa-hairline); color: var(--xa-color-muted); font-size: var(--xa-control-small-font); }
.checkout .xa-button.recharge-button { min-height: 44px; }
.checkout-payment { padding: 8px 24rpx 8px; background: var(--xa-color-surface); background: rgba(255, 254, 250, .94); backdrop-filter: blur(16px); }
.payment-actions { display: grid; grid-template-columns: minmax(0, 1fr) 108px; align-items: center; gap: 12px; }
.payable-summary { display: flex; align-items: baseline; gap: 4px; min-width: 0; white-space: nowrap; }
.payable-label { flex-shrink: 0; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.4; }
.payable-value { display: flex; flex-wrap: nowrap; align-items: baseline; gap: 8rpx; min-width: 0; }
.payable-amount { color: var(--xa-color-primary); font-size:17px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.2; white-space: nowrap; }
.payable-unit { color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.5; }
.payable-pending { color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.5; }
.checkout-payment .xa-button.submit-order { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; min-height: 44px; margin: 0; padding: 8px; border-radius: 12rpx; font-size: var(--xa-control-small-font); font-weight: 600; line-height: 1.3; }
.checkout-payment .xa-button.submit-order[disabled] { background: var(--xa-color-surface-subtle); color: var(--xa-color-muted); }
.payment-status { display: block; margin-top: 4px; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); line-height: 1.5; overflow-wrap: anywhere; }
.payment-warning { color: var(--xa-color-danger); }
.coupon-unused { display:block; margin-top:8rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; }
.provider-unavailable { color:var(--xa-color-danger); font-size:var(--xa-control-small-font); line-height:1.5; overflow-wrap:anywhere; }
@media (prefers-reduced-motion: reduce) { .checkout .xa-button.route-option, .checkout .xa-button.shortcut-card, .checkout .selection-hint, .shortcut-status { transition:none; } }

/* 帮助入口原本是一整行蓝色，抢在「优惠与支付」标题前面；
   收到面板右上角，和标题同一行，不占内容高度 */
.payment-panel { position: relative; }
.payment-panel .help-trigger {
  position: absolute; top: 0; right: 0; width: auto; min-height: 44px;
  margin: 0; padding: 0 var(--xa-s-4); gap: var(--xa-s-1);
  align-items: center; justify-content: flex-end;
  font-size: var(--xa-fs-cap); line-height: 1.4; color: var(--xa-color-muted);
}
/* 表单底色从重灰块换成浅底 + 细边，四个字段不再像四块混凝土 */
.checkout .input {
  min-height: var(--xa-input-height); border-radius: var(--xa-radius-control);
  border: 1rpx solid var(--xa-hairline-strong); background: var(--xa-color-surface-card);
  font-size: var(--xa-fs-body);
}
.checkout input.input { height: var(--xa-input-height); padding: 0 var(--xa-s-3); }
.checkout textarea.input { height: 88px; padding: var(--xa-s-3); line-height: 1.6; }
