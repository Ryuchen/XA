<view class="page checkout"><view class="checkout-header"><text class="title">确认订单</text><text class="subtitle">核对服务信息，使用余额完成支付</text><view class="checkout-steps"><text>1 选择服务</text><text class="current">2 确认与支付</text><text>3 开始服务</text></view></view><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后下单</button><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<block wx:if="{{service && !loading && !error}}"><view class="panel row checkout-service"><image wx:if="{{service.cover}}" class="service-cover" src="{{service.cover}}" mode="aspectFit"/><view><text class="section-title">{{service.name}}</text><view wx:if="{{service.provider_requirement.label}}" class="small muted">{{service.provider_requirement.label}}</view><text class="price">{{service.priceText}}</text><text class="small muted"> 兴安币 / {{ service.price_unit || '份' }}</text></view></view>
<view class="panel arrangement-panel"><text class="section-title">服务安排</text><text wx:if="{{trafficMode}}" class="small muted">当前{{trafficMode}}时段</text><text wx:if="{{!selfOrderEnabled}}" class="error">自主下单暂时关闭，请联系客服</text><picker wx:if="{{!provider}}" range="{{dispatchModes}}" value="{{dispatchIndex}}" bindchange="dispatch" disabled="{{submitting}}"><view class="menu-row"><text>接单方式</text><text class="muted">{{dispatchModes[dispatchIndex]}} ›</text></view></picker><text wx:if="{{!provider}}" class="small muted">{{dispatchIndex === 1 ? '合格陪玩抢到后直接接单' : '陪玩申请后，由你在订单详情选择'}}</text><view class="field"><text class="label">购买数量</text><input class="input" type="number" value="{{rounds}}" data-field="rounds" disabled="{{submitting || !!service.experience_kind || service.gameplay_kind === 'ROULETTE'}}" bindinput="input" maxlength="2"/></view><picker wx:if="{{service.service_type === 'COMPANION'}}" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="gender" disabled="{{submitting}}"><view class="menu-row"><text>男陪 / 女陪</text><text class="muted">{{genderOptions[genderIndex]}} ›</text></view></picker><view class="menu-row" bindtap="chooseProvider"><text>指定陪玩</text><text class="muted">{{provider ? provider.nickname : '平台安排'}} ›</text></view><picker range="{{contacts}}" range-key="name" value="{{contactIndex}}" bindchange="contact" disabled="{{submitting}}"><view class="menu-row"><text>对接客服</text><text class="muted">{{contacts[contactIndex].name}} ›</text></view></picker></view>
<view class="panel companion-shortcuts"><text class="section-title">挑选陪玩</text><text wx:if="{{shortcutsLoading}}" class="small muted">正在加载陪玩</text><block wx:else><view class="shortcut-heading">最近点过</view><view class="shortcut-grid"><button wx:for="{{recent}}" wx:key="id" class="xa-button shortcut-card {{provider.id === item.id ? 'shortcut-selected' : ''}} {{!item.can_order ? 'shortcut-unavailable' : ''}}" data-id="{{item.id}}" bindtap="selectShortcut" disabled="{{submitting || !item.can_order}}" hover-class="xa-button-hover"><image wx:if="{{item.avatarUrl}}" class="shortcut-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="shortcut-avatar shortcut-initial">{{item.initial}}</view><text class="shortcut-name">{{item.nickname}}</text><text class="small muted">{{item.can_order ? (item.genderText || '陪玩') : '暂不可接'}}</text></button></view><text wx:if="{{!recent.length}}" class="small muted">暂无符合当前选择的下单记录</text><view class="shortcut-heading">推荐陪玩</view><view class="shortcut-grid"><button wx:for="{{recommended}}" wx:key="id" class="xa-button shortcut-card {{provider.id === item.id ? 'shortcut-selected' : ''}} {{!item.can_order ? 'shortcut-unavailable' : ''}}" data-id="{{item.id}}" bindtap="selectShortcut" disabled="{{submitting || !item.can_order}}" hover-class="xa-button-hover"><image wx:if="{{item.avatarUrl}}" class="shortcut-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="shortcut-avatar shortcut-initial">{{item.initial}}</view><text class="shortcut-name">{{item.nickname}}</text><text class="small muted">{{item.can_order ? (item.genderText || '陪玩') : '暂不可接'}}</text></button></view><text wx:if="{{!recommended.length}}" class="small muted">暂无符合当前选择的推荐陪玩</text></block><view wx:if="{{shortcutsError}}"><text class="error">{{shortcutsError}}</text><button class="xa-button button-secondary" bindtap="loadShortcuts">重新加载</button></view></view>
<view class="panel game-info-panel"><text class="section-title">游戏信息</text><view class="field"><text class="label">游戏大区 *</text><input class="input" value="{{region}}" data-field="region" maxlength="50" bindinput="input" disabled="{{submitting}}" placeholder="微信区 / QQ区 / 国服"/></view><view class="field"><text class="label">游戏昵称 *</text><input class="input" value="{{nickname}}" data-field="nickname" maxlength="50" bindinput="input" disabled="{{submitting}}" placeholder="填写本次游戏昵称"/></view><view class="field"><text class="label">游戏 UID</text><input class="input" value="{{uid}}" data-field="uid" maxlength="50" bindinput="input" disabled="{{submitting}}" placeholder="便于陪玩找到你"/></view><view class="field"><text class="label">服务备注</text><textarea class="input" value="{{remark}}" data-field="remark" maxlength="255" bindinput="input" disabled="{{submitting}}" placeholder="说明你的偏好与需求"/></view></view>
<view class="panel payment-panel"><text class="section-title">优惠与支付</text><picker range="{{coupons}}" range-key="name" value="{{couponIndex}}" bindchange="coupon" disabled="{{submitting}}"><view class="menu-row"><text>{{service.experience_kind ? '套餐资格' : '优惠券'}}</text><text class="muted">{{coupons[couponIndex].name}} ›</text></view></picker><text wx:if="{{quoting}}" class="loading">正在获取最新报价</text><block wx:if="{{quote}}"><view class="between"><text class="muted">原价</text><text>{{quote.originalText}} 兴安币</text></view><view wx:if="{{quote.boss_discount}}" class="between"><text class="muted">会员优惠</text><text>-{{quote.bossText}}</text></view><view wx:if="{{quote.promo_discount}}" class="between"><text class="muted">活动优惠</text><text>-{{quote.promotionText}}</text></view><view wx:if="{{quote.coupon_discount}}" class="between"><text class="muted">优惠券抵扣</text><text>-{{quote.couponText}}</text></view><view class="divider"></view><view class="between"><text>实付</text><text class="price">{{quote.amountText}} <text class="small">兴安币</text></text></view><text class="subtitle small">可用余额 {{quote.balanceText}} 兴安币</text><button wx:if="{{!quote.balance_sufficient}}" class="xa-button button-secondary" bindtap="recharge" hover-class="xa-button-hover">余额不足，联系客服充值</button></block><text wx:if="{{quoteError}}" class="error">{{quoteError}}</text><button wx:if="{{quoteError}}" class="xa-button button-secondary" bindtap="refreshQuote" disabled="{{submitting}}" hover-class="xa-button-hover">刷新报价</button></view>
<view class="bottom-bar"><button class="xa-button button" loading="{{submitting}}" disabled="{{submitting || quoting || !quote || !quote.balance_sufficient || !selfOrderEnabled}}" bindtap="submit" hover-class="xa-button-hover">{{submitting ? '正在处理，请勿重复支付' : '确认并支付 ' + (quote.amountText || '') + ' 兴安币'}}</button></view></block></view>
