<view class="page reservation-detail"><view class="panel"><view class="title">预约详情</view><view class="subtitle">{{reservation.statusText}}</view></view>
  <view wx:if="{{!logged}}" class="panel"><button class="xa-button button" bindtap="login">登录后查看</button></view>
  <state-view wx:else loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{logged && !loading && !error && reservation}}">
    <view class="panel"><view class="section-title">预约信息 · 北京时间</view><view class="row"><text>编号</text><text>{{reservation.reservation_no}}</text></view><view class="row"><text>服务</text><text>{{reservation.service.name}}</text></view><view class="row"><text>陪玩</text><text>{{reservation.provider.name}}</text></view><view class="row"><text>开始</text><text>{{reservation.startText}}</text></view><view class="row"><text>结束</text><text>{{reservation.endText}}</text></view><view class="row"><text>服务数量</text><text>{{reservation.game_rounds}}</text></view><view class="row"><text>预约时预估</text><text>{{reservation.estimateText}} 兴安币</text></view><text class="small muted">预估不扣款，转单以实时报价为准。</text></view>
    <view wx:if="{{reservation.reject_reason || reservation.cancel_reason}}" class="panel"><view class="section-title">处理说明</view><text>{{reservation.reject_reason || reservation.cancel_reason}}</text></view>
    <view wx:if="{{reservation.status === 'EXPIRED'}}" class="panel"><view class="section-title">预约已过期</view><text class="small muted">预约时段已结束，原预约不能转单。需要服务请重新预约。</text><button class="xa-button button-secondary" bindtap="rebook">重新预约</button></view>
    <view wx:if="{{reservation.order}}" class="panel"><view class="section-title">已生成订单</view><text>{{reservation.order_no}}</text><button class="xa-button button-secondary" bindtap="order">查看订单</button></view>
    <view wx:if="{{reservation.canConvert}}" class="panel"><view class="section-title">转为订单</view><text class="small muted">转单会立即指派陪玩，并从余额扣款。</text><view wx:if="{{quote}}"><view class="row"><text>当前服务</text><text>{{quote.serviceDisplay.name}}</text></view><view wx:if="{{quote.serviceDisplay.platform_name || quote.serviceDisplay.security_level_name}}" class="row"><text>平台与难度</text><text>{{quote.serviceDisplay.platform_name}} {{quote.serviceDisplay.security_level_name}}</text></view><view wx:if="{{quote.serviceDisplay.provider_requirement.label || quote.serviceDisplay.required_level_name}}" class="row"><text>陪玩条件</text><text>{{quote.serviceDisplay.provider_requirement.label || quote.serviceDisplay.required_level_name}}</text></view><view class="row"><text>当前应付</text><text>{{quote.amountText}} 兴安币</text></view><view class="row"><text>钱包余额</text><text>{{quote.balanceText}} 兴安币</text></view><text wx:if="{{!quote.balance_sufficient}}" class="small muted">余额不足或钱包不可用，请联系客服。</text><button wx:if="{{!quote.balance_sufficient}}" class="xa-button button-secondary" bindtap="wallet">查看钱包</button><button wx:else class="xa-button button" bindtap="convert" disabled="{{busy}}" loading="{{busy}}">确认成单</button></view><text wx:if="{{quoteError}}" class="small error">{{quoteError}}</text><button class="xa-button button-secondary" bindtap="quote" disabled="{{busy}}">{{quote ? '刷新报价' : '查看报价'}}</button></view>
    <view wx:if="{{reservation.canCancel}}" class="panel"><button class="xa-button button-secondary" bindtap="cancel" disabled="{{busy}}">取消预约</button></view>
  </block>
</view><bottom-navigation/>
