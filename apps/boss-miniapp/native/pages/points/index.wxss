.points-heading { padding:28rpx;background:#f7f4ec;border-radius:24rpx;margin-bottom:24rpx; }
.points-number { margin:12rpx 0 24rpx;font-size:64rpx;line-height:1.3;font-weight:700;color:#002fa7;font-variant-numeric:tabular-nums; }
.points-number text { font-size:var(--xa-control-small-font);font-weight:400; }
.points-heading .between { gap:16rpx; }
.points-page .points-heading .xa-button { display:flex;align-items:center;justify-content:center;min-height:var(--xa-control-secondary);margin:0;padding:10rpx 20rpx;border-radius:var(--xa-radius-control);font-size:var(--xa-control-font);white-space:nowrap; }
.points-page .points-heading .button-secondary { flex:1;width:auto; }
.points-page .points-heading .button-quiet { flex-shrink:0;width:auto; }
.tabs { display:flex;gap:8rpx;padding:6rpx;margin-bottom:24rpx;background:#f7f4ec;border-radius:16rpx; }
.points-page .tabs .xa-button { display:flex;flex:1;align-items:center;justify-content:center;min-height:var(--xa-control-compact);margin:0;padding:8rpx;border-radius:12rpx;background:transparent;color:#657188;font-size:var(--xa-control-small-font);white-space:nowrap; }
.points-page .tabs .xa-button.active { color:#00278d;background:#fffdf5;font-weight:600; }
.kind-scroll { margin:0 0 24rpx;white-space:nowrap; }
.kind-scroll .chips { display:inline-flex;flex-wrap:nowrap;margin:0;min-width:100%; }
.points-page .kind-scroll .xa-button.chip { display:inline-flex;align-items:center;justify-content:center;min-height:var(--xa-control-compact);padding:8rpx 16rpx;border-radius:var(--xa-radius-control);font-size:var(--xa-control-small-font);white-space:nowrap; }
.reward-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx; }
.reward { display:flex;flex-direction:column;gap:12rpx;min-width:0;padding:22rpx;background:#fffdf5;border-radius:24rpx; }
.reward>image,.reward-symbol { width:100%;height:152rpx;background:#f7f4ec;border-radius:16rpx; }
.reward-symbol { display:flex;align-items:center;justify-content:center; }
.reward-symbol image { width:var(--xa-icon-feature);height:var(--xa-icon-feature);opacity:.9; }
.reward-kind { font-size:var(--xa-control-small-font);color:var(--xa-color-muted); }
.reward-name { min-height:76rpx;font-size:var(--xa-control-font);font-weight:600;line-height:1.5;overflow-wrap:anywhere; }
.reward .price { font-size:34rpx; }
.reward .small { font-size:var(--xa-control-small-font); }
.points-page .reward .xa-button.button-secondary { display:flex;align-items:center;justify-content:center;min-height:var(--xa-control-secondary);width:100%;margin-top:auto;padding:10rpx 16rpx;border-radius:var(--xa-radius-control);font-size:var(--xa-control-font); }
.points-page>.xa-button.button,.points-page>.xa-button.button-quiet { min-height:var(--xa-control-height);border-radius:16rpx;font-size:var(--xa-control-font); }
.points-page>.xa-button.button-quiet { min-height:var(--xa-control-secondary);padding:8rpx 16rpx; }
.claim-row .link { display:flex;align-items:center;min-height:var(--xa-control-secondary);margin-top:8rpx;font-size:var(--xa-control-font); }
.ledger-row { display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:28rpx 0;border-bottom:1rpx solid #f7f4ec; }
.ledger-row>view { flex:1;min-width:0; }
.ledger-row text { display:block;line-height:1.6; }
.ledger-row .small { font-size:var(--xa-control-small-font); }
.ledger-amount { font-size:32rpx;font-weight:600;white-space:nowrap;font-variant-numeric:tabular-nums; }
.positive { color:#00278d; }
