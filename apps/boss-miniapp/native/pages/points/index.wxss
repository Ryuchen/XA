.points-page .panel,.points-page .section-surface,.points-heading { padding:24rpx; margin-bottom:16rpx; border:1rpx solid var(--xa-color-border); border-radius:20rpx; background:var(--xa-color-surface); }
.points-title-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.points-heading .title { font-size:20px; letter-spacing:0; }
.points-icon { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:32px; height:32px; border-radius:12rpx; background:var(--xa-color-primary-soft); }
.points-icon image { width:18px; height:18px; }
.points-label { display:block; margin-top:12rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); }
.points-number { margin:4rpx 0 16rpx; font-size:28px; line-height:1.3; font-weight:700; color:var(--xa-color-primary); font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.points-number text { font-size:var(--xa-control-small-font); font-weight:400; }
.points-heading .between { gap:16rpx; }
.points-page .points-heading .xa-button.button-secondary,.points-page .points-heading .xa-button.button-quiet { display:flex; align-items:center; justify-content:center; min-height:30px; margin:0; padding:4px 12px; border-radius:10rpx; font-size:var(--xa-control-small-font); white-space:nowrap; }
.points-page .points-heading .button-secondary { flex:1; width:auto; }
.points-page .points-heading .button-quiet { flex-shrink:0; width:auto; }
.points-page .section-title { margin:0 0 12rpx; font-size:var(--xa-control-font); line-height:1.5; }
.points-page .rules { display:block; margin:8rpx 0; color:var(--xa-color-text); font-size:var(--xa-control-font); line-height:1.65; white-space:pre-wrap; overflow-wrap:anywhere; }
.tabs { display:flex; gap:8rpx; padding:6rpx; background:var(--xa-color-surface-subtle); border-radius:12rpx; }
.points-page .tabs .xa-button { display:flex; flex:1; align-items:center; justify-content:center; min-height:30px; margin:0; padding:4px 4rpx; border-radius:8rpx; background:transparent; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); white-space:nowrap; }
.points-page .tabs .xa-button.active { color:var(--xa-color-primary); background:var(--xa-color-surface); font-weight:600; }
.kind-scroll { width:100%; margin-top:12rpx; white-space:nowrap; }
.kind-scroll .chips { display:inline-flex; flex-wrap:nowrap; gap:12rpx; margin:0; min-width:100%; }
.points-page .kind-scroll .xa-button.chip { min-height:30px; padding:4px 12rpx; border-radius:10rpx; font-size:var(--xa-control-small-font); white-space:nowrap; }
.reward-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; }
.reward { display:flex; flex-direction:column; gap:8rpx; min-width:0; padding:16rpx; border:1rpx solid var(--xa-color-border); border-radius:20rpx; background:var(--xa-color-surface); }
.reward>image,.reward-symbol { width:100%; height:128rpx; border-radius:12rpx; background:var(--xa-color-surface-subtle); }
.reward-symbol { display:flex; align-items:center; justify-content:center; }
.reward-symbol image { width:24px; height:24px; opacity:.9; }
.reward-kind { font-size:var(--xa-control-small-font); color:var(--xa-color-muted); line-height:1.5; }
.reward-name { min-height:38px; font-size:var(--xa-control-font); font-weight:600; line-height:1.4; overflow-wrap:anywhere; }
.reward .price { display:block; font-size:var(--xa-control-font); white-space:normal; overflow-wrap:anywhere; }
.points-page .small { font-size:var(--xa-control-small-font); line-height:1.5; overflow-wrap:anywhere; }
.points-page .xa-button.button,.points-page .xa-button.button-secondary,.points-page .xa-button.button-quiet { min-height:36px; padding:6px 12px; border-radius:12rpx; font-size:var(--xa-control-small-font); }
.points-page .points-login { min-height:40px; margin-top:0; font-size:var(--xa-control-font); }
.points-page .reward .xa-button.button-secondary { width:100%; min-height:30px; margin-top:auto; padding:4px 10rpx; border-radius:10rpx; }
.points-page .claim-row>.between { align-items:flex-start; gap:12rpx; }
.claim-row .section-title { flex:1; min-width:0; margin:0 0 8rpx; overflow-wrap:anywhere; }
.claim-row .tag { max-width:42%; padding:3rpx 10rpx; font-size:var(--xa-control-small-font); white-space:normal; overflow-wrap:anywhere; }
.claim-row .link { display:flex; align-items:center; justify-content:flex-end; min-height:30px; margin-top:8rpx; font-size:var(--xa-control-small-font); }
.ledger-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:16rpx 0; border-bottom:1rpx solid var(--xa-color-border); font-size:var(--xa-control-font); }
.ledger-row>view { flex:1; min-width:0; }
.ledger-row text { display:block; line-height:1.5; overflow-wrap:anywhere; }
.ledger-row .small { margin-top:4rpx; }
.ledger-amount { max-width:42%; font-size:var(--xa-control-font); font-weight:600; text-align:right; font-variant-numeric:tabular-nums; }
.points-ledger>.ledger-row:first-child { padding-top:0; }
.points-ledger>.ledger-row:last-child { padding-bottom:0; border-bottom:0; }
.positive { color:var(--xa-color-primary); }
