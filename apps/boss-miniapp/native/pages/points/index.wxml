<view class="page points-page">
  <view class="points-heading"><text class="eyebrow">我的可用积分</text><view class="points-number">{{points}}<text> 积分</text></view><view class="between"><button class="xa-button button-secondary" bindtap="lottery">幸运转盘 ›</button><button class="xa-button button-quiet" bindtap="rules">积分规则</button></view></view>
  <button wx:if="{{!logged}}" class="xa-button button" bindtap="login">登录查看我的积分</button>
  <block wx:else>
    <view wx:if="{{kook && kook.enabled}}" class="panel"><text class="section-title">KOOK积分</text><text class="rules">{{kook.rules}}</text><text class="muted small">{{kook.connected ? '自动计分已连接' : '自动计分连接中'}}</text><block wx:if="{{kook.bound}}"><text class="rules">已绑定 {{kook.nickname || '本人账号'}} · 在线获得 {{kook.online_points}} 积分</text><text class="rules">{{kook.checked_in ? '今日已签到' : '请在KOOK签到大厅发送“签到”，每天5积分。'}}</text></block><block wx:else><button class="xa-button button-secondary" bindtap="bindKook" disabled="{{busy}}">获取并复制绑定码</button><text wx:if="{{bindingCode}}" class="rules">请用本人KOOK账号在签到大厅发送“绑定 {{bindingCode}}”，10分钟内有效。</text></block><button class="xa-button button-quiet" bindtap="load" disabled="{{busy || loading}}">刷新状态</button></view>
    <view class="tabs"><button class="xa-button {{tab === 'shop' ? 'active' : ''}}" data-id="shop" bindtap="tab">积分好礼</button><button class="xa-button {{tab === 'claims' ? 'active' : ''}}" data-id="claims" bindtap="tab">兑换与中奖</button><button class="xa-button {{tab === 'ledger' ? 'active' : ''}}" data-id="ledger" bindtap="tab">积分明细</button></view>
    <state-view wx:if="{{loading || error}}" loading="{{loading}}" error="{{error}}" bind:retry="load"/>
    <block wx:if="{{!loading && !error && tab === 'shop'}}">
      <scroll-view scroll-x class="kind-scroll"><view class="chips"><button wx:for="{{kinds}}" wx:key="id" class="xa-button chip {{kind === item.id ? 'chip-active' : ''}}" data-id="{{item.id}}" bindtap="kind">{{item.name}}</button></view></scroll-view>
      <view class="reward-grid"><view wx:for="{{visible}}" wx:key="id" class="reward"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFit"/><view wx:else class="reward-symbol"><image src="/assets/icons/{{item.icon}}.png"/></view><text class="reward-kind">{{item.kind_label}}</text><text class="reward-name">{{item.name}}</text><text class="price">{{item.point_cost}}<text class="small"> 积分</text></text><text wx:if="{{item.stock !== null}}" class="muted small">剩余 {{item.stock}} 份</text><button class="xa-button button-secondary" data-id="{{item.id}}" bindtap="redeem" disabled="{{busy || item.soldOut}}">{{item.soldOut ? '已兑完' : '兑换'}}</button></view></view>
      <state-view wx:if="{{!visible.length}}" empty/>
    </block>
    <block wx:if="{{!loading && !error && tab === 'claims'}}"><view wx:for="{{claims}}" wx:key="id" class="panel claim-row" data-id="{{item.id}}" bindtap="claim"><view class="between"><text class="section-title">{{item.name_snapshot}}</text><text class="tag">{{item.status_label}}</text></view><text class="muted small">{{item.source === 'LOTTERY' ? '幸运转盘' : item.source === 'VIP' ? '会员赠礼' : item.source === 'GIFT' ? '赠礼权益' : '积分兑换'}} · {{item.time}}</text><view class="link">查看交付详情 ›</view></view><state-view wx:if="{{!claims.length}}" empty/></block>
    <block wx:if="{{!loading && !error && tab === 'ledger'}}"><view wx:for="{{ledger}}" wx:key="id" class="ledger-row"><view><text>{{item.remark}}</text><text class="muted small">{{item.time}}</text></view><text class="ledger-amount {{item.amount > 0 ? 'positive' : ''}}">{{item.amount > 0 ? '+' : ''}}{{item.amount}}</text></view><button wx:if="{{next}}" class="xa-button button-quiet" bindtap="more" loading="{{busy}}">加载更多</button><state-view wx:if="{{!ledger.length}}" empty/></block>
  </block>
</view>
