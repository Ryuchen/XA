.coupon-tabs { display:flex;gap:12rpx;margin:28rpx 0 20rpx;padding:6rpx;background:#f7f4ec;border-radius:16rpx; }
.coupons-page .coupon-tabs .xa-button.chip { display:flex;flex:1;align-items:center;justify-content:center;min-height:var(--xa-control-compact);padding:8rpx 16rpx;border:0;border-radius:12rpx;background:transparent;font-size:var(--xa-control-small-font);white-space:nowrap; }
.coupons-page .coupon-tabs .xa-button.chip-active { background:#fffdf5;box-shadow:0 4rpx 12rpx #51304408; }
.status-filter { gap:12rpx;margin-bottom:24rpx; }
.coupons-page .status-filter .xa-button.chip { display:inline-flex;align-items:center;justify-content:center;min-height:var(--xa-control-compact);padding:8rpx 16rpx;border-radius:var(--xa-radius-control);font-size:var(--xa-control-small-font);white-space:nowrap; }
.coupons-page .coupon { display:flex;align-items:stretch;gap:20rpx;padding:24rpx;border-radius:24rpx; }
.coupon-value { display:flex;flex-direction:column;justify-content:center;align-items:center;gap:6rpx;width:136rpx;flex-shrink:0; }
.coupon-value .price { font-size:42rpx; }
.coupon-copy { flex:1;min-width:0;border-left:2rpx dashed #e9eefb;padding-left:20rpx;line-height:1.8; }
.coupon-title { font-weight:600;font-size:var(--xa-control-font);overflow-wrap:anywhere;margin-bottom:8rpx; }
.coupons-page .small { font-size:var(--xa-control-small-font); }
.coupons-page .xa-button.coupon-action { display:flex;align-items:center;justify-content:center;min-height:var(--xa-control-secondary);width:100%;margin:14rpx 0 0;padding:10rpx 16rpx;border-radius:var(--xa-radius-control);font-size:var(--xa-control-small-font);white-space:nowrap; }
.coupons-page>.xa-button.button { min-height:var(--xa-control-height);border-radius:16rpx;font-size:var(--xa-control-font); }
.coupon-inactive .price { color:var(--xa-color-muted); }
.coupon-state { margin-top:14rpx; }
.coupon-value-long { width:184rpx; }
.coupon-value-long .price { font-size:30rpx; }
