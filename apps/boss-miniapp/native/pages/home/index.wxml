<view class="page home">
  <view class="storefront-top">
  <view class="brand-heading"><view><text class="brand-name">兴安电竞</text><text class="brand-note">让每一局，都有人并肩</text></view><button class="xa-button brand-support" bindtap="support" aria-label="联系客服"><image src="/assets/icons/support.png"/><text>客服</text></button></view>
  <view class="home-search"><image src="/assets/icons/search.png"/><input value="{{keyword}}" bindinput="searchInput" bindconfirm="search" confirm-type="search" maxlength="80" placeholder="搜一搜，找到你的心动服务" aria-label="搜索服务"/><button class="xa-button search-submit" bindtap="search">搜索</button></view>
  <view wx:if="{{banners.length}}" class="campaign"><swiper class="banners" circular autoplay interval="5000" bindchange="bannerChange"><swiper-item wx:for="{{banners}}" wx:key="id"><image class="banner-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="banner" aria-label="{{item.title || '查看活动'}}"/></swiper-item></swiper><view class="campaign-caption"><text>{{banners[bannerIndex].title || '兴安精选活动'}}</text><text class="small muted">{{bannerIndex + 1}} / {{banners.length}}</text></view></view>
  <view wx:else class="hero"><view class="hero-copy"><text class="hero-eyebrow">兴安 · 游戏陪伴</text><view class="hero-title">默契搭子<view>随时就位</view></view><text class="hero-note">选你所爱，一起认真玩</text><button class="xa-button button hero-button" bindtap="catalog" hover-class="xa-button-hover">发现好服务 <text>›</text></button></view><image class="hero-art" src="{{companionshipArt}}" mode="aspectFit" aria-hidden="true"/></view>
  <view class="quick-grid">
    <button class="xa-button quick-card" bindtap="checkin"><view class="quick-icon"><image src="/assets/icons/calendar.png"/></view><text>{{checkin.today_checked ? '已签到' : '每日签到'}}</text></button>
    <button class="xa-button quick-card" bindtap="companions"><view class="quick-icon"><image src="/assets/icons/headphones.png"/></view><text>挑选陪玩</text></button>
    <button class="xa-button quick-card" bindtap="coupons"><view class="quick-icon"><image src="/assets/icons/ticket.png"/></view><text>领券中心</text></button>
    <button class="xa-button quick-card" bindtap="rankings"><view class="quick-icon"><image src="/assets/icons/trophy.png"/></view><text>兴安榜单</text></button>
    <button class="xa-button quick-card" bindtap="gifts"><view class="quick-icon"><image src="/assets/icons/heart.png"/></view><text>礼物单</text></button>
  </view>
  <view wx:if="{{announcements.length}}" class="announcement"><image src="/assets/icons/bell.png" class="ui-icon"/><text class="announcement-label">公告</text><swiper class="announcement-swiper" vertical circular autoplay interval="4500"><swiper-item wx:for="{{announcements}}" wx:key="id"><view class="announcement-title" data-id="{{item.id}}" bindtap="announcement">{{item.title}}</view></swiper-item></swiper><text class="muted">›</text></view>
  </view>
  <view wx:if="{{!logged}}" class="login-panel"><view><view class="section-title">开启你的专属游戏时光</view><text class="small muted">登录查看服务价格与账号权益</text></view><button class="xa-button button" bindtap="login">微信登录</button></view>
  <view wx:if="{{stats.pending || stats.grabbed || stats.in_service}}" class="progress-panel"><view class="between"><view><text class="section-title">你的服务有新进度</text><text class="small muted">接单与履约状态，随时掌握</text></view><button class="xa-button button-quiet" bindtap="orders">全部 ›</button></view><view class="progress-links"><button class="xa-button" data-status="pending" bindtap="orders">待接单 <text>{{stats.pending}}</text></button><button class="xa-button" data-status="grabbed" bindtap="orders">已接单 <text>{{stats.grabbed}}</text></button><button class="xa-button" data-status="in_progress" bindtap="orders">服务中 <text>{{stats.in_service}}</text></button></view></view>
  <view class="home-section discovery-section">
  <view class="section-heading between"><view><text class="section-title">今天，想怎么玩</text><text class="section-note">从轻松体验到默契陪伴</text></view><button class="xa-button button-quiet" bindtap="catalog">全部服务 ›</button></view>
  <view class="discovery-entries"><button class="xa-button discovery-main" data-tab="experience" bindtap="catalog"><text class="discovery-title">先来一场体验</text><text class="discovery-note">先体验，找到合拍的搭子</text><view class="discovery-action">去选套餐 <text>›</text></view></button><button class="xa-button discovery-side" bindtap="companions"><image src="/assets/icons/headphones.png"/><text class="discovery-title">听见心动</text><text class="discovery-note">试听声音 · 挑选陪玩</text></button></view>
  <state-view wx:if="{{(loading && !gameplays.length) || error || (!loading && !gameplays.length)}}" loading="{{loading && !gameplays.length}}" error="{{error}}" empty="{{!loading && !error && !gameplays.length}}" bind:retry="load"/>
  <scroll-view wx:if="{{gameplays.length && !error}}" scroll-x class="gameplay-scroll"><view class="gameplay-list"><button wx:for="{{gameplays}}" wx:key="id" class="xa-button gameplay-card" data-id="{{item.id}}" bindtap="catalog"><image wx:if="{{item.cover}}" class="gameplay-cover" src="{{item.cover}}" mode="aspectFit"/><view wx:else class="gameplay-placeholder"><image src="/assets/icons/headphones.png"/></view><view class="gameplay-body"><text class="section-title">{{item.name}}</text><text class="small muted">{{item.service_count}} 档套餐</text><view class="price">{{item.starting !== '' ? item.starting : '待开放'}}<text wx:if="{{item.starting !== ''}}" class="small"> 币起</text></view></view></button></view></scroll-view>
  </view>
  <view wx:if="{{privateError}}" class="error" bindtap="load">{{privateError}}</view>
  <view class="home-section checkin-card"><view class="between"><view><text class="section-title">每日打卡</text><text class="small muted">{{checkin ? '本月已签到 ' + checkin.checked_count + ' 天 · 连续 ' + checkin.continuous_days + ' 天' : '记录相伴时光，查看签到奖励'}}</text></view><view class="section-symbol"><image src="/assets/icons/calendar.png"/></view></view><view wx:if="{{checkinDays.length && logged}}" class="checkin-week"><view wx:for="{{checkinDays}}" wx:key="day" class="checkin-day {{item.checked ? 'checked' : ''}} {{item.today ? 'today' : ''}}"><text>{{item.today ? '今天' : item.day + '日'}}</text><text class="day-stamp">{{item.checked ? '✓' : item.today ? '待签' : '·'}}</text></view></view><view class="checkin-bottom"><view><text class="checkin-reward">{{checkin.full_attendance_reward.name || '签到奖励等你发现'}}</text><text class="small muted">{{checkin.today_checked ? '今天已打卡，明天再相见' : checkin && !checkin.today_eligible ? '查看今日消费进度与签到条件' : '查看日历，解锁更多签到奖励'}}</text></view><button class="xa-button button" bindtap="checkin">{{checkin.today_checked ? '查看日历' : '去打卡'}}</button></view></view>
  <view class="home-section activities-section">
  <view class="section-heading between"><view><text class="section-title">俱乐部活动</text></view><button class="xa-button button-quiet" bindtap="activities">全部活动 ›</button></view>
  <view wx:if="{{hot.length}}" class="activity-feature" data-id="{{hot[0].id}}" bindtap="content"><image wx:if="{{hot[0].image}}" src="{{hot[0].image}}" mode="aspectFill"/><view><text class="tag">当期活动</text><text class="section-title">{{hot[0].title}}</text><text class="link">了解活动 ›</text></view></view>
  <view class="benefit-pair"><button class="xa-button benefit-tile" bindtap="coupons"><image src="/assets/icons/ticket.png"/><text class="section-title">好券先领</text><text class="small muted">下单前，看看可用优惠</text></button><button class="xa-button benefit-tile" bindtap="activities"><image src="/assets/icons/award.png"/><text class="section-title">活动回顾</text><text class="small muted">查看往期活动</text></button></view>
  <view wx:if="{{feed.length}}" class="club-feed" bindtap="messages"><text class="feed-heading">兴安喜报</text><swiper vertical circular autoplay interval="4000" class="feed-swiper"><swiper-item wx:for="{{feed}}" wx:key="id"><view class="feed-content">{{item.content}}</view></swiper-item></swiper></view>
  </view>
  <view class="home-section rights-section">
  <view class="section-heading between"><view><text class="section-title">老板专属权益</text></view><button class="xa-button button-quiet" bindtap="rights">权益说明 ›</button></view>
  <view class="rights-hub"><button class="xa-button gift-entry" bindtap="gifts"><view><text class="gift-entry-title">把欣赏，送给 TA</text><text class="gift-entry-note">一份礼物，让默契更进一步</text><text class="gift-entry-action">进入礼物单 ›</text></view><image src="{{giftMomentArt}}" mode="aspectFit"/></button><view class="rights-actions"><button class="xa-button" bindtap="coupons"><image src="/assets/icons/ticket.png"/><text>我的好券</text><text class="small muted">领券享优惠</text></button><button class="xa-button" bindtap="points"><image src="/assets/icons/award.png"/><text>积分好礼</text><text class="small muted">兑换你的心愿</text></button><button class="xa-button" bindtap="rights"><image src="/assets/icons/shield.png"/><text>专属权益</text><text class="small muted">了解权益与规则</text></button></view></view>
  </view>
  <view class="store-footer"><text>兴安电竞 · 每一份陪伴，都认真对待</text><button class="xa-button button-quiet" bindtap="support">选服务有疑问？联系客服 ›</button></view>
</view>
<view wx:if="{{popup}}" class="benefit-overlay" catchtouchmove="prevent">
  <view class="benefit-dialog">
    <view class="popup-heading"><view><text class="popup-kicker">欢迎来到兴安电竞</text><text class="popup-title">{{popup.kind === 'HOT' ? '近期活动' : '下单须知'}}</text></view><button class="xa-button close-popup" bindtap="closePopup" aria-label="关闭入场弹窗">×</button></view>
    <view wx:if="{{popupItems.length > 1}}" class="popup-tabs"><button wx:for="{{popupItems}}" wx:key="id" class="xa-button popup-tab {{popupIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="popupTab">{{item.kind === 'HOT' ? '近期活动' : '下单须知'}}</button></view>
    <scroll-view wx:for="{{popupItems}}" wx:key="id" wx:if="{{popupIndex === index}}" scroll-y class="benefit-scroll"><image src="{{item.image}}" mode="widthFix" class="benefit-poster" bindtap="previewPopup" aria-label="{{item.title}}，点击查看大图"/></scroll-view>
    <button class="xa-button button popup-confirm" bindtap="popupNext">{{popupIndex < popupItems.length - 1 ? '下一页 · 下单须知' : '知道了'}}</button>
  </view>
</view>
