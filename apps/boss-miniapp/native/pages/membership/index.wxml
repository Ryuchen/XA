<view class="page membership-page">
  <view wx:if="{{!logged}}" class="page-heading"><text class="title">我的会员</text><text class="subtitle">查看成长进度与专属权益</text><button class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录查看会员权益</button></view>
  <state-view wx:if="{{loading || error}}" loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{member && !loading && !error}}">
    <view class="membership-card"><text class="title">我的会员</text><text class="member-level">{{member.vip ? member.vip.name : (member.boss_type ? member.boss_type.name : '散客')}}</text><view class="member-spend"><text class="muted small">累计确认实销</text><text class="member-amount">¥{{consumptionText}}</text></view><text class="small muted">待确认 ¥{{pendingText}} · 有效报单满72小时后自动升级</text><view class="vip-progress"><view style="width:{{progress}}%"></view></view><text wx:if="{{member.next_vip}}" class="subtitle">距离 {{member.next_vip.name}} 还差 ¥{{gapText}}</text><button class="xa-button button-quiet" bindtap="rights" hover-class="xa-button-hover">查看预存福利 ›</button></view>
    <view class="panel"><view class="between panel-heading"><text class="section-title">会员权益</text><picker class="tier-picker" range="{{member.tiers}}" range-key="name" value="{{tierIndex}}" bindchange="tier"><view class="picker-control"><text class="link">{{tier.name || '等级'}}</text><image class="tier-chevron" src="/assets/icons/chevron.png" mode="aspectFit" aria-hidden="true"/></view></picker></view><view class="benefit-row"><text>下单折扣</text><text>{{tier.discount_rate / 10}} 折</text></view><view wx:for="{{benefits}}" wx:key="label" class="benefit-row"><text class="muted">{{item.label}}</text><text>{{item.value}}</text></view><button class="xa-button button-secondary" bindtap="coupons" hover-class="xa-button-hover">查看我的优惠券</button></view>
    <view class="panel"><text class="section-title">名片展示标签</text><text class="subtitle small">最多选择 5 个。不指定时，优先展示消费等级较高的已获得标签。</text><view class="tags"><button wx:for="{{tags}}" wx:key="key" class="xa-button chip {{item.selected ? 'chip-active' : ''}}" data-key="{{item.key}}" bindtap="tag" hover-class="xa-button-hover" aria-pressed="{{item.selected}}">{{item.title}}</button></view><text wx:if="{{!tags.length}}" class="muted member-empty">继续积累俱乐部成就，点亮你的专属标签。</text><button wx:if="{{tags.length}}" class="xa-button button-secondary" bindtap="saveTags" disabled="{{busy}}" hover-class="xa-button-hover">保存展示标签</button></view>
    <view class="panel"><text class="section-title">生日心意</text><view class="menu-row"><text>我的生日</text><picker class="birthday-picker" mode="date" value="{{member.birthday}}" disabled="{{!!member.birthday || busy}}" bindchange="birthday"><view class="picker-control"><text class="link">{{member.birthday || '登记生日'}}</text><image wx:if="{{!member.birthday}}" src="/assets/icons/chevron.png" mode="aspectFit" aria-hidden="true"/></view></picker></view><view class="menu-row"><text>接受首页生日祝福</text><switch checked="{{member.birthday_public}}" color="#136398" bindchange="publicBirthday" disabled="{{busy}}"/></view><text class="small muted">首页仅展示昵称和祝福，不展示出生日期。</text></view>
  </block>
</view>
<bottom-navigation/>
