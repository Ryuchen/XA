<view class="page support-page">
  <view class="section-surface support-heading"><view class="support-heading-row"><text class="title" role="heading" aria-level="1">{{scene === 'recharge' ? '钱包充值咨询' : '联系客服'}}</text><view class="support-heading-icon" aria-hidden="true"><image src="/assets/icons/support.png"/></view></view><text class="subtitle">{{scene === 'recharge' ? '联系客服核对付款，到账后可在钱包查看流水。' : '账号绑定、服务需求与订单问题，都可以联系我们。'}}</text></view>
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>

  <block wx:if="{{card}}">
    <view class="section-surface support-card">
      <view class="support-profile"><image wx:if="{{card.avatar}}" class="support-avatar" src="{{card.avatar}}" mode="aspectFill" aria-hidden="true"/><view wx:else class="support-avatar support-avatar-placeholder" aria-hidden="true"><image src="/assets/icons/support.png"/></view><view class="support-profile-copy"><text class="support-name">{{card.name}}</text><text wx:if="{{card.company}}" class="support-company">{{card.company}}</text></view></view>
      <button wx:if="{{card.wecom_corp_id && card.wecom_service_url}}" class="xa-button button support-contact" bindtap="contact" loading="{{opening}}" disabled="{{opening || loading}}" hover-class="xa-button-hover">{{opening ? '正在打开客服' : '打开企业微信客服'}}</button>
      <text wx:if="{{contactError}}" class="support-contact-error" role="alert">{{contactError}}</text>
      <text wx:if="{{diagnostic && contactDetail}}" class="support-diagnostic" selectable>开发预览诊断：{{contactDetail}}</text>
    </view>

    <view wx:if="{{card.customer_reference || card.order_no}}" class="section-surface support-context">
      <text class="support-section-title" role="heading" aria-level="2">咨询信息</text>
      <view wx:if="{{card.customer_reference}}" class="support-reference"><view class="support-field"><text class="support-label">咨询编号</text><text class="support-value reference-value" selectable>{{card.customer_reference}}</text></view><button class="xa-button button-secondary support-copy" bindtap="copyReference" disabled="{{loading}}" hover-class="xa-button-hover" aria-label="{{card.order_no ? '复制咨询编号和关联订单给客服' : '复制咨询编号给客服'}}">复制给客服</button></view>
      <view wx:if="{{card.order_no}}" class="support-field support-order"><text class="support-label">关联订单</text><text class="support-value" selectable>{{card.order_no}}</text></view>
    </view>

    <view wx:if="{{card.wechat_id || card.qrcode}}" class="section-surface support-wechat">
      <text class="support-section-title" role="heading" aria-level="2">微信联系</text>
      <view wx:if="{{card.wechat_id}}" class="wechat-row"><view class="support-field"><text class="support-label">微信号</text><text class="support-value" selectable>{{card.wechat_id}}</text></view><button class="xa-button button-secondary support-copy" bindtap="copy" disabled="{{loading}}" hover-class="xa-button-hover">复制微信号</button></view>
      <view wx:if="{{card.qrcode}}" class="support-qr"><button class="xa-button qrcode-preview" bindtap="preview" aria-label="放大客服二维码" hover-class="xa-button-hover"><image class="qrcode" src="{{card.qrcode}}" mode="aspectFit" aria-hidden="true"/></button><text class="support-qr-note">点击放大客服二维码</text></view>
    </view>

    <view wx:if="{{card.tips}}" class="section-surface support-guidance"><text class="support-section-title" role="heading" aria-level="2">咨询说明</text><text class="support-tips">{{card.tips}}</text></view>
  </block>

  <view wx:if="{{!loading && !error && !card}}" class="section-surface support-empty"><text class="support-empty-title">客服接待暂未开放</text><text>可使用下方平台客服入口咨询。</text></view>
  <view class="section-surface support-actions"><view class="support-chat-copy"><text class="support-chat-title">平台客服会话</text><text class="support-chat-note">支持文字与图片咨询</text></view><button class="xa-button button-secondary support-chat" bindtap="chat" hover-class="xa-button-hover">进入会话</button></view>
</view>
<bottom-navigation/>
