<view class="page support-page"><text class="eyebrow">客服与帮助</text><text class="title">{{scene === 'recharge' ? '钱包充值咨询' : '我们在这里帮你'}}</text><text class="subtitle">{{scene === 'recharge' ? '联系客服核对付款，到账后可在钱包查看流水。' : '账号绑定、服务需求与订单问题，都可以联系我们。'}}</text><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<view class="panel" wx:if="{{card}}"><view class="row"><image wx:if="{{card.avatar}}" class="avatar" src="{{card.avatar}}" mode="aspectFill"/><view><text class="section-title">{{card.name}}</text><text class="small muted">{{card.company}}</text></view></view><view wx:if="{{card.customer_reference}}" class="menu-row"><text user-select>咨询编号 {{card.customer_reference}}</text><text class="link" bindtap="copyReference">复制给客服</text></view><text wx:if="{{card.order_no}}" class="small muted">关联订单 {{card.order_no}}</text><button wx:if="{{card.wecom_corp_id && card.wecom_service_url}}" class="xa-button button" bindtap="contact" loading="{{opening}}" disabled="{{opening || loading}}" hover-class="xa-button-hover">打开企业微信客服</button><text wx:if="{{contactError}}" class="subtitle small">{{contactError}}</text><text wx:if="{{diagnostic && contactDetail}}" class="subtitle small" user-select>开发预览诊断：{{contactDetail}}</text><view wx:if="{{card.wechat_id}}" class="menu-row"><text user-select>微信号：{{card.wechat_id}}</text><text class="link" bindtap="copy">复制</text></view><image wx:if="{{card.qrcode}}" class="qrcode" src="{{card.qrcode}}" mode="aspectFit" bindtap="preview"/><text class="subtitle small">{{card.tips}}</text></view>
<view wx:if="{{!loading && !error && !card}}" class="empty">客服接待暂未开放，可使用下方平台客服入口。</view><button class="xa-button button-secondary" bindtap="chat" hover-class="xa-button-hover">进入平台客服会话</button><button class="xa-button button-quiet" open-type="contact" hover-class="xa-button-hover">使用小程序客服</button></view>
