.audition-page .page-heading, .audition-page .panel, .audition-page .section-surface { margin-bottom:20rpx; padding:24rpx; border-color:var(--xa-color-border); border-radius:20rpx; }
.audition-page .title { font-size:20px; letter-spacing:0; }
.audition-page .eyebrow { margin-bottom:6rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.audition-page .section-title { margin:0 0 12rpx; font-size:var(--xa-control-font); line-height:1.5; overflow-wrap:anywhere; }
.invitation-remark { display:block; font-size:var(--xa-control-font); line-height:1.6; white-space:pre-wrap; overflow-wrap:anywhere; }
.invitation-field { display:flex; align-items:baseline; gap:16rpx; margin-top:16rpx; padding-top:12rpx; border-top:1rpx solid var(--xa-color-border); }
.field-label { flex-shrink:0; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; }
.field-value { min-width:0; font-size:var(--xa-control-font); line-height:1.5; overflow-wrap:anywhere; }
.audition-page .invitation-actions .xa-button.button { min-height:40px; margin:0; padding:8px 12px; border-radius:12rpx; font-size:var(--xa-control-font); line-height:1.5; }
.invitation-note { display:block; margin-top:12rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.6; overflow-wrap:anywhere; }
.audition-page .audition-support { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:16rpx 24rpx; }
.support-label { flex:1; min-width:0; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; }
.audition-page .audition-support .xa-button.button-secondary { width:112px; min-height:36px; margin:0; padding:6px; flex-shrink:0; border-radius:10rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
