<view class="page audition-page"><text class="eyebrow">老板专属邀请</text><text class="title">试音活动</text><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/><view class="panel" wx:if="{{info}}"><text class="section-title">{{info.title}}</text><text>{{info.remark || '请联系客服了解本次活动安排'}}</text><text class="subtitle">有效期：{{info.expiry}}</text><text wx:if="{{existingAccount}}" class="subtitle small">当前账号：{{existingAccount}}</text><button class="xa-button button" loading="{{busy}}" disabled="{{busy || !info.is_active}}" bindtap="enter" hover-class="xa-button-hover">确认身份并进入</button><text class="subtitle small">此邀请绑定特定账号，请勿转发。进入后可在账号安全页绑定微信。</text></view><button class="xa-button button-quiet" bindtap="support" hover-class="xa-button-hover">联系活动客服</button></view>
