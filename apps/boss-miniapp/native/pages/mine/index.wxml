<view class="page mine">
  <view wx:if="{{!logged}}" class="section-surface guest"><view class="guest-main"><view class="guest-copy"><text class="title">你的游戏生活</text><text class="subtitle">登录后管理钱包、订单与账号资料</text></view><image class="guest-art" src="{{companionshipArt}}" mode="aspectFit" aria-hidden="true"/></view><button class="xa-button button guest-login" bindtap="login" hover-class="xa-button-hover">微信快捷登录</button></view>
  <state-view wx:else loading="{{loading}}" error="{{error}}" bind:retry="load"/>

  <block wx:if="{{logged && profile}}">
    <view class="section-surface identity-card">
      <button class="xa-button profile" data-page="profile" bindtap="open" hover-class="xa-button-hover" aria-label="{{'查看个人资料，' + profile.nickname}}">
        <image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}" mode="aspectFill" aria-hidden="true"/><view wx:else class="avatar avatar-placeholder" aria-hidden="true">我</view>
        <view class="profile-copy"><text class="profile-name">{{profile.nickname}}</text><text class="profile-id">账号 ID {{profile.id}}</text></view><image class="profile-arrow" src="/assets/icons/chevron.png" aria-hidden="true"/>
      </button>
      <button class="xa-button profile-tags" data-page="membership" bindtap="open" hover-class="xa-button-hover" aria-label="查看会员并设置名片标签"><text wx:for="{{member.display_tags}}" wx:key="key" class="tag {{item.highlighted ? 'highlighted' : ''}}">{{item.title}}</text><text class="tag-settings">设置名片标签 ›</text></button>
      <button class="xa-button binding" data-page="security" bindtap="open" hover-class="xa-button-hover" aria-label="{{(profile.isWechatBound ? '微信已绑定' : '微信尚未绑定') + '，查看账号安全'}}"><view class="binding-state"><image src="/assets/icons/shield.png" aria-hidden="true"/><text>{{profile.isWechatBound ? '微信已绑定' : '微信尚未绑定'}}</text></view><view class="binding-link"><text>账号安全</text><image src="/assets/icons/chevron.png" aria-hidden="true"/></view></button>
    </view>

    <button class="xa-button wallet" data-page="wallet" bindtap="open" hover-class="xa-button-hover" aria-label="{{'钱包余额' + balance + '兴安币，查看账单'}}"><view class="wallet-copy"><text class="wallet-label">我的钱包 · 可用余额</text><view class="wallet-balance"><text class="wallet-value {{balance.length > 12 ? 'wallet-value-long' : ''}}">{{balance}}</text><text class="wallet-unit">兴安币</text></view></view><text class="wallet-link">查看账单</text></button>

    <view class="section-surface order-panel"><view class="panel-heading"><text class="menu-title" role="heading" aria-level="2">我的订单</text><button class="xa-button all-orders" bindtap="orders" hover-class="xa-button-hover">全部订单 ›</button></view><view class="order-counts"><button class="xa-button" data-status="pending" bindtap="orders" hover-class="xa-button-hover" aria-label="{{'待接单，' + stats.pending + '单'}}"><text class="order-count">{{stats.pending}}</text><text class="order-label">待接单</text></button><button class="xa-button" data-status="grabbed" bindtap="orders" hover-class="xa-button-hover" aria-label="{{'已接单，' + stats.grabbed + '单'}}"><text class="order-count">{{stats.grabbed}}</text><text class="order-label">已接单</text></button><button class="xa-button" data-status="in_progress" bindtap="orders" hover-class="xa-button-hover" aria-label="{{'服务中，' + stats.in_service + '单'}}"><text class="order-count">{{stats.in_service}}</text><text class="order-label">服务中</text></button></view></view>
  </block>

  <view class="section-surface benefits-panel"><view class="panel-heading"><text class="menu-title" role="heading" aria-level="2">常用功能</text></view><view class="benefits">
    <button class="xa-button" data-page="coupons" bindtap="open" hover-class="xa-button-hover"><view class="benefit-icon"><image src="/assets/icons/ticket.png" aria-hidden="true"/></view><text>优惠券</text></button><button class="xa-button" data-page="favorites" bindtap="open" hover-class="xa-button-hover"><view class="benefit-icon"><image src="/assets/icons/heart.png" aria-hidden="true"/></view><text>我的收藏</text></button><button class="xa-button" data-page="checkin" bindtap="open" hover-class="xa-button-hover"><view class="benefit-icon"><image src="/assets/icons/calendar.png" aria-hidden="true"/></view><text>每日签到</text></button><button class="xa-button" data-page="achievements" bindtap="open" hover-class="xa-button-hover"><view class="benefit-icon"><image src="/assets/icons/award.png" aria-hidden="true"/></view><text>我的成就</text></button>
  </view></view>

  <view class="section-surface settings"><view class="panel-heading"><text class="menu-title" role="heading" aria-level="2">会员与权益</text></view>
    <button class="xa-button menu-row" data-page="gifts" bindtap="open" hover-class="xa-button-hover"><view class="menu-main"><image src="/assets/icons/heart.png" class="menu-icon" aria-hidden="true"/><text>礼物单</text></view><text class="menu-note">送一份心意</text><image class="arrow-icon" src="/assets/icons/chevron.png" aria-hidden="true"/></button>
    <button class="xa-button menu-row" data-page="membership" bindtap="open" hover-class="xa-button-hover" aria-label="{{'我的会员，' + (member.vip.name || '兴安会员')}}"><view class="menu-main"><image src="/assets/icons/award.png" class="menu-icon" aria-hidden="true"/><text>我的会员</text></view><text class="menu-note membership-note">{{member.vip.name || '兴安会员'}}</text><image class="arrow-icon" src="/assets/icons/chevron.png" aria-hidden="true"/></button>
    <button class="xa-button menu-row" data-page="points" bindtap="open" hover-class="xa-button-hover" aria-label="{{'积分与幸运转盘，' + (member.points || 0) + '积分'}}"><view class="menu-main"><image src="/assets/icons/trophy.png" class="menu-icon" aria-hidden="true"/><text>积分与幸运转盘</text></view><view class="menu-note points-note"><text class="points-value">{{member.points || 0}}</text><text class="points-unit">积分</text></view><image class="arrow-icon" src="/assets/icons/chevron.png" aria-hidden="true"/></button>
    <button class="xa-button menu-row" bindtap="rights" hover-class="xa-button-hover"><view class="menu-main"><image src="/assets/icons/shield.png" class="menu-icon" aria-hidden="true"/><text>老板权益</text></view><image class="arrow-icon" src="/assets/icons/chevron.png" aria-hidden="true"/></button>
  </view>

  <view class="section-surface settings"><view class="panel-heading"><text class="menu-title" role="heading" aria-level="2">账号与服务</text></view>
    <button class="xa-button menu-row" data-page="profile" bindtap="open" hover-class="xa-button-hover"><view class="menu-main"><image src="/assets/icons/profile.png" class="menu-icon" aria-hidden="true"/><text>个人与游戏资料</text></view><image class="arrow-icon" src="/assets/icons/chevron.png" aria-hidden="true"/></button>
    <button class="xa-button menu-row" data-page="security" bindtap="open" hover-class="xa-button-hover"><view class="menu-main"><image src="/assets/icons/shield.png" class="menu-icon" aria-hidden="true"/><text>账号与微信绑定</text></view><image class="arrow-icon" src="/assets/icons/chevron.png" aria-hidden="true"/></button>
    <button class="xa-button menu-row" data-page="club-content" bindtap="open" hover-class="xa-button-hover"><view class="menu-main"><image src="/assets/icons/headphones.png" class="menu-icon" aria-hidden="true"/><text>俱乐部规范</text></view><image class="arrow-icon" src="/assets/icons/chevron.png" aria-hidden="true"/></button>
    <button class="xa-button menu-row" data-page="announcements" bindtap="open" hover-class="xa-button-hover"><view class="menu-main"><image src="/assets/icons/bell.png" class="menu-icon" aria-hidden="true"/><text>平台公告</text></view><image class="arrow-icon" src="/assets/icons/chevron.png" aria-hidden="true"/></button>
    <button class="xa-button menu-row" data-page="support" bindtap="open" hover-class="xa-button-hover"><view class="menu-main"><image src="/assets/icons/support.png" class="menu-icon" aria-hidden="true"/><text>客服与帮助</text></view><image class="arrow-icon" src="/assets/icons/chevron.png" aria-hidden="true"/></button>
  </view>
</view>
