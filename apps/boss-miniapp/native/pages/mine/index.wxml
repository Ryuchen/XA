<view class="page mine">
  <view wx:if="{{!logged}}" class="panel guest"><image class="guest-art" src="{{companionshipArt}}" mode="aspectFit"/><text class="title">你的游戏生活</text><text class="subtitle">登录后管理钱包、订单与账号资料</text><button class="xa-button button" bindtap="login" hover-class="xa-button-hover">微信快捷登录</button></view>
  <state-view wx:else loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{logged && profile}}">
    <view class="identity-card">
      <view class="profile row" data-page="profile" bindtap="open" role="button"><image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}" mode="aspectFill"/><view wx:else class="avatar avatar-placeholder">我</view><view class="profile-copy"><text class="title">{{profile.nickname}}</text><text class="muted small">老板编号 {{profile.id}}</text></view><image class="ui-icon profile-arrow" src="/assets/icons/chevron.png"/></view>
      <view class="profile-tags" data-page="membership" bindtap="open" role="button"><text wx:for="{{member.display_tags}}" wx:key="key" class="tag {{item.highlighted ? 'highlighted' : ''}}">{{item.title}}</text><text class="small link">设置名片标签 ›</text></view>
      <view class="binding between" data-page="security" bindtap="open" role="button"><view class="row"><image src="/assets/icons/shield.png" class="ui-icon"/><text>{{profile.isWechatBound ? '微信已绑定' : '微信尚未绑定'}}</text></view><text class="small">账号安全 ›</text></view>
    </view>
    <view class="wallet" data-page="wallet" bindtap="open" role="button"><text class="wallet-label">可用余额 · 兴安币</text><view class="between"><text class="wallet-value">{{balance}}</text><text class="link">查看账单 ›</text></view></view>
    <view class="panel order-panel"><view class="between panel-heading"><text class="menu-title">我的订单</text><text class="muted small all-orders" bindtap="orders" role="button">全部订单 ›</text></view><view class="order-counts"><view data-status="pending" bindtap="orders" role="button"><text>{{stats.pending}}</text><text class="small muted">待接单</text></view><view data-status="grabbed" bindtap="orders" role="button"><text>{{stats.grabbed}}</text><text class="small muted">已接单</text></view><view data-status="in_progress" bindtap="orders" role="button"><text>{{stats.in_service}}</text><text class="small muted">服务中</text></view></view></view>
  </block>
  <view class="panel benefits-panel"><view class="panel-heading"><text class="menu-title">常用工具</text></view><view class="benefits">
    <button class="xa-button" data-page="coupons" bindtap="open" hover-class="xa-button-hover"><view class="benefit-icon"><image src="/assets/icons/ticket.png"/></view><text>优惠券</text></button><button class="xa-button" data-page="favorites" bindtap="open" hover-class="xa-button-hover"><view class="benefit-icon"><image src="/assets/icons/heart.png"/></view><text>我的收藏</text></button><button class="xa-button" data-page="checkin" bindtap="open" hover-class="xa-button-hover"><view class="benefit-icon"><image src="/assets/icons/calendar.png"/></view><text>每日签到</text></button><button class="xa-button" data-page="achievements" bindtap="open" hover-class="xa-button-hover"><view class="benefit-icon"><image src="/assets/icons/award.png"/></view><text>我的成就</text></button>
  </view></view>
  <view class="panel settings"><view class="panel-heading"><text class="menu-title">会员与权益</text></view>
    <view class="menu-row" data-page="gifts" bindtap="open" role="button"><view class="row"><image src="/assets/icons/heart.png" class="ui-icon"/><text>礼物单</text></view><text class="menu-note">送一份心意</text><image class="arrow-icon" src="/assets/icons/chevron.png"/></view>
    <view class="menu-row" data-page="membership" bindtap="open" role="button"><view class="row"><image src="/assets/icons/award.png" class="ui-icon"/><text>我的会员</text></view><text class="menu-note">{{member.vip.name || '兴安会员'}}</text><image class="arrow-icon" src="/assets/icons/chevron.png"/></view>
    <view class="menu-row" data-page="points" bindtap="open" role="button"><view class="row"><image src="/assets/icons/trophy.png" class="ui-icon"/><text>积分与幸运转盘</text></view><text class="menu-note link">{{member.points || 0}} 积分</text><image class="arrow-icon" src="/assets/icons/chevron.png"/></view>
    <view class="menu-row" bindtap="rights" role="button"><view class="row"><image src="/assets/icons/shield.png" class="ui-icon"/><text>老板权益</text></view><image class="arrow-icon" src="/assets/icons/chevron.png"/></view>
  </view>
  <view class="panel settings"><view class="panel-heading"><text class="menu-title">账号与服务</text></view>
    <view class="menu-row" data-page="profile" bindtap="open" role="button"><view class="row"><image src="/assets/icons/profile.png" class="ui-icon"/><text>个人与游戏资料</text></view><image class="arrow-icon" src="/assets/icons/chevron.png"/></view>
    <view class="menu-row" data-page="security" bindtap="open" role="button"><view class="row"><image src="/assets/icons/shield.png" class="ui-icon"/><text>账号与微信绑定</text></view><image class="arrow-icon" src="/assets/icons/chevron.png"/></view>
    <view class="menu-row" data-page="club-content" bindtap="open" role="button"><view class="row"><image src="/assets/icons/headphones.png" class="ui-icon"/><text>俱乐部规范</text></view><image class="arrow-icon" src="/assets/icons/chevron.png"/></view>
    <view class="menu-row" data-page="announcements" bindtap="open" role="button"><view class="row"><image src="/assets/icons/bell.png" class="ui-icon"/><text>平台公告</text></view><image class="arrow-icon" src="/assets/icons/chevron.png"/></view>
    <view class="menu-row" data-page="support" bindtap="open" role="button"><view class="row"><image src="/assets/icons/support.png" class="ui-icon"/><text>客服与帮助</text></view><image class="arrow-icon" src="/assets/icons/chevron.png"/></view>
  </view>
</view>
