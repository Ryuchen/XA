/* 我的 · 澄海 App 基线
   一张身份卡 + 一张钱包卡 + 分组列表。列表行 52px、图标 15px、
   分隔线从文字处内缩——这三件事决定了它像不像原生 App。 */

.mine-heading { margin-bottom: var(--xa-s-4); }
.mine-heading .title { font-size: var(--xa-fs-h1); letter-spacing: -1rpx; }
.mine-heading .subtitle { margin-top: 6rpx; }

.mine .section-surface {
  padding: 0; margin-bottom: var(--xa-s-4);
  border-radius: var(--xa-r-xl); border: 1rpx solid var(--xa-hairline);
  background: var(--xa-color-surface-card); box-shadow: var(--xa-elev-1);
  overflow: hidden;
}

/* ── 未登录 ───────────────────────────────────────────────── */
.mine .section-surface.guest { padding: var(--xa-s-5); background: var(--xa-grad-soft); }
.guest-main { display: flex; align-items: center; gap: var(--xa-s-4); }
.guest-copy { flex: 1; min-width: 0; }
.guest-art { width: 176rpx; height: 176rpx; flex-shrink: 0; }
.mine .xa-button.guest-login { margin-top: var(--xa-s-5); border-radius: var(--xa-r-pill); }

/* ── 身份卡 ───────────────────────────────────────────────── */
.identity-card { }
.mine .xa-button.profile {
  display: flex; align-items: center; gap: var(--xa-s-4); width: 100%; margin: 0;
  padding: var(--xa-s-5) var(--xa-s-5) var(--xa-s-4);
  text-align: left; font-weight: 400; background: transparent;
}
.avatar { width: 112rpx; height: 112rpx; flex-shrink: 0; border-radius: 50%; background: var(--xa-color-primary-soft); }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; color: var(--xa-color-primary); font-size: var(--xa-fs-h1); font-weight: 600; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name {
  display: block; font-size: var(--xa-fs-title); font-weight: 700; line-height: var(--xa-lh-title);
  letter-spacing: -.4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.profile-id { display: block; margin-top: 4rpx; font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted); }
.profile-arrow { width: 20rpx; height: 20rpx; flex-shrink: 0; opacity: .35; }

.mine .xa-button.profile-tags {
  display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; width: 100%; margin: 0;
  padding: 0 var(--xa-s-5) var(--xa-s-4); text-align: left; font-weight: 400; background: transparent;
}
.profile-tags .tag { padding: 4rpx 14rpx; background: #f2f5fb; color: var(--xa-color-text-secondary); }
.profile-tags .tag.highlighted {
  background: linear-gradient(135deg, rgba(37, 99, 235, .12), rgba(56, 189, 248, .16));
  color: var(--xa-color-primary-hover); font-weight: 600;
}
.tag-settings { margin-left: auto; flex-shrink: 0; font-size: var(--xa-fs-cap); font-weight: 500; color: var(--xa-color-primary); }

.mine .xa-button.binding {
  display: flex; align-items: center; justify-content: space-between; gap: var(--xa-s-3); width: 100%; margin: 0;
  min-height: 88rpx; padding: 0 var(--xa-s-5); border-top: 1rpx solid var(--xa-hairline);
  background: #fbfcfe; text-align: left; font-weight: 400;
}
.binding-state { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.binding-state image { width: 28rpx; height: 28rpx; opacity: .7; }
.binding-state text { font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-text-secondary); }
.binding-link { display: flex; align-items: center; gap: 4rpx; flex-shrink: 0; }
.binding-link text { font-size: var(--xa-fs-cap); color: var(--xa-color-primary); font-weight: 500; }
.binding-link image { width: 18rpx; height: 18rpx; opacity: .45; }

/* ── 钱包：全页唯一深色卡 ─────────────────────────────────── */
.mine .xa-button.wallet {
  position: relative; overflow: hidden; display: block;
  width: 100%; margin: 0 0 var(--xa-s-4); padding: var(--xa-s-5); border: 0;
  border-radius: var(--xa-r-xl); background: var(--xa-grad-deep);
  text-align: left; font-weight: 400; box-shadow: var(--xa-elev-2);
}
.wallet::after {
  content: ''; position: absolute; top: -100rpx; right: -80rpx; width: 320rpx; height: 320rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(56, 189, 248, .38), rgba(56, 189, 248, 0) 68%); pointer-events: none;
}
.wallet-copy { position: relative; z-index: 1; flex: 1; min-width: 0; }
.wallet-label { display: block; font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: rgba(214, 228, 255, .72); letter-spacing: .4rpx; }
.wallet-balance { display: flex; align-items: baseline; gap: 8rpx; margin-top: 10rpx; padding-right: 160rpx; }
.wallet-value {
  font-size: 64rpx; font-weight: 700; line-height: 1.04; letter-spacing: -1.8rpx;
  color: #fff; font-variant-numeric: tabular-nums;
}
.wallet-value-long { font-size: var(--xa-fs-h1); }
.wallet-unit { font-size: var(--xa-fs-cap); font-weight: 500; color: rgba(214, 228, 255, .68); }
.wallet-link {
  position: absolute; z-index: 2; top: var(--xa-s-4); right: var(--xa-s-4);
  padding: 7rpx 20rpx; border-radius: var(--xa-r-pill);
  background: rgba(255, 255, 255, .13); color: #fff;
  font-size: var(--xa-fs-cap); font-weight: 600; line-height: 1.4; white-space: nowrap;
}

/* ── 面板标题 ─────────────────────────────────────────────── */
.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--xa-s-3); padding: var(--xa-s-4) var(--xa-s-5) var(--xa-s-2); }
.menu-title { font-size: var(--xa-fs-strong); font-weight: 600; line-height: var(--xa-lh-strong); letter-spacing: -.2rpx; }
.mine .xa-button.all-orders {
  flex-shrink: 0; width: auto; min-height: 56rpx; margin: 0; padding: 0 4rpx 0 12rpx;
  background: transparent; color: var(--xa-color-primary); font-size: var(--xa-fs-cap); font-weight: 500;
}

/* ── 订单计数 ─────────────────────────────────────────────── */
.order-counts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: var(--xa-s-2) 0 var(--xa-s-4); }
.mine .order-counts .xa-button {
  display: flex; flex-direction: column; align-items: center; gap: 4rpx; margin: 0; padding: 8rpx 4rpx;
  min-height: 96rpx; background: transparent; border-radius: 0; font-weight: 400;
}
.order-count { font-size: var(--xa-fs-h1); font-weight: 700; line-height: 1.15; color: var(--xa-color-primary); font-variant-numeric: tabular-nums; }
.order-label { font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted); }

/* ── 常用功能 ─────────────────────────────────────────────── */
.benefits { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: var(--xa-s-2) var(--xa-s-3) var(--xa-s-4); }
.mine .benefits .xa-button {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin: 0; padding: 8rpx 4rpx;
  min-height: 116rpx; background: transparent; border-radius: var(--xa-r-md);
  font-size: var(--xa-fs-cap); font-weight: 500; color: var(--xa-color-text-secondary);
}
.benefit-icon {
  display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx;
  border-radius: 18rpx; background: linear-gradient(150deg, #eef4ff, #dbeafe);
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, .09);
}
.benefit-icon image { width: 30rpx; height: 30rpx; }

/* ── 菜单行：52px 行高，分隔线从文字处内缩 ─────────────────── */
.mine .settings .menu-row {
  position: relative; display: flex; align-items: center; justify-content: space-between; gap: var(--xa-s-3);
  width: 100%; min-height: 104rpx; margin: 0; padding: 0 var(--xa-s-5);
  border: 0; background: transparent; text-align: left;
  font-size: var(--xa-fs-body); font-weight: 400; color: var(--xa-color-text-primary);
}
.mine .settings .menu-row + .menu-row { border-top: 0; }
.mine .settings .menu-row + .menu-row::before {
  content: ''; position: absolute; top: 0; left: calc(var(--xa-s-5) + 44rpx + var(--xa-s-3)); right: 0;
  height: 1rpx; background: var(--xa-hairline);
}
.menu-main { display: flex; align-items: center; gap: var(--xa-s-3); min-width: 0; flex: 1; }
.menu-main text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.menu-icon {
  width: 44rpx; height: 44rpx; flex-shrink: 0; box-sizing: border-box; padding: 8rpx;
  border-radius: 10rpx; background: #f2f5fb;
}
.menu-note { flex-shrink: 0; font-size: var(--xa-fs-cap); color: var(--xa-color-muted); text-align: right; }
.points-note { display: flex; align-items: baseline; gap: 4rpx; }
.points-value { font-size: var(--xa-fs-sub); font-weight: 600; color: var(--xa-color-primary); font-variant-numeric: tabular-nums; }
.points-unit { font-size: var(--xa-fs-cap); color: var(--xa-color-muted); }
.arrow-icon { width: 18rpx; height: 18rpx; flex-shrink: 0; opacity: .35; }

.mine .settings .menu-row:last-child { margin-bottom: 0; }

@media (max-width: 350px) {
  .wallet-value { font-size: 48rpx; }
  .benefit-icon { width: 60rpx; height: 60rpx; }
}
