.mine { background: var(--xa-color-page); }
.mine .panel { margin-bottom: 24rpx; border-radius: 24rpx; }
.identity-card { padding: 26rpx 26rpx 0; margin-bottom: 24rpx; border: 1rpx solid var(--xa-color-border); border-radius: 24rpx; background: #fffdf5; }
.profile { padding: 0; gap: 18rpx; min-height: 100rpx; }
.profile .avatar { width: 96rpx; height: 96rpx; border: 3rpx solid #f7f4ec; font-size: 30rpx; }
.profile-copy { flex: 1; min-width: 0; }
.profile .title { font-size: 34rpx; margin-bottom: 6rpx; letter-spacing: 0; }
.profile-copy .small { display: block; font-size: 22rpx; }
.profile .profile-arrow { width: 28rpx; height: 28rpx; }
.profile-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; min-height: 72rpx; margin: 8rpx 0; }
.profile-tags .tag { font-size: 21rpx; border-radius: 8rpx; }
.profile-tags .highlighted { background: var(--xa-color-primary); color: white; }
.profile-tags .link { display: flex; align-items: center; margin-left: auto; min-height: var(--xa-control-secondary); font-size: var(--xa-control-small-font); }
.binding { min-height: var(--xa-control-height); padding: 14rpx 0; border-top: 1rpx solid var(--xa-color-border); color: var(--xa-color-muted); font-size: var(--xa-control-small-font); }
.binding .ui-icon { width:var(--xa-icon-small); height:var(--xa-icon-small); }
.binding .row { gap: 8rpx; }
.binding .small { font-size: var(--xa-control-small-font); }
.wallet { padding: 26rpx 28rpx; margin-bottom: 24rpx; border-radius: 24rpx; border: 1rpx solid #e9eefb; background: linear-gradient(115deg,#f7f4ec,#f7f4ec); }
.wallet-label { color: #657188; font-size: 24rpx; }
.wallet-value { color: #002fa7; font-size: 56rpx; font-weight: 650; line-height: 1.5; font-variant-numeric: tabular-nums; }
.wallet .between { flex-wrap: wrap; }
.wallet .link { font-size: var(--xa-control-small-font); white-space: nowrap; }
.panel-heading { display: flex; align-items: center; min-height: 48rpx; }
.menu-title { font-size: 28rpx; font-weight: 600; }
.all-orders { display: flex; align-items: center; justify-content: flex-end; min-height: var(--xa-control-secondary); font-size: var(--xa-control-small-font); }
.order-panel { padding: 14rpx 26rpx 24rpx; }
.order-panel .panel-heading { border-bottom: 1rpx solid var(--xa-color-border); }
.order-counts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding-top: 16rpx; }
.order-counts > view { min-height: 100rpx; padding: 8rpx 0; text-align: center; }
.order-counts > view + view { border-left: 1rpx solid var(--xa-color-border); }
.order-counts text { display: block; }
.order-counts text:first-child { margin-bottom: 4rpx; font-size: 34rpx; line-height: 1.4; font-weight: 600; }
.order-counts .small { font-size: var(--xa-control-small-font); }
.benefits-panel { padding: 22rpx 24rpx; }
.benefits { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8rpx; margin-top: 12rpx; }
.benefits .xa-button { display: flex; align-items: center; flex-direction: column; gap: 10rpx; min-height: 108rpx; width: 100%; padding: 8rpx 0; background: transparent; border-radius: 16rpx; font-size: var(--xa-control-small-font); font-weight: 500; }
.benefit-icon { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 16rpx; background: #f7f4ec; }
.benefits image { width:var(--xa-icon-medium); height:var(--xa-icon-medium); }
.settings { padding: 20rpx 26rpx 6rpx; }
.settings .panel-heading { padding-bottom: 12rpx; }
.settings .menu-row { min-height: max(96rpx,44px); gap: 12rpx; padding: 20rpx 0; font-size: var(--xa-control-font); }
.settings .menu-row > .row { flex: 1; gap: 14rpx; min-width: 0; }
.settings .ui-icon { width:var(--xa-icon-small); height:var(--xa-icon-small); }
.settings .arrow-icon { width:var(--xa-icon-small); height:var(--xa-icon-small); flex-shrink: 0; }
.settings .menu-note { max-width: 200rpx; font-size: var(--xa-control-small-font); color: var(--xa-color-muted); text-align: right; overflow-wrap: anywhere; }
.settings .menu-note.link { color: var(--xa-color-primary); }
.guest { text-align: center; }
.guest .title { font-size: 34rpx; }
.guest .subtitle { font-size: 24rpx; }
.guest-art { display: block; width: 160rpx; height: 144rpx; margin: 0 auto 16rpx; border-radius: 24rpx; }
