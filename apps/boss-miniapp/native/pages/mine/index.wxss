/* 我的 · 澄海 2026
   身份卡 + 深海钱包卡 + 分区菜单；图标统一收进浅蓝渐变底。 */
.mine { background:transparent; }

.mine .section-surface {
  margin-bottom:16rpx; padding:22rpx 24rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-2xl);
  background:var(--xa-color-surface-card); box-shadow:var(--xa-elev-1);
}

/* ── 身份卡 ───────────────────────────────────────────────── */
.mine .xa-button.profile {
  display:flex; align-items:center; gap:16rpx; width:100%; min-height:var(--xa-control-height);
  margin:0; padding:0; background:transparent; text-align:left; font-weight:400;
}
.profile .avatar {
  width:48px; height:48px; flex-shrink:0;
  border:1rpx solid rgba(37,99,235,.16); font-size:19px;
  box-shadow:0 0 0 6rpx rgba(37,99,235,.07);
}
.profile-copy { flex:1; min-width:0; }
.profile-name {
  display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden;
  font-size:34rpx; font-weight:700; line-height:1.3; letter-spacing:-.8rpx; overflow-wrap:anywhere;
}
.profile-id { display:block; margin-top:6rpx; font-size:21rpx; font-weight:400; line-height:1.5; color:var(--xa-color-muted); overflow-wrap:anywhere; }
.profile-arrow { width:22rpx; height:22rpx; flex-shrink:0; opacity:.45; }

.mine .xa-button.profile-tags {
  display:flex; flex-wrap:wrap; align-items:center; gap:8rpx; width:100%; min-height:56rpx;
  margin:12rpx 0 0; padding:0; background:transparent; text-align:left; font-weight:400;
}
.profile-tags .tag { max-width:100%; padding:4rpx 16rpx; border-radius:var(--xa-r-pill); font-size:21rpx; line-height:1.5; white-space:normal; overflow-wrap:anywhere; }
.profile-tags .highlighted { background:var(--xa-color-primary); color:var(--xa-color-on-primary); }
.tag-settings { display:flex; align-items:center; margin-left:auto; min-height:56rpx; font-size:21rpx; line-height:1.5; color:var(--xa-color-primary); }

.mine .xa-button.binding {
  display:flex; align-items:center; justify-content:space-between; gap:16rpx; width:100%; min-height:60rpx;
  margin-top:10rpx; padding:12rpx 0 0; border-top:1rpx solid var(--xa-hairline); border-radius:0;
  background:transparent; color:var(--xa-color-muted); font-size:21rpx; font-weight:400; line-height:1.5;
}
.binding-state, .binding-link { display:flex; align-items:center; gap:8rpx; }
.binding-state { min-width:0; }
.binding-state image { width:26rpx; height:26rpx; flex-shrink:0; }
.binding-link { flex-shrink:0; color:var(--xa-color-primary); font-weight:500; }
.binding-link image { width:22rpx; height:22rpx; opacity:.6; }

/* ── 钱包：深海渐变重点卡 ─────────────────────────────────── */
.mine .xa-button.wallet {
  position:relative; overflow:hidden;
  display:flex; align-items:center; justify-content:space-between; gap:16rpx; width:100%;
  min-height:var(--xa-control-compact); margin:0 0 16rpx; padding:26rpx;
  border:0; border-radius:var(--xa-r-2xl); background:var(--xa-grad-deep);
  text-align:left; font-weight:400; box-shadow:var(--xa-elev-3);
}
.mine .xa-button.wallet::after {
  content:''; position:absolute; top:-100rpx; right:-70rpx; width:300rpx; height:300rpx; border-radius:50%;
  background:radial-gradient(circle, rgba(56,189,248,.45), rgba(56,189,248,0) 68%); pointer-events:none;
}
.wallet-copy { position:relative; z-index:1; flex:1; min-width:0; }
.wallet-label { display:block; font-size:21rpx; letter-spacing:.8rpx; line-height:1.5; color:rgba(214,228,255,.72); }
.wallet-balance { display:flex; flex-wrap:wrap; align-items:baseline; gap:4rpx 10rpx; margin-top:6rpx; }
.wallet-value {
  min-width:0; max-width:100%; overflow-wrap:anywhere;
  color:#fff; font-size:52rpx; font-weight:700; line-height:1.15; letter-spacing:-1.6rpx;
  font-variant-numeric:tabular-nums; text-shadow:0 4rpx 20rpx rgba(2,6,23,.35);
}
.wallet-value.wallet-value-long { font-size:34rpx; }
.wallet-unit { font-size:21rpx; line-height:1.5; color:rgba(214,228,255,.72); }
.wallet-link {
  position:relative; z-index:1;
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
  min-height:64rpx; padding:0 22rpx; border-radius:var(--xa-r-pill);
  background:rgba(255,255,255,.16); color:#e6efff;
  font-size:21rpx; font-weight:600; line-height:1.5;
  box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.22);
}

/* ── 订单概览 ─────────────────────────────────────────────── */
.panel-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding-bottom:12rpx; border-bottom:1rpx solid var(--xa-hairline); }
.menu-title { font-size:28rpx; font-weight:600; line-height:1.5; letter-spacing:-.2rpx; }
.mine .xa-button.all-orders { min-height:56rpx; margin:0; padding:4rpx 0 4rpx 12rpx; background:transparent; font-size:21rpx; font-weight:500; line-height:1.5; color:var(--xa-color-primary); }
.order-counts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); padding-top:6rpx; }
.mine .order-counts .xa-button {
  width:100%; min-height:104rpx; margin:0; padding:12rpx 0;
  border-radius:var(--xa-r-md); background:transparent; text-align:center; font-weight:400;
}
.order-counts .xa-button + .xa-button { border-left:1rpx solid var(--xa-hairline); border-radius:0; }
.order-count { display:block; font-size:40rpx; font-weight:700; line-height:1.2; letter-spacing:-1rpx; color:var(--xa-color-primary); font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.order-label { display:block; margin-top:6rpx; font-size:21rpx; line-height:1.5; color:var(--xa-color-muted); }

/* ── 常用功能 ─────────────────────────────────────────────── */
.benefits { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8rpx; margin-top:16rpx; }
.mine .benefits .xa-button {
  display:flex; align-items:center; flex-direction:column; gap:10rpx; width:100%;
  min-height:var(--xa-control-compact); margin:0; padding:10rpx 0;
  border-radius:var(--xa-r-md); background:transparent;
  font-size:22rpx; font-weight:500; line-height:1.5;
}
.benefit-icon {
  display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx;
  border-radius:20rpx; background:linear-gradient(150deg,#eef4ff,#dbeafe);
  box-shadow:inset 0 0 0 1rpx rgba(37,99,235,.10);
}
.benefit-icon image { width:30rpx; height:30rpx; }

/* ── 菜单 ─────────────────────────────────────────────────── */
.mine .settings { padding:20rpx 24rpx 6rpx; }
.settings .panel-heading { margin-bottom:6rpx; }
.mine .xa-button.menu-row {
  display:flex; align-items:center; justify-content:space-between; gap:12rpx; width:100%;
  min-height:88rpx; margin:0; padding:12rpx 0; border-radius:0;
  background:transparent; text-align:left; font-size:27rpx; font-weight:400; line-height:1.4;
}
.settings .menu-row + .menu-row { border-top:1rpx solid var(--xa-hairline); }
.menu-main { display:flex; flex:1; align-items:center; gap:16rpx; min-width:0; }
.menu-main > text { min-width:0; overflow-wrap:anywhere; }
.menu-icon { width:26rpx; height:26rpx; flex-shrink:0; opacity:.8; }
.arrow-icon { width:22rpx; height:22rpx; flex-shrink:0; opacity:.4; }
.menu-note { max-width:40%; font-size:22rpx; line-height:1.5; text-align:right; color:var(--xa-color-muted); overflow-wrap:anywhere; }
.membership-note { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.points-note { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:flex-end; gap:0 4rpx; color:var(--xa-color-primary); }
.points-value { min-width:0; max-width:100%; font-weight:700; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.points-unit { flex-shrink:0; white-space:nowrap; }

/* ── 未登录 ───────────────────────────────────────────────── */
.mine .guest { padding:26rpx; background:var(--xa-grad-soft); border-radius:var(--xa-r-2xl); }
.guest-main { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.guest-copy { flex:1; min-width:0; }
.guest .title { font-size:38rpx; letter-spacing:-1rpx; }
.guest .subtitle { margin:8rpx 0 0; font-size:22rpx; line-height:1.5; }
.guest-art { display:block; width:128rpx; height:128rpx; flex-shrink:0; }
.mine .xa-button.guest-login { min-height:84rpx; margin:20rpx 0 0; padding:0 24rpx; border-radius:var(--xa-r-pill); font-size:26rpx; }
