.announcement-heading { margin-bottom:12px; }
.announcement-heading .title { display:block; font-size:24px; line-height:1.3; letter-spacing:0; }
.announcement-heading .subtitle { display:block; margin-top:4px; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.5; }
.announcement-feed { overflow:hidden; border:1px solid var(--xa-color-border); border-radius:12px; background:var(--xa-color-surface); }
.announcements-page .xa-button.announcement-card { display:flex; align-items:center; gap:8px; width:100%; min-height:var(--xa-control-compact); margin:0; padding:8px 12px; border:0; border-radius:0; background:transparent; text-align:left; font-weight:400; }
.announcements-page .announcement-card + .announcement-card { border-top:1px solid var(--xa-color-border); }
.announcement-copy { flex:1; min-width:0; }
.announcement-title-row,.announcement-time { display:flex; align-items:baseline; gap:4px; }
.announcement-pin { flex-shrink:0; padding:0 4px; border-radius:4px; background:var(--xa-color-primary-soft); color:var(--xa-color-primary); font-size:var(--xa-control-small-font); font-weight:600; line-height:16px; }
.announcement-title { display:block; flex:1; min-width:0; color:var(--xa-color-text); font-size:var(--xa-control-font); font-weight:600; line-height:20px; overflow-wrap:anywhere; }
.announcement-time { margin-top:4px; flex-wrap:wrap; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:16px; }
.announcement-arrow { width:12px; height:12px; flex-shrink:0; }
.announcement-limit { display:block; margin-top:8px; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:16px; text-align:center; }
.announcements-page .announcement-login { display:inline-flex; align-items:center; justify-content:flex-start; width:76px; min-height:var(--xa-control-compact); margin:4px 0 0; padding:0; border:0; background:transparent; }
.login-face { display:inline-flex; align-items:center; min-height:24px; padding:0 8px; border-radius:4px; color:var(--xa-color-on-primary); background:var(--xa-color-primary); font-size:var(--xa-control-small-font); line-height:16px; }
.announcement-card-hover { background:var(--xa-color-primary-soft); }
