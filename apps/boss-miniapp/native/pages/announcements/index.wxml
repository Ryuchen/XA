<view class="page announcements-page">
  <view class="section-surface announcement-heading"><view class="announcement-heading-row"><text class="title" role="heading" aria-level="1">平台公告</text><view class="announcement-heading-icon" aria-hidden="true"><image src="/assets/icons/bell.png"/></view></view><text class="subtitle">服务调整、活动与使用说明</text><button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后查看</button></view>
  <state-view wx:if="{{logged}}" loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !items.length}}" empty-text="暂无平台公告" bind:retry="load" />
  <block wx:if="{{logged}}">
    <button wx:for="{{items}}" wx:key="id" class="xa-button announcement-card {{item.is_pinned ? 'announcement-pinned' : ''}}" data-id="{{item.id}}" bindtap="open" aria-label="{{(item.is_pinned ? '置顶公告，' : '公告，') + item.title + '，发布于' + item.dateText}}" hover-class="announcement-card-hover">
      <view class="announcement-copy"><view class="announcement-title-row"><text wx:if="{{item.is_pinned}}" class="announcement-pin">置顶</text><text class="announcement-title">{{item.title}}</text></view><view class="announcement-time"><text>发布于</text><text>{{item.dateText}}</text></view></view><image class="announcement-arrow" src="/assets/icons/chevron.png" aria-hidden="true"/>
    </button>
    <text wx:if="{{items.length >= 20}}" class="section-surface announcement-limit">当前展示 20 条公告</text>
  </block>
</view>
<bottom-navigation/>
