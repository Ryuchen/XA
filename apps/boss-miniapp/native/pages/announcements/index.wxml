<view class="page announcements-page">
  <view class="announcement-heading">
    <text class="title" role="heading" aria-level="1">平台公告</text>
    <text class="subtitle">服务调整、活动与使用说明</text>
    <button wx:if="{{!logged}}" class="xa-button announcement-login" bindtap="login" hover-class="xa-button-hover"><text class="login-face">登录后查看</text></button>
  </view>
  <state-view wx:if="{{logged}}" loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !items.length}}" empty-text="暂无平台公告" bind:retry="load" />
  <view wx:if="{{logged && items.length}}" class="announcement-feed">
    <button wx:for="{{items}}" wx:key="id" class="xa-button announcement-card" data-id="{{item.id}}" bindtap="open" aria-label="{{(item.is_pinned ? '置顶公告，' : '公告，') + item.title + '，发布于' + item.dateText}}" hover-class="announcement-card-hover">
      <view class="announcement-copy">
        <view class="announcement-title-row"><text wx:if="{{item.is_pinned}}" class="announcement-pin">置顶</text><text class="announcement-title">{{item.title}}</text></view>
        <view class="announcement-time"><text>发布于</text><text>{{item.dateText}}</text></view>
      </view>
      <image class="announcement-arrow" src="/assets/icons/chevron.png" aria-hidden="true"/>
    </button>
  </view>
  <text wx:if="{{logged && items.length >= 20}}" class="announcement-limit">当前展示 20 条公告</text>
</view>
<bottom-navigation/>
