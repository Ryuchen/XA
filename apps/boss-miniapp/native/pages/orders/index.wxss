.orders-page { background:var(--xa-color-page); }
.orders-header { padding:24rpx; margin-bottom:24rpx; background:var(--xa-color-surface); border:1rpx solid var(--xa-color-border); border-radius:24rpx; }
.orders-header .title { font-size:20px; }
.orders-header .subtitle { margin-top:8rpx; font-size:var(--xa-control-small-font); line-height:1.5; }
.filter-scroll { width:100%; padding-top:16rpx; margin-top:18rpx; border-top:1rpx solid var(--xa-color-border); white-space:nowrap; }
.filters { display:inline-flex; gap:10rpx; }
.orders-page .filters .xa-button { flex-shrink:0; width:auto; min-height:30px; margin:0; padding:4px 12px; border-radius:12rpx; border-color:transparent; background:var(--xa-color-surface-subtle); font-size:var(--xa-control-small-font); font-weight:500; line-height:1.3; }
.orders-page .filters .xa-button.chip-active { color:var(--xa-color-surface); background:var(--xa-color-primary); }
.orders-page .order-card { padding:16rpx; margin-bottom:16rpx; border-radius:20rpx; }
.order-card-header { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:14rpx; }
.order-number { flex:1; min-width:0; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.status-tag { display:inline-flex; flex-shrink:0; align-items:center; justify-content:center; padding:3px 8px; border-radius:8rpx; background:var(--xa-color-primary-soft); color:var(--xa-color-primary); font-size:var(--xa-control-small-font); font-weight:600; line-height:1.3; white-space:nowrap; }
.status-PENDING { background:rgba(var(--xa-warning-rgb),.1); color:var(--xa-color-warning); }
.status-COMPLETED { background:rgba(var(--xa-success-rgb),.1); color:var(--xa-color-success); }
.status-CANCELLED { background:var(--xa-color-surface-subtle); color:var(--xa-color-muted); }
.order-main-row { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; }
.order-service { flex:1; min-width:0; }
.order-title { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; font-size:var(--xa-control-font); font-weight:600; line-height:1.35; overflow-wrap:anywhere; }
.order-meta { display:flex; align-items:center; gap:8rpx; margin-top:6rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; }
.order-provider { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.order-quantity { flex-shrink:0; padding-left:8rpx; border-left:1rpx solid var(--xa-color-border); white-space:nowrap; }
.order-amount { flex:0 0 auto; min-width:0; max-width:48%; text-align:right; }
.amount-label { display:block; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; }
.amount-price { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:flex-end; gap:4rpx; margin-top:2rpx; }
.order-price { color:var(--xa-color-primary); font-size:18px; font-weight:700; font-variant-numeric:tabular-nums; line-height:1.25; white-space:nowrap; }
.amount-unit { color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; white-space:nowrap; }
.order-created { display:block; margin-top:8rpx; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; }
.lottery-result { display:flex; align-items:baseline; gap:8rpx; margin-top:10rpx; padding:8rpx 12rpx; border-radius:10rpx; background:var(--xa-color-primary-soft); color:var(--xa-color-primary); font-size:var(--xa-control-small-font); line-height:1.4; }
.lottery-label { flex-shrink:0; }
.lottery-name { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.order-card-actions { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-height:26px; padding-top:10rpx; margin-top:10rpx; border-top:1rpx solid var(--xa-color-border); }
.order-progress { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); line-height:1.4; }
.order-progress.needs-review { color:var(--xa-color-primary); font-weight:500; }
.detail-link { display:flex; flex-shrink:0; align-items:center; gap:4rpx; color:var(--xa-color-primary); font-size:var(--xa-control-small-font); line-height:1.4; }
.detail-link image { width:12px; height:12px; }
.order-empty-actions { padding:16rpx; margin-bottom:0; border-radius:20rpx; }
.orders-page .xa-button.browse { min-height:36px; margin:0; padding:6px 12px; border-radius:12rpx; font-size:var(--xa-control-small-font); }
.order-card-hover { opacity:.82; }
@media (prefers-reduced-motion:reduce) { .order-card-hover { opacity:1; } }
