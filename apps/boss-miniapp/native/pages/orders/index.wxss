/* 订单列表 · 澄海 2026
   筛选胶囊 + 抬升订单卡；状态用语义色胶囊带圆点，金额单独成列。 */
.orders-page { background:transparent; }

.orders-header {
  padding:26rpx; margin-bottom:24rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-2xl);
  background:var(--xa-color-surface-card); box-shadow:var(--xa-elev-1);
}
.orders-header .title { font-size:40rpx; letter-spacing:-1.2rpx; }
.orders-header .subtitle { margin-top:8rpx; font-size:23rpx; line-height:1.5; }

.filter-scroll { width:100%; margin-top:20rpx; padding-top:18rpx; border-top:1rpx solid var(--xa-hairline); white-space:nowrap; }
.filters { display:inline-flex; gap:12rpx; }
.orders-page .filters .xa-button {
  flex-shrink:0; width:auto; min-height:64rpx; height:64rpx; margin:0; padding:0 26rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-pill);
  background:var(--xa-color-surface-card); color:var(--xa-color-text-secondary);
  font-size:24rpx; font-weight:600; line-height:1.3;
}
.orders-page .filters .xa-button.chip-active {
  border-color:transparent; color:var(--xa-color-on-primary);
  background:var(--xa-color-primary); box-shadow:0 8px 16px -10px rgba(37,99,235,.9);
}

.order-type-filter { margin-top:12rpx; }
.orders-page .order-type-filter .gift-filter {
  width:auto; min-height:60rpx; height:60rpx; margin:0; padding:0 24rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-pill);
  background:#f5f8fd; color:var(--xa-color-muted); font-size:22rpx; font-weight:500; line-height:1.3;
}
.orders-page .order-type-filter .gift-filter-active {
  color:var(--xa-color-primary-hover); border-color:rgba(37,99,235,.4); background:rgba(37,99,235,.08);
}

/* ── 订单卡 ───────────────────────────────────────────────── */
.orders-page .order-card {
  padding:22rpx; margin-bottom:16rpx; border-radius:var(--xa-r-xl);
  border:1rpx solid var(--xa-hairline); box-shadow:var(--xa-elev-1);
  transition:box-shadow var(--xa-motion-base), transform var(--xa-motion-fast), border-color var(--xa-motion-base);
}
.order-card-header { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:16rpx; }
.order-number {
  flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  font-family:var(--xa-font-mono); font-size:22rpx; letter-spacing:.4rpx; color:var(--xa-color-muted);
}
.status-tag {
  display:inline-flex; flex-shrink:0; align-items:center; gap:8rpx;
  padding:5rpx 16rpx; border-radius:var(--xa-r-pill);
  background:rgba(37,99,235,.09); color:var(--xa-color-primary-hover);
  font-size:22rpx; font-weight:600; line-height:1.35; white-space:nowrap;
}
.status-tag::before { content:''; width:8rpx; height:8rpx; border-radius:50%; background:currentColor; opacity:.85; }
.status-PENDING { background:rgba(var(--xa-warning-rgb),.11); color:var(--xa-color-warning); }
.status-COMPLETED { background:rgba(var(--xa-success-rgb),.11); color:var(--xa-color-success); }
.status-CANCELLED { background:#f1f3f7; color:var(--xa-color-muted); }
.status-CANCELLED::before { opacity:.5; }

.order-main-row { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; }
.order-service { flex:1; min-width:0; }
.order-title {
  display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden;
  font-size:30rpx; font-weight:600; line-height:1.35; letter-spacing:-.4rpx; overflow-wrap:anywhere;
}
.order-meta { display:flex; align-items:center; gap:8rpx; margin-top:8rpx; font-size:22rpx; line-height:1.4; color:var(--xa-color-muted); }
.order-provider { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.order-quantity { flex-shrink:0; padding-left:8rpx; border-left:1rpx solid var(--xa-hairline); white-space:nowrap; }
.order-amount { flex:0 0 auto; min-width:0; max-width:48%; text-align:right; }
.amount-label { display:block; font-size:21rpx; line-height:1.4; color:var(--xa-color-muted); }
.amount-price { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:flex-end; gap:4rpx; margin-top:2rpx; }
.order-price { color:var(--xa-color-primary); font-size:38rpx; font-weight:700; font-variant-numeric:tabular-nums; letter-spacing:-1rpx; line-height:1.2; white-space:nowrap; }
.amount-unit { color:var(--xa-color-muted); font-size:20rpx; line-height:1.4; white-space:nowrap; }
.order-created { display:block; margin-top:8rpx; font-size:22rpx; line-height:1.4; color:var(--xa-color-muted); }

.lottery-result {
  display:flex; align-items:baseline; gap:8rpx; margin-top:12rpx; padding:10rpx 16rpx;
  border-radius:var(--xa-r-sm); background:rgba(37,99,235,.07); color:var(--xa-color-primary-hover);
  font-size:22rpx; line-height:1.4;
}
.lottery-label { flex-shrink:0; opacity:.8; }
.lottery-name { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:600; }

.order-card-actions {
  display:flex; align-items:center; justify-content:space-between; gap:16rpx;
  min-height:56rpx; margin-top:14rpx; padding-top:14rpx; border-top:1rpx solid var(--xa-hairline);
}
.order-progress { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:22rpx; line-height:1.4; color:var(--xa-color-muted); }
.order-progress.needs-review { color:var(--xa-color-primary); font-weight:600; }
.detail-link { display:flex; flex-shrink:0; align-items:center; gap:4rpx; font-size:22rpx; font-weight:600; line-height:1.4; color:var(--xa-color-primary); }
.detail-link image { width:22rpx; height:22rpx; opacity:.7; }

.order-empty-actions { padding:16rpx; margin-bottom:0; border-radius:var(--xa-r-xl); }
.orders-page .xa-button.browse { min-height:80rpx; margin:0; padding:0 24rpx; border-radius:var(--xa-r-pill); font-size:26rpx; }

.orders-page .order-card.order-card-hover { transform:translate3d(0,-2rpx,0); box-shadow:var(--xa-elev-2); border-color:var(--xa-hairline-strong); }
@media (prefers-reduced-motion:reduce) { .orders-page .order-card.order-card-hover { transform:none; } .orders-page .order-card { transition:none; } }
