/* 订单列表 · 澄海 App 基线
   页头不再套卡：标题、筛选和列表落在同一张页面底色上，卡片才有分量。
   状态是语义色胶囊带圆点，金额单独成列右对齐。 */

.orders-page { background: transparent; }

.orders-header { padding: 0; margin-bottom: var(--xa-s-4); border: 0; background: transparent; box-shadow: none; }
.orders-header .title { font-size: var(--xa-fs-h1); letter-spacing: -1rpx; }
.orders-header .subtitle { margin-top: 6rpx; }

.filter-scroll { width: 100%; margin-top: var(--xa-s-4); white-space: nowrap; }
.filters { display: inline-flex; gap: var(--xa-s-2); }
.orders-page .filters .xa-button {
  flex-shrink: 0; width: auto; min-height: 68rpx; height: 68rpx; margin: 0; padding: 0 26rpx;
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-pill);
  background: var(--xa-color-surface-card); color: var(--xa-color-text-secondary);
  font-size: var(--xa-fs-sub); font-weight: 600; line-height: 1.3;
  transition: background-color var(--xa-motion-fast), color var(--xa-motion-fast), transform var(--xa-press);
}
.orders-page .filters .xa-button.chip-active {
  border-color: transparent; color: var(--xa-color-on-primary);
  background: var(--xa-color-primary); box-shadow: 0 8px 16px -10px rgba(37, 99, 235, .9);
}

.order-type-filter { display: flex; justify-content: flex-start; margin-top: 12rpx; }
.orders-page .order-type-filter .gift-filter {
  width: auto; min-height: 60rpx; height: 60rpx; margin: 0; padding: 0 22rpx;
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-pill);
  background: transparent; color: var(--xa-color-muted);
  font-size: var(--xa-fs-cap); font-weight: 500; line-height: 1.3;
}
.orders-page .order-type-filter .gift-filter-active {
  color: var(--xa-color-primary-hover); border-color: rgba(37, 99, 235, .32); background: rgba(37, 99, 235, .07);
}

/* ── 订单卡 ───────────────────────────────────────────────── */
.orders-page .order-card {
  padding: 22rpx; margin-bottom: var(--xa-s-3); border-radius: var(--xa-r-xl);
  border: 1rpx solid var(--xa-hairline); box-shadow: var(--xa-elev-1);
  transition: box-shadow var(--xa-motion-base), transform var(--xa-press), border-color var(--xa-motion-base);
}
.order-card-header { display: flex; align-items: center; justify-content: space-between; gap: var(--xa-s-3); margin-bottom: 14rpx; }
.order-number {
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-family: var(--xa-font-mono); font-size: var(--xa-fs-cap);
  letter-spacing: .2rpx; color: var(--xa-color-muted);
}
.status-tag {
  display: inline-flex; flex-shrink: 0; align-items: center; gap: 10rpx;
  padding: 5rpx 16rpx; border-radius: var(--xa-r-pill);
  background: rgba(37, 99, 235, .08); color: var(--xa-color-primary-hover);
  font-size: var(--xa-fs-cap); font-weight: 600; line-height: var(--xa-lh-cap); white-space: nowrap;
}
.status-tag::before { content: ''; width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; opacity: .9; }
.status-PENDING { background: rgba(var(--xa-warning-rgb), .1); color: var(--xa-color-warning); }
.status-COMPLETED { background: rgba(var(--xa-success-rgb), .1); color: var(--xa-color-success); }
.status-CANCELLED { background: #f1f3f7; color: var(--xa-color-muted); }
.status-CANCELLED::before { opacity: .45; }

.order-main-row { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--xa-s-4); }
.order-service { flex: 1; min-width: 0; }
.order-title {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
  font-size: var(--xa-fs-strong); font-weight: 600; line-height: var(--xa-lh-strong);
  letter-spacing: -.3rpx; overflow-wrap: anywhere;
}
.order-meta {
  display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx;
  font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted);
}
.order-provider { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.order-quantity { flex-shrink: 0; padding-left: 8rpx; border-left: 1rpx solid var(--xa-hairline); white-space: nowrap; }
.order-amount { flex: 0 0 auto; min-width: 0; max-width: 46%; text-align: right; }
.amount-label { display: block; font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted); }
.amount-price { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: flex-end; gap: 4rpx; margin-top: 4rpx; }
.order-price {
  color: var(--xa-color-primary); font-size: var(--xa-fs-h1); font-weight: 700;
  font-variant-numeric: tabular-nums; letter-spacing: -.8rpx; line-height: 1.15; white-space: nowrap;
}
.amount-unit { color: var(--xa-color-muted); font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); white-space: nowrap; }
.order-created { display: block; margin-top: 10rpx; font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted); }

.lottery-result {
  display: flex; align-items: baseline; gap: 8rpx; margin-top: 12rpx; padding: 10rpx 16rpx;
  border-radius: var(--xa-r-sm); background: rgba(37, 99, 235, .06); color: var(--xa-color-primary-hover);
  font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap);
}
.lottery-label { flex-shrink: 0; opacity: .75; }
.lottery-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }

.order-card-actions {
  display: flex; align-items: center; justify-content: space-between; gap: var(--xa-s-3);
  min-height: 56rpx; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid var(--xa-hairline);
}
.order-progress {
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: var(--xa-fs-cap); line-height: var(--xa-lh-cap); color: var(--xa-color-muted);
}
.order-progress.needs-review { color: var(--xa-color-primary); font-weight: 600; }
.detail-link {
  display: flex; flex-shrink: 0; align-items: center; gap: 4rpx;
  font-size: var(--xa-fs-cap); font-weight: 600; line-height: var(--xa-lh-cap); color: var(--xa-color-primary);
}
.detail-link image { width: 20rpx; height: 20rpx; opacity: .6; }

.order-empty-actions { padding: var(--xa-s-3); margin-bottom: 0; border-radius: var(--xa-r-xl); }
.orders-page .xa-button.browse { min-height: 80rpx; margin: 0; padding: 0 24rpx; border-radius: var(--xa-r-pill); font-size: var(--xa-fs-body); }

.orders-page .order-card.order-card-hover { transform: scale(.988); box-shadow: var(--xa-elev-2); border-color: var(--xa-hairline-strong); }
@media (prefers-reduced-motion: reduce) {
  .orders-page .order-card.order-card-hover { transform: none; }
  .orders-page .order-card { transition: none; }
}
