<view class="page orders-page">
  <view class="orders-header">
    <text class="title">我的订单</text>
    <text class="subtitle">服务进度与每一笔消费，随时可查</text>
    <scroll-view wx:if="{{logged}}" scroll-x class="filter-scroll"><view class="filters"><button wx:for="{{tabs}}" wx:key="value" class="xa-button chip {{filter === item.value ? 'chip-active' : ''}}" data-value="{{item.value}}" bindtap="filter" hover-class="xa-button-hover">{{item.name}}</button></view></scroll-view>
  </view>
  <button wx:if="{{!logged}}" class="xa-button button" bindtap="login" hover-class="xa-button-hover">登录后查看订单</button>
  <block wx:else>
    <state-view loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-text="还没有这类订单" bind:retry="load"/>
    <view class="panel order-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <view class="between order-card-header"><text class="muted small order-number">{{item.order_no}}</text><text class="tag status-{{item.status}}">{{item.statusText}}</text></view>
      <view class="order-card-body">
        <text class="order-title">{{item.service.name}}</text>
        <text class="muted small order-provider">{{item.provider ? item.provider.nickname : '平台安排陪玩'}} · {{item.game_rounds}} 份</text>
        <view class="between footer"><text class="muted small">{{item.createdText}}</text><text class="price">{{item.amountText}}<text class="small"> 兴安币</text></text></view>
        <view wx:if="{{item.roulette_result}}" class="lottery-result">抽签结果：{{item.roulette_result.name}}</view>
      </view>
      <view class="between order-card-actions"><text class="muted small">{{item.canEvaluate ? '本次服务待评价' : item.fulfillment}}</text><text class="link">查看详情 ›</text></view>
    </view>
    <button wx:if="{{!loading && !error && !items.length}}" class="xa-button button-secondary" bindtap="catalog" hover-class="xa-button-hover">去选择服务</button>
  </block>
</view>
