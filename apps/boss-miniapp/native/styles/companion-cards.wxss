/* 陪玩卡（列表与选择器共用）· 澄海 2026
   封面抬高一层、名字与接单额分层，信息保持完整不裁切。 */
.companion-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.page .xa-button.companion-card {
  display: block; width: 100%; min-width: 0; margin: 0; padding: 12rpx 14rpx 18rpx;
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-xl);
  background: var(--xa-color-surface-card); text-align: left; white-space: normal; overflow: hidden;
  box-shadow: var(--xa-elev-1);
  transition: box-shadow var(--xa-motion-base), transform var(--xa-motion-fast), border-color var(--xa-motion-base);
}
.page .xa-button.companion-card.xa-button-hover {
  transform: translate3d(0, -2rpx, 0);
  border-color: var(--xa-hairline-strong);
  box-shadow: var(--xa-elev-2);
}
.companion-portrait { position: relative; width: 100%; }
.companion-avatar {
  display: block; width: 100%; height: 176rpx; border-radius: var(--xa-r-md);
  background: linear-gradient(150deg, #eef4ff, #dbeafe);
}
.companion-initial { display: flex; align-items: center; justify-content: center; color: var(--xa-color-primary); font-size: 56rpx; font-weight: 500; }
.companion-badge {
  position: absolute; top: 10rpx; left: 10rpx; padding: 3rpx 12rpx; border-radius: var(--xa-r-pill);
  background: rgba(15, 23, 42, .72); color: #fff; font-size: 20rpx; font-weight: 600;
}
.companion-name {
  display: block; margin-top: 14rpx; font-size: 30rpx; font-weight: 600; line-height: 1.35;
  letter-spacing: -.4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.companion-level { display: block; margin-top: 4rpx; font-size: 21rpx; font-weight: 400; line-height: 1.4; color: var(--xa-color-muted); overflow-wrap: anywhere; }
.companion-monthly { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid var(--xa-hairline); }
.companion-monthly-label { display: block; font-size: 20rpx; font-weight: 400; line-height: 1.4; color: var(--xa-color-muted); }
.companion-monthly-value {
  display: block; margin-top: 2rpx; font-size: 28rpx; font-weight: 700; line-height: 1.35;
  letter-spacing: -.4rpx; color: var(--xa-color-primary); font-variant-numeric: tabular-nums; overflow-wrap: anywhere;
}
.companion-monthly-unit { color: var(--xa-color-muted); font-size: 20rpx; font-weight: 400; }
