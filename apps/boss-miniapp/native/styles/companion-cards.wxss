/* 陪玩卡（列表与选择器共用）· 澄海 App 基线
   图片贴卡边、信息压在下方；接单额单独成行，用分隔线止住视觉重量。 */

.companion-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--xa-s-3); }

.page .xa-button.companion-card {
  display: block; width: 100%; min-width: 0; margin: 0; padding: 0 0 16rpx;
  border: 1rpx solid var(--xa-hairline); border-radius: var(--xa-r-lg);
  background: var(--xa-color-surface-card); text-align: left; white-space: normal; overflow: hidden;
  box-shadow: var(--xa-elev-1);
  transition: box-shadow var(--xa-motion-base), transform var(--xa-press), border-color var(--xa-motion-base);
}
.page .xa-button.companion-card.xa-button-hover {
  transform: scale(.982);
  border-color: var(--xa-hairline-strong);
  box-shadow: var(--xa-elev-2);
}

.companion-portrait { position: relative; width: 100%; }
.companion-avatar {
  display: block; width: 100%; height: 224rpx;
  background: linear-gradient(152deg, #e8f0fd, #c9dcf7);
}
.companion-initial {
  display: flex; align-items: center; justify-content: center;
  color: var(--xa-color-primary); font-size: 48rpx; font-weight: 600;
}
.companion-badge {
  position: absolute; top: 12rpx; left: 12rpx; padding: 4rpx 12rpx; border-radius: var(--xa-r-pill);
  background: rgba(10, 16, 32, .66); color: #fff;
  font-size: var(--xa-fs-cap); font-weight: 600; line-height: 1.3;
}

.companion-name {
  display: block; margin: 14rpx 20rpx 0; font-size: var(--xa-fs-strong); font-weight: 600;
  line-height: var(--xa-lh-strong); letter-spacing: -.3rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.companion-level {
  display: block; margin: 2rpx 20rpx 0; font-size: var(--xa-fs-cap); font-weight: 400;
  line-height: var(--xa-lh-cap); color: var(--xa-color-muted);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.companion-monthly { margin: 12rpx 20rpx 0; padding-top: 12rpx; border-top: 1rpx solid var(--xa-hairline); }
.companion-monthly-label { display: block; font-size: var(--xa-fs-cap); font-weight: 400; line-height: 1.35; color: var(--xa-color-muted); }
.companion-monthly-value {
  display: block; margin-top: 2rpx; font-size: var(--xa-fs-body); font-weight: 700; line-height: 1.3;
  letter-spacing: -.3rpx; color: var(--xa-color-primary); font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.companion-monthly-unit { color: var(--xa-color-muted); font-size: var(--xa-fs-cap); font-weight: 400; }
