.companion-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.page .xa-button.companion-card { display: block; width: 100%; min-width: 0; margin: 0; padding: 12rpx 12rpx 16rpx; border: 1rpx solid var(--xa-color-border); border-radius: var(--xa-radius); background: var(--xa-color-surface); text-align: left; white-space: normal; overflow: hidden; }
.companion-portrait { position: relative; width: 100%; }
.companion-avatar { display: block; width: 100%; height: 164rpx; border-radius: 12rpx; background: var(--xa-color-primary-soft); }
.companion-initial { display: flex; align-items: center; justify-content: center; color: var(--xa-color-primary); font-size: 56rpx; font-weight: 500; }
.companion-badge { position: absolute; top: 8rpx; left: 8rpx; padding: 2rpx 10rpx; border-radius: 10rpx; background: var(--xa-color-primary); color: var(--xa-color-surface); font-size: var(--xa-control-small-font); font-weight: 500; }
.companion-name { display: block; margin-top: 10rpx; font-size: var(--xa-control-font); font-weight: 600; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.companion-level { display: block; margin-top: 4rpx; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); font-weight: 400; line-height: 1.4; overflow-wrap: anywhere; }
.companion-monthly { margin-top: 8rpx; padding-top: 8rpx; border-top: 1rpx solid var(--xa-color-border); }
.companion-monthly-label { display: block; color: var(--xa-color-muted); font-size: var(--xa-control-small-font); font-weight: 400; line-height: 1.4; }
.companion-monthly-value { display: block; margin-top: 2rpx; color: var(--xa-color-primary); font-size: var(--xa-control-font); font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.companion-monthly-unit { color: var(--xa-color-muted); font-size: var(--xa-control-small-font); font-weight: 400; }
