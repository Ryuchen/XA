@import "./theme.wxss";

/* Shared ocean blues with compact native controls and clear mobile hierarchy. */
page {
  --xa-color-page: var(--xa-color-surface-page);
  --xa-color-surface: var(--xa-color-surface-card);
  --xa-color-text: var(--xa-color-text-primary);
  --xa-color-muted: var(--xa-color-text-secondary);
  --xa-radius: 24rpx;
  --xa-radius-control: 16rpx;
  /* Keep controls optically stable on large phones; page layout still uses rpx. */
  --xa-control-height: 44px;
  --xa-input-height: 44px;
  --xa-control-secondary: 44px;
  --xa-control-compact: 44px;
  --xa-control-font: 14px;
  --xa-control-small-font: 12px;
  --xa-icon-small: 16px;
  --xa-icon-medium: 18px;
  --xa-icon-feature: 20px;
  --xa-navigation-height: 56px;
  --xa-navigation-inset: calc(var(--xa-navigation-height) + env(safe-area-inset-bottom));
  background: var(--xa-color-page); color: var(--xa-color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx; line-height: 1.6;
}
view, text, .xa-button, input, textarea, scroll-view, image { box-sizing: border-box; }
input, textarea { font-family: inherit; }
.page { padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.page-heading, .section-surface { padding: 24rpx; margin-bottom: 24rpx; background: var(--xa-color-surface); border: 1rpx solid var(--xa-color-surface-subtle); border-radius: 24rpx; }
.page-heading > .subtitle { margin-bottom: 0; }
.title { display: block; font-size: 38rpx; font-weight: 700; line-height: 1.35; letter-spacing: -1rpx; overflow-wrap: anywhere; }
.eyebrow { display: block; color: var(--xa-color-primary); font-size: 23rpx; font-weight: 500; margin-bottom: 8rpx; }
.subtitle { display: block; color: var(--xa-color-muted); margin-top: 16rpx; font-size: 26rpx; line-height: 1.7; overflow-wrap: anywhere; }
.section-title { display: block; font-size: 31rpx; font-weight: 600; line-height: 1.5; margin: 32rpx 0 16rpx; overflow-wrap: anywhere; }
.panel .section-title, .card .section-title { margin: 0 0 16rpx; font-size: 30rpx; }
.row, .between { display: flex; align-items: center; gap: 16rpx; }
.between { justify-content: space-between; }
.row > view, .between > view { min-width: 0; }
.row > .xa-button, .between > .xa-button { flex-shrink: 0; }
.between > text:first-child { min-width: 0; overflow-wrap: anywhere; }
.stack { display: flex; flex-direction: column; gap: 24rpx; }
/* Override style:v2 defaults (184px width and auto horizontal margins).
   Keep page-specific layout rules equally specific so each control can size itself. */
.page .xa-button, .bottom-bar .xa-button, .chat-page .xa-button, .gift-footer .xa-button, .benefit-dialog .xa-button {
  display: block;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  font-family: inherit;
  font-size: var(--xa-control-font);
  font-weight: 600;
  line-height: 1.5;
  border-radius: var(--xa-radius-control);
  color: var(--xa-color-text);
}
.panel, .card, .panel.xa-button, .card.xa-button { background: var(--xa-color-surface); border: 1rpx solid var(--xa-color-border); border-radius: var(--xa-radius); padding: 24rpx; margin-bottom: 24rpx; }
.muted { color: var(--xa-color-muted); }
.small { font-size: 24rpx; font-weight: 400; }
.price { color: var(--xa-color-primary); font-size: 38rpx; font-weight: 650; line-height: 1.4; font-variant-numeric: tabular-nums; white-space: nowrap; }
.tag { display: inline-flex; align-items: center; flex-shrink: 0; font-size: 22rpx; font-weight: 500; line-height: 1.5; padding: 8rpx 16rpx; border-radius: 10rpx; color: var(--xa-color-primary); background: var(--xa-color-primary-soft); }
.xa-button::after { border: none; }
.xa-button.button, .xa-button.button-secondary, .xa-button.button-quiet { display: flex; align-items: center; justify-content: center; min-height:var(--xa-control-height); padding: 16rpx 24rpx; font-size:var(--xa-control-font); border-radius: var(--xa-radius-control); width: 100%; margin: 16rpx 0 0; white-space: normal; }
.xa-button.button { color: var(--xa-color-surface); background: var(--xa-color-primary); }
.xa-button.button-secondary { min-height: var(--xa-control-secondary); color: var(--xa-color-primary); background: var(--xa-color-primary-soft); font-weight: 500; }
.xa-button.button-quiet { min-height: var(--xa-control-secondary); color: var(--xa-color-muted); background: transparent; font-weight: 400; }
.page .xa-button[disabled], .bottom-bar .xa-button[disabled], .chat-page .xa-button[disabled], .gift-footer .xa-button[disabled] { background: var(--xa-color-surface-subtle); color: var(--xa-color-muted); }
.xa-button-hover { opacity: .78; }
.field { margin: 24rpx 0; }
.field:first-child { margin-top: 0; }.field:last-child { margin-bottom: 0; }
.label { display: block; font-size: var(--xa-control-font); font-weight: 500; margin-bottom: 16rpx; }
.input { border: 1rpx solid var(--xa-color-surface-subtle); background: var(--xa-color-surface-subtle); border-radius: var(--xa-radius-control); padding: 16rpx 24rpx; min-height:var(--xa-input-height); width: 100%; font-size:var(--xa-control-font); color: var(--xa-color-text); }
input.input { height: var(--xa-input-height); padding: 0 24rpx; font-family: inherit; line-height: 1.5; }
textarea.input { height: max(152rpx, 76px); line-height: 1.65; }
.input-placeholder { color: var(--xa-color-muted); font-family: inherit; font-weight: 400; font-size: 13px; }
.input:focus { border-color: var(--xa-color-primary); }
.error { display: block; color: var(--xa-color-danger); padding: 24rpx 0; font-size: 26rpx; overflow-wrap: anywhere; }
.empty, .loading { text-align: center; padding: 48rpx 24rpx; color: var(--xa-color-muted); }
.divider { height: 1rpx; background: var(--xa-color-border); margin: 24rpx 0; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 24rpx 0; }
.xa-button.chip { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; min-height: var(--xa-control-compact); padding: 8rpx 16rpx; border-radius: 12rpx; color: var(--xa-color-muted); background: var(--xa-color-surface); border: 1rpx solid var(--xa-color-border); font-size: var(--xa-control-small-font); font-weight: 400; width: auto; margin: 0; }
.xa-button.chip-active { color: var(--xa-color-primary); border-color: var(--xa-color-primary-soft); background: var(--xa-color-primary-soft); font-weight: 600; }
.cover { width: 100%; height: 320rpx; border-radius: 20rpx; background: var(--xa-color-primary-soft); }
.avatar { width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 50%; background: var(--xa-color-primary-soft); }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; color: var(--xa-color-primary); font-weight: 600; }
.bottom-bar { position: fixed; z-index: 10; left: 0; right: 0; bottom: var(--xa-navigation-inset); padding: 16rpx 32rpx; background: var(--xa-color-surface); border-top: 1rpx solid var(--xa-color-border); }
.bottom-bar .xa-button { margin-top: 0; }
.link { color: var(--xa-color-primary); font-size: 25rpx; }
.menu-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 104rpx; padding: 24rpx 0; }
.menu-row + .menu-row { border-top: 1rpx solid var(--xa-color-border); }
.menu-row > text:first-child { flex-shrink: 0; }.menu-row > text:last-child { text-align: right; min-width: 0; overflow-wrap: anywhere; }
.menu-row .arrow { color: var(--xa-color-muted); font-size: 32rpx; }
.between > .xa-button.button-quiet { width: auto; margin: 0; min-height:var(--xa-control-secondary); flex-shrink: 0; padding: 16rpx 8rpx; }
.ui-icon { width: var(--xa-icon-medium); height: var(--xa-icon-medium); flex-shrink: 0; }
@media (prefers-reduced-motion: reduce) { .xa-button-hover { opacity: 1; } }

/* Ocean / milk: native touch feedback, linked selections and quiet page entry. */
.page .panel, .page .card, .page .page-heading, .page .section-surface { box-shadow:var(--xa-shadow-card); }
.page .xa-button, .bottom-bar .xa-button { transition:background-color var(--xa-motion-fast),border-color var(--xa-motion-fast),box-shadow var(--xa-motion-fast),transform var(--xa-motion-fast); }
.page .xa-button-hover, .bottom-bar .xa-button-hover { opacity:.84; transform:scale(.985); }
.page .xa-button[disabled] { transform:none; box-shadow:none; }
.page .xa-button.chip-active, .page .xa-button.shortcut-selected, .page .xa-button.provider-selected { border-color:var(--xa-color-primary); box-shadow:0 0 0 2rpx var(--xa-color-primary-soft); }
.page .service-tab { position:relative; min-height:44px; }
.page .service-tab::after { content:''; position:absolute; bottom:4rpx; left:24rpx; right:24rpx; height:4rpx; border-radius:4rpx; background:var(--xa-color-primary); transform:scaleX(0); transition:transform var(--xa-motion-base); }
.page .service-tab.active::after { transform:scaleX(1); }
.page .service-card { transition:box-shadow var(--xa-motion-base),border-color var(--xa-motion-base),transform var(--xa-motion-fast); }
.page .service-card.xa-button-hover { box-shadow:var(--xa-shadow-float); border-color:var(--xa-color-primary); }
.page .results-head { position:sticky; top:0; z-index:8; border-bottom:2rpx solid var(--xa-color-border); background:var(--xa-color-surface-card); }
.page .service-tabs, .page .filter-scroll { -webkit-overflow-scrolling:touch; scroll-snap-type:x proximity; }
.page .service-tab, .page .filter-scroll .chip { scroll-snap-align:start; }
.page .picker-selection-hint, .page .selection-hint { padding:16rpx 20rpx; border-radius:16rpx; background:var(--xa-color-primary-soft); }
.bottom-bar { box-shadow:0 -8rpx 32rpx rgba(var(--xa-primary-rgb),.06); }
.page .help-section { display:flex; flex-direction:column; gap:8rpx; margin:0 0 28rpx; }
.page .help-label { font-weight:650; color:var(--xa-color-primary); }
.page .balance-warning, .page .quote-error, .page .pending-order-warning { border-left:4rpx solid var(--xa-color-warning); }
@keyframes ocean-native-enter { from { opacity:.35; } to { opacity:1; } }
.page { animation:ocean-native-enter 250ms var(--xa-ease-out); }
@media(prefers-reduced-motion:reduce) { .page,.page .xa-button,.bottom-bar .xa-button,.page .service-tab::after { animation:none; transition:none; }.page .xa-button-hover,.bottom-bar .xa-button-hover { transform:none; } }

/* ══════════════════════════════════════════════════════════════
   澄海 2026 · 原生视觉层
   只做视觉补充：形状 / 海拔 / 玻璃 / 渐变令牌，以及基础控件重绘。
   不改变业务结构、接口与交互逻辑；theme.wxss 由脚本生成，此处仅覆盖。
   ══════════════════════════════════════════════════════════════ */
page {
  /* 形状 — 4pt 节奏，向更柔和的 Apple 圆角靠拢 */
  --xa-radius: 20px;
  --xa-radius-card: 20px;
  --xa-radius-control: 12px;
  --xa-r-xs: 8px;
  --xa-r-sm: 12px;
  --xa-r-md: 16px;
  --xa-r-lg: 20px;
  --xa-r-xl: 24px;
  --xa-r-2xl: 28px;
  --xa-r-pill: 999rpx;

  /* 海拔 — 蓝调投影，替代中性灰，让奶白表面有空气感 */
  --xa-elev-1: 0 1px 2px rgba(15, 23, 42, .04), 0 8px 20px -10px rgba(30, 58, 138, .16);
  --xa-elev-2: 0 1px 3px rgba(15, 23, 42, .05), 0 16px 34px -14px rgba(30, 58, 138, .22);
  --xa-elev-3: 0 2px 8px rgba(15, 23, 42, .06), 0 28px 52px -18px rgba(30, 58, 138, .30);

  /* 描边 — 冷调细线，代替纯灰边 */
  --xa-hairline: rgba(30, 58, 138, .09);
  --xa-hairline-strong: rgba(30, 58, 138, .14);

  /* 玻璃 — 底部操作区与浮层 */
  --xa-glass-bg: rgba(255, 254, 250, .82);
  --xa-glass-blur: saturate(180%) blur(20px);
  --xa-glass-line: rgba(255, 255, 255, .55);

  /* 渐变 — 深海 → 品牌蓝 → 浅海 */
  --xa-grad-deep: linear-gradient(142deg, #0b1220 0%, #14275c 44%, #1e3a8a 100%);
  --xa-grad-brand: linear-gradient(142deg, #1e3a8a 0%, #2563eb 58%, #38bdf8 100%);
  --xa-grad-cta: linear-gradient(135deg, #2f6bf0 0%, #2154d8 52%, #1e3a8a 100%);
  --xa-grad-soft: linear-gradient(155deg, #ffffff 0%, #f3f7ff 60%, #e9f1fe 100%);
  --xa-grad-card: linear-gradient(178deg, #ffffff 0%, #fffefa 62%, #fcfdff 100%);
  --xa-ring-primary: 0 0 0 4rpx rgba(37, 99, 235, .14);
}

/* ── 表面：柔和圆角 + 双色描边 + 蓝调海拔 ───────────────────── */
.panel, .card, .page-heading, .section-surface {
  border-radius: var(--xa-radius);
  border: 1rpx solid var(--xa-hairline);
  background: var(--xa-color-surface-card);
}
.page .panel, .page .card, .page .page-heading, .page .section-surface {
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .9), var(--xa-elev-1);
}

/* ── 标题与文字层级 ───────────────────────────────────────── */
.title { letter-spacing: -1.2rpx; }
.section-title { font-weight: 600; letter-spacing: -.4rpx; }
.eyebrow { font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.price { letter-spacing: -.6rpx; font-weight: 700; }

/* ── 按钮：主操作用品牌渐变，次操作用浅蓝面 ─────────────────── */
.xa-button.button {
  color: var(--xa-color-on-primary);
  background: var(--xa-grad-cta);
  letter-spacing: .6rpx;
  box-shadow: 0 10px 22px -12px rgba(37, 99, 235, .75), inset 0 1rpx 0 rgba(255, 255, 255, .22);
}
.xa-button.button-secondary {
  color: var(--xa-color-primary-hover);
  background: rgba(37, 99, 235, .07);
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, .14);
}
.page .xa-button.button-hover, .bottom-bar .xa-button.button-hover { opacity: 1; }
.page .xa-button-hover { opacity: 1; }

/* ── 胶囊筛选与标签 ────────────────────────────────────────── */
.page .xa-button.chip {
  border-radius: var(--xa-r-pill);
  border-color: var(--xa-hairline);
  background: var(--xa-color-surface-card);
  padding: 8rpx 24rpx;
}
.page .xa-button.chip-active {
  color: var(--xa-color-on-primary);
  border-color: transparent;
  background: var(--xa-color-primary);
  box-shadow: 0 8px 16px -10px rgba(37, 99, 235, .9);
}
.tag {
  border-radius: var(--xa-r-pill);
  padding: 6rpx 16rpx;
  background: rgba(37, 99, 235, .08);
  color: var(--xa-color-primary-hover);
}

/* ── 输入：白底细描边，聚焦时浮起 ───────────────────────────── */
.input {
  border: 1rpx solid var(--xa-hairline-strong);
  background: var(--xa-color-surface-card);
  border-radius: var(--xa-radius-control);
}
.input:focus {
  border-color: rgba(37, 99, 235, .5);
  box-shadow: var(--xa-ring-primary);
}

/* ── 底部操作区：玻璃态，保留业务内容的连续感 ───────────────── */
.bottom-bar {
  background: var(--xa-glass-bg);
  -webkit-backdrop-filter: var(--xa-glass-blur);
  backdrop-filter: var(--xa-glass-blur);
  border-top: 1rpx solid var(--xa-hairline);
  box-shadow: 0 -16rpx 40rpx -24rpx rgba(30, 58, 138, .35);
}

/* ── 其他基础件 ───────────────────────────────────────────── */
.avatar { box-shadow: inset 0 0 0 1rpx var(--xa-hairline); }
.cover { border-radius: var(--xa-r-md); }
.menu-row + .menu-row { border-top-color: var(--xa-hairline); }
.divider { background: var(--xa-hairline); }
.empty, .loading { padding: 56rpx 24rpx; }
.link { font-weight: 500; }

/* ── 视觉工具类 ───────────────────────────────────────────── */
.xa-glass {
  background: var(--xa-glass-bg);
  -webkit-backdrop-filter: var(--xa-glass-blur);
  backdrop-filter: var(--xa-glass-blur);
  border: 1rpx solid var(--xa-glass-line);
}
.xa-bloom { position: relative; overflow: hidden; }
.xa-bloom::after {
  content: ''; position: absolute; z-index: 0; pointer-events: none;
  top: -80rpx; right: -60rpx; width: 300rpx; height: 300rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(56, 189, 248, .38), rgba(56, 189, 248, 0) 70%);
}
.xa-hairline-top { box-shadow: inset 0 1rpx 0 rgba(30, 58, 138, .10); }

@keyframes xa-rise { from { opacity: 0; transform: translate3d(0, 20rpx, 0); } to { opacity: 1; transform: none; } }
.xa-rise { animation: xa-rise 440ms var(--xa-ease-out) both; }
.xa-rise-2 { animation-delay: 60ms; }
.xa-rise-3 { animation-delay: 120ms; }

@media (prefers-reduced-motion: reduce) {
  .xa-rise { animation: none; }
}
