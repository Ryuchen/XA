:host { display: block; }
.navigation-space { height: var(--xa-navigation-inset); }
/* 玻璃态底栏：与页面内容保持连续，保留 1rpx 冷调分割线。 */
.navigation {
  position: fixed; z-index: 50; left: 0; right: 0; bottom: 0;
  display: flex; box-sizing: border-box; height: var(--xa-navigation-inset);
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 254, 250, .86);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  backdrop-filter: saturate(180%) blur(20px);
  border-top: 1rpx solid rgba(30, 58, 138, .08);
  box-shadow: 0 -12rpx 32rpx -22rpx rgba(30, 58, 138, .3);
}
.navigation-item {
  display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center;
  gap: 3px; box-sizing: border-box; width: 20%; min-width: 0; height: var(--xa-navigation-height);
  margin: 0; padding: 4px 0; border: 0; border-radius: 0; background: transparent;
  color: var(--xa-color-muted); font-family: inherit; font-weight: 400; line-height: 1.3;
  transition: color 150ms cubic-bezier(.2, .8, .2, 1);
}
.navigation-item::after { border: 0; }
.navigation-icon { display: block; width: 24px; height: 24px; flex-shrink: 0; transition: transform 200ms cubic-bezier(.2, .8, .2, 1); }
.navigation-label { font-size: 12px; letter-spacing: .2px; }
.navigation-selected { color: var(--xa-color-primary); }
.navigation-selected .navigation-icon { transform: translateY(-1px) scale(1.04); }
.navigation-selected .navigation-label { font-weight: 600; }
.navigation-hover { background: rgba(37, 99, 235, .06); }

@media (prefers-reduced-motion: reduce) {
  .navigation-item, .navigation-icon { transition: none; }
  .navigation-selected .navigation-icon { transform: none; }
}
