.state { padding:40rpx 24rpx; text-align:center; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); }
.state-copy { display:block; margin:8rpx 0; line-height:1.6; overflow-wrap:anywhere; }
.state-title { color:var(--xa-color-text); font-weight:600; font-size:var(--xa-control-font); letter-spacing:-.2rpx; }
.state .state-action {
  display:flex; align-items:center; justify-content:center;
  min-height:44px; margin:20rpx auto 0; padding:8rpx 28rpx; width:auto; max-width:340rpx;
  border-radius:999rpx; background:rgba(37,99,235,.08); color:var(--xa-color-primary-hover);
  font-size:var(--xa-control-font); font-weight:600; line-height:1.5;
  box-shadow:inset 0 0 0 1rpx rgba(37,99,235,.14);
}
.state .state-action::after { border:0; }
.state-action-hover { opacity:.78; }
.state-image {
  width:64rpx; height:64rpx; margin-bottom:12rpx; padding:18rpx; box-sizing:content-box;
  border-radius:24rpx; background:linear-gradient(150deg,#eef4ff,#dbeafe);
}
.state-symbol {
  width:64rpx; height:64rpx; line-height:64rpx; border-radius:50%; margin:0 auto 12rpx;
  background:rgba(37,99,235,.08); color:var(--xa-color-primary); font-size:32rpx; font-weight:600;
}

/* 骨架屏：冷调微光扫过，加载结束后不留重影。 */
.skeleton-card {
  display:flex; align-items:center; gap:16rpx; padding:18rpx; margin-bottom:14rpx;
  border:1rpx solid var(--xa-hairline); border-radius:var(--xa-r-lg);
  background:var(--xa-color-surface-card); box-shadow:var(--xa-elev-1);
}
.skeleton-icon { width:64rpx; height:64rpx; flex-shrink:0; border-radius:20rpx; }
.skeleton-copy { flex:1; }
.skeleton { width:65%; height:16rpx; margin:16rpx 0; border-radius:8rpx; }
.skeleton.wide { width:100%; height:24rpx; }
.skeleton, .skeleton-icon {
  background-color:#edf1f8;
  background-image:linear-gradient(90deg, #edf1f8 0%, #f7faff 46%, #edf1f8 100%);
  background-size:280% 100%;
  animation:state-shimmer 1.5s ease-in-out infinite;
}
@keyframes state-shimmer { from { background-position:120% 0; } to { background-position:-20% 0; } }
@media (prefers-reduced-motion: reduce) { .skeleton, .skeleton-icon { animation:none; } }
