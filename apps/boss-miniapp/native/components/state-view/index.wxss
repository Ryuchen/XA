.state { padding: 48rpx 28rpx; text-align: center; color: #657188; font-size: 25rpx; }.state-copy { display: block; margin: 12rpx 0; line-height: 1.75; overflow-wrap: anywhere; }.state-title { color: #192847; font-weight: 600; font-size: 29rpx; }.state .state-action { background: #f7f4ec; color: #002fa7; border-radius: 22rpx; margin: 24rpx auto 0; min-height: 88rpx; padding: 18rpx 32rpx; width: auto; max-width: 320rpx; font-size: 27rpx; line-height: 1.6; }.state .state-action::after { border: 0; }.state-image { width: 76rpx; height: 76rpx; padding: 18rpx; border-radius: 24rpx; background: #f7f4ec; margin-bottom: 8rpx; box-sizing: content-box; }.state-symbol { width: 72rpx; height: 72rpx; line-height: 72rpx; border-radius: 50%; background: #f7f4ec; color: #002fa7; font-size: 36rpx; font-weight: 600; margin: 0 auto 16rpx; }.skeleton-card { display: flex; align-items: center; gap: 24rpx; padding: 24rpx; background: #fffdf5; border: 1rpx solid #f7f4ec; border-radius: 24rpx; margin-bottom: 24rpx; }.skeleton-icon { width: 100rpx; height: 100rpx; flex-shrink: 0; border-radius: 20rpx; background: #f7f4ec; }.skeleton-copy { flex: 1; }.skeleton { width: 65%; height: 20rpx; border-radius: 8rpx; background: #f7f4ec; margin: 16rpx 0; }.skeleton.wide { width: 100%; height: 26rpx; }

.state-action-hover { opacity: .78; }
