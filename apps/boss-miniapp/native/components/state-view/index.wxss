.state { padding:32rpx 24rpx; text-align:center; color:var(--xa-color-muted); font-size:var(--xa-control-small-font); }
.state-copy { display:block; margin:8rpx 0; line-height:1.6; overflow-wrap:anywhere; }
.state-title { color:var(--xa-color-text); font-weight:600; font-size:var(--xa-control-font); }
.state .state-action { display:flex; align-items:center; justify-content:center; background:var(--xa-color-surface-subtle); color:var(--xa-color-primary); border-radius:var(--xa-radius-control); margin:16rpx auto 0; min-height:44px; padding:8rpx 24rpx; width:auto; max-width:320rpx; font-size:var(--xa-control-font); line-height:1.5; }
.state .state-action::after { border:0; }
.state-action-hover { opacity:.78; }
.state-image { width:64rpx; height:64rpx; padding:16rpx; border-radius:16rpx; background:var(--xa-color-surface-subtle); margin-bottom:8rpx; box-sizing:content-box; }
.state-symbol { width:64rpx; height:64rpx; line-height:64rpx; border-radius:50%; background:var(--xa-color-surface-subtle); color:var(--xa-color-primary); font-size:32rpx; font-weight:600; margin:0 auto 8rpx; }
.skeleton-card { display:flex; align-items:center; gap:16rpx; padding:16rpx; background:var(--xa-color-surface); border:1rpx solid var(--xa-color-surface-subtle); border-radius:16rpx; margin-bottom:16rpx; }
.skeleton-icon { width:64rpx; height:64rpx; flex-shrink:0; border-radius:16rpx; background:var(--xa-color-surface-subtle); }
.skeleton-copy { flex:1; }
.skeleton { width:65%; height:16rpx; border-radius:8rpx; background:var(--xa-color-surface-subtle); margin:16rpx 0; }
.skeleton.wide { width:100%; height:24rpx; }
