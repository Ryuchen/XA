  "scripts": {
    "boss:build": "npm --prefix fronted run build --workspace @xa/fronted-boss",
    "provider:build": "npm --prefix fronted run build --workspace @xa/fronted-provider",
    "provider:build:h5": "npm --prefix fronted run build --workspace @xa/fronted-provider",
