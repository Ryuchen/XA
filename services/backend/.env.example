# Django runtime
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=

# MySQL / Redis (matches the root docker-compose defaults)
MYSQL_DATABASE=xa_db
MYSQL_USER=root
MYSQL_PASSWORD=xa_dev_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# WeChat: leaving either credential blank enables local mock login.
WECHAT_APPID=
WECHAT_SECRET=
# Local H5 development may use true. Production/WeApp must use false.
WECHAT_MOCK_LOGIN=true

# 履约凭证：生产建议保持 true；仅旧版陪玩端过渡期可临时关闭。
REQUIRE_ORDER_EVIDENCE_IMAGES=true

# Public H5 bases used when creating audition URLs.  The two apps are separate
# builds, so do not point both values at the customer-only H5.
AUDITION_BOSS_LINK_BASE_URL=https://boss-h5.example/audition
AUDITION_PROVIDER_LINK_BASE_URL=https://provider-h5.example/audition

# KOOK 订单派单机器人。机器人需加入服务器并拥有目标文字频道发消息权限。
KOOK_ENABLED=false
KOOK_BOT_TOKEN=
KOOK_DISPATCH_CHANNEL_ID=
# 新建待接单、陪玩拒单后二次派单可独立开关。
KOOK_DISPATCH_NEW_ORDERS=true
KOOK_DISPATCH_REJECTED_ORDERS=true
# 可选：消息中 @ 的 KOOK 角色 ID，多个用英文逗号分隔。
KOOK_DISPATCH_MENTION_ROLE_IDS=
# 可选：运营后台订单页地址，配置后 KOOK 卡片带“前往派单”按钮。
KOOK_ADMIN_ORDER_URL=https://admin.example.com/orders
KOOK_REQUEST_TIMEOUT=8
